model User {
  id                 Int          @id @default(autoincrement())
  uuid               String       @unique @default(uuid())
  nom                String
  prenom             String
  email              String       @unique
  photo              String?
  role               Role?
  telephone          String?
  adresse            String?
  passwordHash       String?
  etat               MemberStatus @default(ACTIF)
  tokenVersion       Int          @default(0)
  mustChangePassword Boolean      @default(false)
  dateAdhesion       DateTime     @default(now())

  // Jeton opaque pour l'accès SANS login à la tournée/objectifs du jour de l'agent
  // (QR « capability URL » — le jeton EST la clé). Régénérable pour invalider un QR.
  scanTokenTournee String? @unique

  // Profil gestionnaire (rôle opérationnel)
  gestionnaire Gestionnaire?

  // Finances
  wallet   Wallet?
  factures Facture[]

  // Système
  auditLogs             AuditLog[]
  notifications         Notification[]
  preferenceNotifRH     PreferenceNotificationRH?
  piecesJustificatives  PieceJustificative[]
  userPermissions       UserPermission[]
  userJournauxAutorises UserJournalAutorise[]
  securityLogs          SecurityLog[]
  messagesEnvoyes       Message[]                 @relation("MessagesEnvoyes")
  messagesRecus         Message[]                 @relation("MessagesRecus")
  conversationsA        Conversation[]            @relation("ConversationsA")
  conversationsB        Conversation[]            @relation("ConversationsB")
  messagesChatEnvoyes   MessageChat[]             @relation("MessagesChatEnvoyes")

  // Marketing (Phase 1)
  campagnesResponsable       Campagne[]            @relation("CampagneResponsable")
  campagnesCommercial        Campagne[]            @relation("CampagneCommercial")
  campagnesCreees            Campagne[]            @relation("CampagneCreePar")
  audiencesMarketingCreees   AudienceMarketing[]   @relation("AudienceMarketingCreePar")
  // Marketing (Phase 2 — Communication)
  modelesMessageCrees        ModeleMessage[]       @relation("ModeleMessageCreePar")
  envoisMessageEffectues     EnvoiMessage[]        @relation("EnvoiMessageEffectuePar")
  // Marketing (Phase 3 — Content & Social Media)
  assetsMarketingUploades    AssetMarketing[]      @relation("AssetMarketingUploadePar")
  publicationsResponsable    PublicationSociale[]  @relation("PublicationResponsable")
  publicationsValidees       PublicationSociale[]  @relation("PublicationValidePar")
  publicationsValideesDirection PublicationSociale[] @relation("PublicationValideParDirection")
  publicationsCreees         PublicationSociale[]  @relation("PublicationCreePar")
  // Marketing (Phase 4 — Automatisation)
  reglesAutomatisationCreees RegleAutomatisation[] @relation("RegleAutomatisationCreePar")
  tachesMarketingAssignees   TacheMarketing[]      @relation("TacheMarketingAssigneA")
  tachesMarketingCreees      TacheMarketing[]      @relation("TacheMarketingCreePar")
  messagesInternes           MessageInterne[]

  // Packs & fidélité
  souscriptionsPacks SouscriptionPack[]
  pointsFidelite     PointsFidelite?

  clientsAssignes    Client[]                 @relation("ClientAgentTerrain")
  clientAffectations ClientAgentAffectation[] @relation("ClientAgentAffectations")

  // Collectes journalières
  collectesAgent    CollecteJournaliere[] @relation("CollectesAgent")
  collectesValidees CollecteJournaliere[] @relation("CollectesValideur")

  // Comptabilité
  cloturesComptables          ClotureComptable[]
  ecrituresComptables         EcritureComptable[]
  ecrituresValidees           EcritureComptable[]        @relation("EcritureValidateur")
  ecrituresControlees         EcritureComptable[]        @relation("EcritureControleur")
  propositionsOCRAnalysees    PropositionImputationOCR[] @relation("PropositionOCRAnalysePar")
  propositionsOCRValidees     PropositionImputationOCR[] @relation("PropositionOCRValidePar")
  rapprochements              RapprochementBancaire[]
  declarationsTVA             DeclarationTVA[]
  journalValidations          JournalValidation[]
  immobilisationsResponsable  Immobilisation[]           @relation("ImmobilisationResponsable")
  immobilisationsCreees       Immobilisation[]           @relation("ImmobilisationCreateur")
  budgets                     Budget[]
  ecrituresRecurrentes        EcritureRecurrente[]
  exercicesClotures           ExerciceComptable[]
  lignesReleveBancaire        LigneReleveBancaire[]
  provisionsCreees            ProvisionDepreciation[]    @relation("ProvisionCreateur")
  mouvementsProvision         MouvementProvision[]
  regularisationsCreees       RegularisationAvance[]     @relation("RegulCreateur")
  comptesComptablesCrees      CompteComptable[]          @relation("CompteComptableCreateur")
  avoirsClientsCrees          AvoirClient[]              @relation("AvoirClientCreateur")
  litigesClientsCrees         LitigeClient[]             @relation("LitigeClientCreateur")
  avoirsFournisseursCrees     AvoirFournisseur[]         @relation("AvoirFournisseurCreateur")
  avancesFournisseursCrees    AvanceFournisseur[]        @relation("AvanceFournisseurCreateur")
  facturesAchatCrees          FactureAchat[]             @relation("FactureAchatCreateur")
  facturesAchatRapprochees    FactureAchat[]             @relation("FactureAchatRapprochePar")
  chargesProduitsAttenteCrees ChargeProduitAttente[]     @relation("ChargeProduitAttenteCreateur")
  engagementsHorsBilanCrees   EngagementHorsBilan[]      @relation("EngagementHorsBilanCreateur")

  // Points de vente — cet user est RPV d'un PDV (1-1)
