  updatedAt DateTime @updatedAt
}

// ============================================================
// POINTS DE VENTE & DÉPÔTS CENTRAUX
// Un PointDeVente peut être un PDV classique ou un dépôt central
// ============================================================

model PointDeVente {
  id        Int              @id @default(autoincrement())
  type      TypePointDeVente @default(POINT_DE_VENTE)
  code      String           @unique
  nom       String
  adresse   String?
  telephone String?
  actif     Boolean          @default(true)
  notes     String?

  // Hiérarchie entrepôts (CDC Approvisionnement §3/§4) — un PDV ou une plateforme
  // régionale peut être rattaché à une plateforme régionale (elle-même sous le
  // dépôt central, géré de façon implicite : un seul DEPOT_CENTRAL en pratique).
  plateformeRegionaleId Int?
  plateformeRegionale   PointDeVente?  @relation("HierarchiePlateforme", fields: [plateformeRegionaleId], references: [id])
  sitesRattaches        PointDeVente[] @relation("HierarchiePlateforme")

  // Géolocalisation + dimensionnement du site (CDC §3/§4)
  latitude            Float?
  longitude           Float?
  capaciteStockage    Decimal? // capacité totale du site (unité : capaciteUnite)
  capaciteUnite       String?            @default("m3") // ex m3, palettes
  seuilSecuriteGlobal Decimal? // seuil de sécurité au niveau site (en complément des seuils par produit sur StockSite)
  niveauSecurite      NiveauSecuriteSite @default(STANDARD) // niveau de sécurité physique du site (CDC §4)

  // RPV responsable (type POINT_DE_VENTE uniquement, 1-1)
  rpvId Int?  @unique
  rpv   User? @relation("RPVPointDeVente", fields: [rpvId], references: [id])

  // Chef d'agence superviseur (peut superviser plusieurs PDV)
  chefAgenceId Int?
  chefAgence   User? @relation("ChefAgencePDV", fields: [chefAgenceId], references: [id])

  // Responsable du site — utile surtout pour DEPOT_CENTRAL/PLATEFORME_REGIONALE
  // qui n'ont ni rpvId ni chefAgenceId (CDC §4 : chaque emplacement a un responsable).
  responsableId Int?
  responsable   User? @relation("ResponsablePointDeVente", fields: [responsableId], references: [id])

  // Bulk pour clients
  clientsPDV ClientPointDeVente[]
  coupons    Coupon[]

  // Marketing (Phase 6 — Terrain & Événementiel)
  operationsTerrain      OperationTerrain[]
  soumissionsFormulaires SoumissionFormulaire[]

  // Marketing (fermeture des manques CDC — §50)
  zonesChalandise ZoneChalandise[]

  // Relations opérationnelles
  affectations               GestionnaireAffectation[]
  clients                    Client[]
  stocks                     StockSite[]
  sessionsCaisse             SessionCaisse[]
  caissesPDV                 CaissePDV[]
  clotures                   ClotureCaisse[]
  inventaires                InventaireSite[]
  mouvementsStock            MouvementStock[]
  ventesDirectes             VenteDirecte[]
  anomaliesStock             AnomalieStock[]
  bonsSortie                 BonSortie[]
  transfertsOrigine          TransfertStock[]             @relation("TransfertOrigine")
  transfertsDestination      TransfertStock[]             @relation("TransfertDestination")
  receptionsAppro            ReceptionApprovisionnement[]
  receptionsCommeOrigine     ReceptionApprovisionnement[] @relation("ReceptionsEnTantQuOrigine")
  commandesInternes          CommandeInterne[]
  visitesControle            VisiteControle[]
  livraisonsPacks            ReceptionProduitPack[]
  collectes                  CollecteJournaliere[]
  demandesAjustement         DemandeAjustementStock[]
  lignesSouscriptionProduits LigneSouscriptionProduit[]
  lignesCreditPDV            LigneCreditClient[]          @relation("LignesCreditPDV")
  facturesVente              FactureVente[]               @relation("FacturesVentePDV")
  prixProduits               PrixProduit[]                @relation("PrixProduitPDV")
  promotions                 Promotion[]                  @relation("PromotionPDV")
  lots                       LotProduit[]
  documentsStrategiques      DocumentStrategiqueRH[]
  demandesCotation           DemandeCotation[]
  bonsCommande               BonCommande[]
  lignesEcritureComptable    LigneEcriture[]
  lignesBudget               LigneBudget[]
  taxesConditionnelles       TaxeConfig[]
  campagnesMarketing         CampagneAgence[]
  publicationsSociales       PublicationSociale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([plateformeRegionaleId])
}

// Affectation d'un gestionnaire (caissier, magasinier, agent, etc.) à un PDV ou dépôt
model GestionnaireAffectation {
  id             Int       @id @default(autoincrement())
  userId         Int
  pointDeVenteId Int
  actif          Boolean   @default(true)
  dateDebut      DateTime  @default(now())
  dateFin        DateTime?
  notes          String?

  user         User         @relation(fields: [userId], references: [id])
  pointDeVente PointDeVente @relation(fields: [pointDeVenteId], references: [id])

  // Pas de @@unique : un user peut être ré-affecté au même PDV après une période d'absence
  // L'unicité d'affectation active se gère au niveau applicatif (actif = true)
  @@index([userId])
  @@index([pointDeVenteId])
  @@index([userId, pointDeVenteId, actif])
}

// ============================================================
// CLIENTS
// ============================================================

model Client {
  id Int @id @default(autoincrement())

  // ── Champs legacy (ne pas supprimer) ──────────────────────
  nom       String
  prenom    String
  telephone String       @unique
  adresse   String?
  etat      MemberStatus @default(ACTIF)

  // ── Nouveaux champs identité ───────────────────────────────
  codeClient          String?   @unique // auto-généré (ex: CLI-00042)
  sexe                Sexe?
  dateNaissance       DateTime?
  telephoneSecondaire String?
  email               String? // CDC Marketing §26 — requis pour le canal Email
  quartier            String?
  ville               String?
  commune             String? // commune de rattachement (texte libre)
  region              String? // CDC Marketing §51 — ciblage géo par région (texte libre)
  photoUrl            String? // URL stockage photo client
  pieceIdentiteUrl    String? // URL scan pièce d'identité
  numeroCNI           String?   @unique // numéro CNI (unique si renseigné)
  numeroCarteAfrisime String? // N° carte client physique AfriSime

  // ── Activité & commerce ────────────────────────────────────
  activite    String? // métier / secteur d'activité
  nomCommerce String? // nom de l'entreprise / boutique
  latitude    Float? // coordonnée GPS latitude
  longitude   Float? // coordonnée GPS longitude

  // ── Segment ────────────────────────────────────────────────
  segment SegmentClient @default(ORDINAIRE)

  // ── Type & crédit ──────────────────────────────────────────
  typeClient         TypeClient? // COMPTANT ou CREDIT
  limiteCredit       Decimal? // plafond de crédit accordé
  soldeActuel        Decimal?    @default(0) // solde en cours (mis à jour automatiquement)
  delaiPaiementJours Int         @default(0) // "conditions de paiement" (CDC Comptabilité §16) — 0 = comptant

  // ── Scoring (calculé automatiquement) ─────────────────────
  niveauRisque     NiveauRisque? // FAIBLE / MOYEN / ELEVE / CRITIQUE
  scoreSolvabilite Float? // score 0–100

  // ── PDV de rattachement (optionnel) ───────────────────────
  pointDeVenteId Int?

  pointDeVente PointDeVente? @relation(fields: [pointDeVenteId], references: [id])

  agentTerrainId Int?
  agentTerrain   User? @relation("ClientAgentTerrain", fields: [agentTerrainId], references: [id])

  agentAffectations  ClientAgentAffectation[]
  pointsDeVente      ClientPointDeVente[]
  tags               ClientTag[]
  souscriptionsPacks SouscriptionPack[]
  pointsFidelite     PointsFidelite?
  ventesDirectes     VenteDirecte[]
  lignesCollecte     LigneCollecte[]
  creditsClients     CreditClient[]
  visites            VisiteClient[]
  documents          ClientDocument[]
  transactions       ClientTransaction[]
  scoreHistorique    ClientScoreHistorique[]
  facturesVente      FactureVente[]           @relation("FacturesVenteClient")
  comptesCourants    CompteCourant[] // titulaire principal (individuel ou collectif) — CDC §19.A
  membreDeComptesCC  MembreCompteCourant[]    @relation("MembreCC") // comptes collectifs dont ce client est membre
  compteFidelite     CompteFidelite? // programme de fidélité (CDC §19.D)

  // ── Validation RVC (tous nullable — données existantes non impactées) ───
  motifRejet      String? // raison du rejet par le responsable crédit
  validationParId Int? // User.id du RVC qui a statué
  validationPar   User?     @relation("ClientValidateur", fields: [validationParId], references: [id])
  dateValidation  DateTime? // date de la décision (activation ou rejet)

  // RIA
  affectationsRIA AffectationClientRIA[]
  financementsRIA OperationFinancementRIA[] @relation("FinancementsRIAClient")
  eligibiliteRIA  EligibiliteClientRIA?

  // Promotions ciblant nommément ce client (Catalogue §9) — Phase 5
  promotions Promotion[] @relation("PromotionClient")

  // Compte auxiliaire comptable réel (CDC Comptabilité §16) — sous-compte 411xxx
  // rattaché par FK, auto-provisionné par lib/comptabilite/auxiliaire.ts.
  compteAuxiliaire       CompteComptable?
  provisionsDepreciation ProvisionDepreciation[]
  avoirs                 AvoirClient[]
  litiges                LitigeClient[]

  // Marketing (Phase 1)
  audienceMemberships AudienceMarketingMembre[]

  // Marketing (Phase 2 — Communication, CDC §74 consentement par canal)
  accepteSms      Boolean        @default(true)
  accepteEmail    Boolean        @default(true)
  accepteWhatsapp Boolean        @default(true)
  accepteOffres   Boolean        @default(true)
  // CDC §75 — Centre de préférences : consentement par catégorie de contenu
  // (distinct du canal §74). Défauts alignés sur la maquette du CDC (☑☑☑☐☐).
  prefPromotions  Boolean        @default(true)
  prefNouveautes  Boolean        @default(true)
  prefFidelite    Boolean        @default(true)
  prefEvenements  Boolean        @default(false)
  prefB2B         Boolean        @default(false)
  envoisMessage   EnvoiMessage[]

  // Marketing (Phase 4 — Automatisation)
  executionsAutomatisation ExecutionAutomatisation[]
  tachesMarketing          TacheMarketing[]

  // Marketing (Phase 5 — Fidélisation : coupons, gamification, parrainage)
  couponUtilisations          CouponUtilisation[]
  participationsChallenge     ParticipationChallenge[]
  badgesObtenus               BadgeClient[]
  codeParrainage              String?                  @unique // généré à la création, permet à ce client de parrainer
  parrainagesEnTantQueParrain Parrainage[]             @relation("ParrainageParrain")
  parrainageEnTantQueFilleul  Parrainage?              @relation("ParrainageFilleul")

  // Marketing (Phase 6 — Terrain & Événementiel)
  participationsEvenement ParticipantEvenement[]
  soumissionsFormulaires  SoumissionFormulaire[]

  // Marketing (Phase 7 — Analytics & IA)
  assignationsTestAB TestABAssignation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([typeClient])
  @@index([segment])
  @@index([niveauRisque])
  @@index([ville])
  @@index([commune])
}

// ============================================================
// AVOIRS & LITIGES CLIENTS (CDC Comptabilité §16)
// ============================================================

enum StatutAvoirClient {
  EMIS
  UTILISE
  ANNULE
}

/// Avoir client (note de crédit) — réduit la créance 411xxx du client. Génère
/// une écriture Dr 701 Ventes / Cr 411 Client (inverse d'une vente), via le
/// moteur central (evenement AVOIR_CLIENT_EMIS, lib/comptabilite/moteur.ts).
model AvoirClient {
  id           Int               @id @default(autoincrement())
  reference    String            @unique
  clientId     Int
  client       Client            @relation(fields: [clientId], references: [id])
  montant      Decimal
  motif        String
  statut       StatutAvoirClient @default(EMIS)
  dateEmission DateTime          @default(now())
  ecritureId   Int?
  notes        String?
  creeParId    Int
  creePar      User              @relation("AvoirClientCreateur", fields: [creeParId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([statut])
}

enum StatutLitigeClient {
  OUVERT
  EN_COURS
  RESOLU
  CLOTURE
}

/// Litige client (CDC Comptabilité §16) — suivi pur, ne génère aucune écriture
/// (contrairement à l'avoir) : sert à documenter/tracer un désaccord tant qu'il
/// n'est pas résolu par une autre action comptable (avoir, régularisation…).
model LitigeClient {
  id              Int                @id @default(autoincrement())
  reference       String             @unique
  clientId        Int
  client          Client             @relation(fields: [clientId], references: [id])
  motif           String
  montantConteste Decimal?
  statut          StatutLitigeClient @default(OUVERT)
  dateOuverture   DateTime           @default(now())
  dateResolution  DateTime?
  notes           String?
  creeParId       Int
  creePar         User               @relation("LitigeClientCreateur", fields: [creeParId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([statut])
}

// ============================================================
// VISITES CLIENTS (tournées agents terrain)
// ============================================================

model VisiteClient {
  id         Int          @id @default(autoincrement())
  agentId    Int
  clientId   Int
  statut     StatutVisite @default(REALISEE)
  latitude   Float?
  longitude  Float?
  dateVisite DateTime     @default(now())
  notes      String?

  agent  User   @relation("VisitesAgent", fields: [agentId], references: [id])
  client Client @relation(fields: [clientId], references: [id])

  createdAt DateTime @default(now())

  @@index([agentId])
  @@index([clientId])
  @@index([dateVisite])
}

// Historique des affectations client ↔ agent terrain
// Permet un calcul de CA juste par période d'affectation (évite le double-comptage lors des réaffectations)
model ClientAgentAffectation {
  id        Int       @id @default(autoincrement())
  clientId  Int
  agentId   Int // User.id du gestionnaire AGENT_TERRAIN
  dateDebut DateTime  @default(now())
  dateFin   DateTime?
  actif     Boolean   @default(true)
  notes     String?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  agent  User   @relation("ClientAgentAffectations", fields: [agentId], references: [id])

  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([agentId])
  @@index([clientId, agentId, actif])
}

model ClientPointDeVente {
  id Int @id @default(autoincrement())

  clientId       Int
  pointDeVenteId Int

  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  pointDeVente PointDeVente @relation(fields: [pointDeVenteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([clientId, pointDeVenteId])
  @@index([clientId])
  @@index([pointDeVenteId])
}

// ============================================================
// TAGS CLIENTS
// ============================================================

model Tag {
  id          Int            @id @default(autoincrement())
  nom         String         @unique
  couleur     String         @default("#6366f1") // hex couleur pour l'UI
  description String?
  segment     SegmentClient? // null = applicable à tous les segments
  actif       Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients ClientTag[]

  @@index([segment])
  @@index([actif])
}

// Table de jonction Client ↔ Tag (many-to-many)
model ClientTag {
  clientId  Int
  tagId     Int
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([clientId, tagId])
  @@index([clientId])
  @@index([tagId])
}

// ============================================================
// DOCUMENTS CLIENTS
// ============================================================

model ClientDocument {
  id       Int    @id @default(autoincrement())
  clientId Int
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  type           TypeDocumentClient @default(AUTRE)
  nom            String // nom du fichier
  url            String // URL de stockage
  uploadthingKey String? // clé uploadthing si applicable
  taille         Int? // taille en octets
  description    String?
  expireAt       DateTime? // date d'expiration (ex : CNI)

  uploadePar  Int
  uploadeUser User @relation("DocumentsUploades", fields: [uploadePar], references: [id])

  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([clientId, type])
}

// ============================================================
// TRANSACTIONS CLIENTS (historique financier unifié)
// ============================================================

model ClientTransaction {
  id       Int    @id @default(autoincrement())
  clientId Int
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  type        TypeTransactionClient
  montant     Decimal
  sens        String // DEBIT | CREDIT (du point de vue du client)
  reference   String? // référence de l'opération source
  description String?

  // Lien polymorphique vers la source (pas de FK Prisma — souplesse maximale)
  sourceType String? // VERSEMENT_PACK | REMBOURSEMENT_CREDIT | VENTE_DIRECTE | COLLECTE
  sourceId   Int?

  agentId Int?
  agent   User? @relation("TransactionsAgent", fields: [agentId], references: [id])

  dateOperation DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([clientId])
  @@index([clientId, type])
  @@index([clientId, dateOperation])
  @@index([sourceType, sourceId])
}

// ============================================================
// HISTORIQUE DES SCORES / RISQUE CLIENTS
// ============================================================

model ClientScoreHistorique {
  id       Int    @id @default(autoincrement())
  clientId Int
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  niveauRisque     NiveauRisque
  scoreSolvabilite Float
  raison           String? // REMBOURSEMENT | RETARD | RECALCUL_AUTO | MANUEL | CREATION

  calculePar  Int?
  calculeUser User? @relation("ScoresCalcules", fields: [calculePar], references: [id])

  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([clientId, createdAt])
}

// ============================================================
// CRÉDITS CLIENTS
// ============================================================

model CreditClient {
  id        Int    @id @default(autoincrement())
  reference String @unique // ex: CRD-20260521-001

  clientId Int
  client   Client @relation(fields: [clientId], references: [id])

  pointDeVenteId Int?
  // pas de relation directe ici — PointDeVente n'a pas de backlink crédit (optionnel)

  statut StatutCredit @default(EN_ATTENTE_VALIDATION)

  // Formule commerciale (module POPC). Obligatoire pour les nouveaux crédits ;
  // détermine la durée (QUINZAINE → 16 échéances, TRENTAINE → 31), la dernière
  // échéance étant la collecte de rémunération (« 16ème » / « 31ème »).
  formule FormuleCredit?

  // Montants
  montantTotal        Decimal
  montantRembourse    Decimal @default(0)
  soldeRestant        Decimal
  apportCompteCourant Decimal @default(0) // part de l'achat réglée via le compte courant à la création (CDC §8)

  // Échéancier
  dureeJours        Int // nombre de jours de remboursement
  dateDebut         DateTime // date à partir de laquelle les remboursements commencent
  dateEcheanceFin   DateTime // = dateDebut + dureeJours (calculé à la validation)
  montantJournalier Decimal // = montantTotal / dureeJours (calculé à la validation)

  // Frais & intérêts (décomposition du montant total)
  fraisDossier           Decimal @default(0)
  reductionFideliteFrais Decimal @default(0) // réduction des frais de dossier accordée via la fidélité (CDC §19.D)
  assurance              Decimal @default(0)
  autresFrais            Decimal @default(0)
  fraisLivraison         Decimal @default(0)
  tauxInteret            Decimal @default(0) // % appliqué sur la valeur des produits
  montantInteret         Decimal @default(0) // = valeurProduits × tauxInteret / 100

  // Pénalités
  tauxPenalite    Decimal @default(0) // % par jour de retard
  delaiGraceJours Int     @default(0) // jours de grâce avant application des pénalités

  // Métadonnées
  garantie             String?
  // Garant structuré (bordereau — section Garantie)
  garantNom            String?
  garantTelephone      String?
  garantAdresse        String?
  garantTypeGarantie   String? // caution, gage, hypothèque, aval…
  garantValeurEstimee  Decimal @default(0)
  observations         String?
  // Gestionnaire du crédit (bordereau) : User choisi manuellement ; fallback = RVC du PDV → validePar → creePar
  gestionnaireCreditId Int?
  gestionnaireCredit   User?   @relation("CreditGestionnaire", fields: [gestionnaireCreditId], references: [id])

  // Traçabilité
  creeParId      Int
  creePar        User      @relation("CreditCreateur", fields: [creeParId], references: [id])
  valideParId    Int?
  validePar      User?     @relation("CreditValidateur", fields: [valideParId], references: [id])
  dateValidation DateTime?

  // Consommation crédit via livraisons
  montantConsomme Decimal @default(0) // somme des VenteDirecte au statut CREDIT_LIVRE liées

  lignes                  LigneCreditClient[]
  echeances               EcheanceCredit[]
  remboursements          RemboursementCredit[]
  livraisons              VenteDirecte[]
  facturesVente           FactureVente[]            @relation("CreditClientFactures")
  financementsRIA         OperationFinancementRIA[] @relation("FinancementsRIACredit")
  autorisationPrelevement AutorisationPrelevement? // prélèvement automatique CC (CDC §19.C)

  // Attribution marketing (Phase 1, CDC §56-57) — tag optionnel à la saisie
  // pour rattacher ce crédit au CA d'une campagne.
  campagneId Int?
  campagne   Campagne? @relation("CreditCampagne", fields: [campagneId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([statut])
  @@index([pointDeVenteId])
  @@index([dateDebut])
  @@index([campagneId])
}

model LigneCreditClient {
  id        Int  @id @default(autoincrement())
  creditId  Int
  produitId Int? // nullable : produit hors catalogue non encore créé

  // Snapshot au moment de la vente (conservé même si produit modifié)
  produitNom      String
  produitNomSaisi String? // saisie libre originale — pour traçabilité si produit substitué
  quantite        Float // décimal autorisé (ex: 0.5 = demi-quantité pour clients fragiles)
  prixUnitaire    Decimal
  remise          Decimal @default(0)
  montantLigne    Decimal

  // Traçabilité livraison (comme LigneSouscriptionProduit)
  statut            StatutLigneCreditClient @default(EN_ATTENTE)
  estNouveauProduit Boolean                 @default(false)
  notes             String?

  // PDV cible — dénormalisé depuis credit.pointDeVenteId pour agrégations logistique
  pointDeVenteId Int?
  pointDeVente   PointDeVente? @relation("LignesCreditPDV", fields: [pointDeVenteId], references: [id])

  // Substitution
  produitSubstitutId Int?
  produitSubstitut   Produit? @relation("LigneCreditSubstitut", fields: [produitSubstitutId], references: [id])

  // Traitement
  traiteParId    Int?
  traitePar      User?     @relation("LignesCreditTraitees", fields: [traiteParId], references: [id])
  dateTraitement DateTime?

  credit  CreditClient @relation(fields: [creditId], references: [id], onDelete: Cascade)
  produit Produit?     @relation("LigneCreditProduit", fields: [produitId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creditId])
  @@index([produitId])
  @@index([pointDeVenteId, statut])
  @@index([statut])
}

model EcheanceCredit {
  id             Int                  @id @default(autoincrement())
  creditId       Int
  numeroEcheance Int // 1, 2, 3 … dureeJours
  dateEcheance   DateTime
  montantDu      Decimal
  montantPaye    Decimal              @default(0)
  statut         StatutEcheanceCredit @default(EN_ATTENTE)
  penalite       Decimal              @default(0) // pénalité accumulée si retard

  credit CreditClient @relation(fields: [creditId], references: [id], onDelete: Cascade)

  @@index([creditId])
  @@index([statut])
  @@index([dateEcheance])
  @@index([creditId, statut])
}

model RemboursementCredit {
  id                Int          @id @default(autoincrement())
  creditId          Int
  montant           Decimal // montant encaissé (saisi par l'utilisateur)
  dateRemboursement DateTime     @default(now()) // date de collecte (date réelle)
  modePaiement      TypePaiement @default(ESPECES)
  notes             String? // observation / commentaire
  // EN_ATTENTE_CAISSIER = enregistré par agent/admin, en attente confirmation caissier
  // CONFIRME           = caissier a encaissé physiquement (effet financier appliqué)
  // REJETE             = caissier a rejeté (erreur de saisie, fraude, etc.)
  statut            String       @default("EN_ATTENTE_CAISSIER")

  // Encaissement journalier (nullable — données existantes non impactées)
  numeroJour        Int? // N° de jour de la collecte (1..dureeJours)
  montantAttendu    Decimal? // montant attendu = échéance du jour (calcul auto)
  agentCollecteurId Int? // agent ayant physiquement collecté
  agentCollecteur   User?    @relation("RemboursementAgentCollecteur", fields: [agentCollecteurId], references: [id])

  enregistreParId Int
  enregistrePar   User @relation("RemboursementEnregistrePar", fields: [enregistreParId], references: [id])

  credit CreditClient @relation(fields: [creditId], references: [id], onDelete: Cascade)

  // Renseigné si ce remboursement provient d'un paiement par compte courant
  // demandé par un agent terrain : le compte n'est débité qu'à la confirmation
  // caissier (le montant est réservé entre-temps, cf. montantBloqueActif).
  compteCourantId Int?
  compteCourant   CompteCourant? @relation(fields: [compteCourantId], references: [id])

  // Ligne de session de collecte à mettre à jour (statut/montant réel) lors de
  // la confirmation ou du rejet, si ce remboursement provient d'une session.
  ligneCollecte LigneCollecte?

  dateConfirmation DateTime? // date où le caissier a confirmé (statut → CONFIRME)

  createdAt DateTime @default(now())

  @@index([creditId])
  @@index([statut])
  @@index([dateRemboursement])
  @@index([dateConfirmation])
  @@index([agentCollecteurId])
  @@index([compteCourantId])
}

// ============================================================
// COLLECTES JOURNALIÈRES (terrain)
// ============================================================

// Session de collecte d'un agent pour une journée donnée
model CollecteJournaliere {
  id              Int            @id @default(autoincrement())
  reference       String         @unique // ex: COL-20260521-001
  agentId         Int // User AGENT_TERRAIN
  pointDeVenteId  Int? // PDV de rattachement de l'agent
  dateCollecte    DateTime // jour de la tournée
  statut          StatutCollecte @default(EN_COURS)
  montantPrevu    Decimal        @default(0) // somme des montantAttendu des lignes
  montantCollecte Decimal        @default(0) // somme réellement encaissée
  notes           String?

  // Validation admin
  valideParId    Int?
  dateValidation DateTime?

  agent        User            @relation("CollectesAgent", fields: [agentId], references: [id])
  validePar    User?           @relation("CollectesValideur", fields: [valideParId], references: [id])
  pointDeVente PointDeVente?   @relation(fields: [pointDeVenteId], references: [id])
  lignes       LigneCollecte[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId])
  @@index([statut])
  @@index([dateCollecte])
  @@index([pointDeVenteId])
}

// Une ligne d'activité dans une session de collecte (journal de la journée de
// l'agent) : PACK à l'origine, généralisé aux crédits/ventes/CC/carnets/visites/
// nouveaux clients. `type` distingue la nature de la ligne ; selon le type, une
// seule des références optionnelles (souscriptionId/creditId/...) est renseignée.
model LigneCollecte {
  id              Int                  @id @default(autoincrement())
  collecteId      Int
  clientId        Int
  type            TypeActiviteCollecte @default(PACK)
  souscriptionId  Int? // type PACK : SouscriptionPack concernée
  creditId        Int? // type CREDIT/CC : CreditClient concerné (référence libre, sans relation Prisma)
  venteDirecteId  Int? // type VENTE : VenteDirecte concernée (référence libre, sans relation Prisma)
  venteCarnetId   Int? // type CARNET : VenteCarnet concernée (référence libre, sans relation Prisma)
  visiteId        Int? // type VISITE : VisiteClient concernée (référence libre, sans relation Prisma)
  clientNouveauId Int? // type NOUVEAU_CLIENT : Client recruté (référence libre, sans relation Prisma)
  montantAttendu  Decimal // montant de l'échéance prévue (0 pour VISITE/NOUVEAU_CLIENT)
  montantCollecte Decimal              @default(0)
  statut          StatutLigneCollecte  @default(EN_ATTENTE)
  notes           String?

  // Anti-fraude : coordonnées GPS + mode de paiement enregistrés au moment de la collecte
  latitude     Float?
  longitude    Float?
  modePaiement String? // ESPECES | MOBILE_MONEY | CHEQUE | VIREMENT

  // Lien vers le VersementPack créé lors de la validation (null avant validation)
  versementPackId       Int?                 @unique
  // Lien vers le RemboursementCredit d'un paiement CC en attente de validation
  // caissier (type CC) : permet de mettre à jour cette ligne (statut/montant
  // réel) lorsque le caissier confirme ou rejette.
  remboursementCreditId Int?                 @unique
  remboursementCredit   RemboursementCredit? @relation(fields: [remboursementCreditId], references: [id])

  collecte      CollecteJournaliere @relation(fields: [collecteId], references: [id], onDelete: Cascade)
  client        Client              @relation(fields: [clientId], references: [id])
  souscription  SouscriptionPack?   @relation(fields: [souscriptionId], references: [id])
  versementPack VersementPack?      @relation(fields: [versementPackId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([collecteId])
  @@index([clientId])
  @@index([souscriptionId])
  @@index([type])
}

// ============================================================
// FOURNISSEURS
// ============================================================

/// Type de fournisseur — CDC Approvisionnement & Supply Chain §8.
enum TypeFournisseur {
  PRODUCTEUR
  COOPERATIVE
  INDUSTRIEL
  IMPORTATEUR
  TRANSPORTEUR
}

model Fournisseur {
  id        Int              @id @default(autoincrement())
  code      String?          @unique // ex FRN-000001, auto-généré à la création
  nom       String
  type      TypeFournisseur?
  contact   String?
  telephone String?
  email     String?
  adresse   String?
  notes     String?
  actif     Boolean          @default(true)

  // Identité légale & internationale (CDC §8 — fiche fournisseur)
  pays      String?
  region    String?
  devise    String? // ex XOF, EUR, USD
  banque    String?
  iban      String? // ou RIB
  rccm      String?
  nif       String?
  numeroTva String?

  // Évaluation (CDC §8 — note globale saisie/consolidée ; les taux de délai/qualité
  // sont recalculés à la volée depuis ReceptionApprovisionnement, pas stockés ici)
  noteGlobale Decimal? // /100

  contrats               ContratFournisseur[]
  litiges                LitigeFournisseur[]
  receptions             ReceptionApprovisionnement[]
  produits               Produit[] // catalogue : produits dont il est le fournisseur principal (Catalogue §3)
  produitsSecondaires    Produit[]                    @relation("ProduitFournisseursSecondaires") // source alternative (CDC Appro §5)
  lots                   LotProduit[] // lots réceptionnés de ce fournisseur (Catalogue Ent.#5)
  reponsesRFQ            ReponseRFQ[] // cotations soumises par ce fournisseur
  rfqRetenues            DemandeCotation[]            @relation("RFQFournisseurRetenu") // RFQ où ce fournisseur a été retenu
  bonsCommande           BonCommande[] // bons de commande émis vers ce fournisseur
  importationsTransitees Importation[]                @relation("ImportationTransitaire") // en tant que transitaire (type TRANSPORTEUR)

  // Compte auxiliaire comptable réel (CDC Comptabilité §17) — sous-compte 401xxx
  // rattaché par FK, auto-provisionné par lib/comptabilite/auxiliaire.ts.
  compteAuxiliaire       CompteComptable?
  immobilisations        Immobilisation[]
  provisionsDepreciation ProvisionDepreciation[]
  avoirs                 AvoirFournisseur[]
  avances                AvanceFournisseur[]
  propositionsOCR        PropositionImputationOCR[]
  facturesAchat          FactureAchat[] // factures matchées par reconnaissance heuristique (CDC IA §51)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum StatutAvoirFournisseur {
  RECU
  UTILISE
  ANNULE
}

/// Avoir fournisseur (note de crédit reçue) — réduit la dette 401xxx envers le
/// fournisseur. Génère une écriture Dr 401 Fournisseur / Cr 601 Achats
/// (inverse d'un achat), via le moteur central (evenement AVOIR_FOURNISSEUR_RECU).
model AvoirFournisseur {
  id            Int                    @id @default(autoincrement())
  reference     String                 @unique
  fournisseurId Int
  fournisseur   Fournisseur            @relation(fields: [fournisseurId], references: [id])
  montant       Decimal
  motif         String
  statut        StatutAvoirFournisseur @default(RECU)
  dateEmission  DateTime               @default(now())
  ecritureId    Int?
  notes         String?
  creeParId     Int
  creePar       User                   @relation("AvoirFournisseurCreateur", fields: [creeParId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fournisseurId])
}

enum StatutAvanceFournisseur {
  VERSEE
  IMPUTEE
  REMBOURSEE
}

/// Avance/acompte versé à un fournisseur (CDC Comptabilité §17) — Dr 402
/// Fournisseurs avances et acomptes versés / Cr Trésorerie. Reste un suivi
/// manuel (statut IMPUTEE) tant qu'aucun rapprochement facture n'est modélisé
/// (cf. écart "facture fournisseur" déjà documenté ailleurs dans ce module).
model AvanceFournisseur {
  id            Int                     @id @default(autoincrement())
  reference     String                  @unique
  fournisseurId Int
  fournisseur   Fournisseur             @relation(fields: [fournisseurId], references: [id])
  montant       Decimal
  montantImpute Decimal                 @default(0)
  statut        StatutAvanceFournisseur @default(VERSEE)
  dateVersement DateTime                @default(now())
  modePaiement  String?
  ecritureId    Int?
  notes         String?
  creeParId     Int
  creePar       User                    @relation("AvanceFournisseurCreateur", fields: [creeParId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fournisseurId])
}

/// Facture fournisseur (CDC Comptabilité §71/§73) : trace le numéro/date de
/// facture reçue et son état de rapprochement avec une réception physique —
/// alimente l'alerte "factures fournisseurs non rapprochées" (§73), qui
/// n'avait aucune source de données avant ce modèle (ni ReceptionApprovisionnement
/// ni BonCommande ne portent de numéro de facture). Portée volontairement
/// contenue : pas de sous-registre de paiements dédié (le règlement reste
/// suivi au niveau du compte auxiliaire 401xxx existant).
model FactureAchat {
  id            Int         @id @default(autoincrement())
  numero        String
  dateFacture   DateTime
  fournisseurId Int
  fournisseur   Fournisseur @relation(fields: [fournisseurId], references: [id])
  montantTTC    Decimal

  receptionApproId Int?
  receptionAppro   ReceptionApprovisionnement? @relation(fields: [receptionApproId], references: [id])

  statutRapprochement String    @default("NON_RAPPROCHEE") // NON_RAPPROCHEE | RAPPROCHEE
  dateRapprochement   DateTime?
  rapprocheParId      Int?
  rapprochePar        User?     @relation("FactureAchatRapprochePar", fields: [rapprocheParId], references: [id])

  notes     String?
  creeParId Int
  creePar   User    @relation("FactureAchatCreateur", fields: [creeParId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fournisseurId])
  @@index([statutRapprochement])
}

/// Contrat rattaché à un fournisseur (CDC §8) — document + période de validité.
model ContratFournisseur {
  id            Int       @id @default(autoincrement())
  fournisseurId Int
  titre         String
  reference     String?
  dateDebut     DateTime?
  dateFin       DateTime?
  fichierUrl    String?
  notes         String?
  actif         Boolean   @default(true) // CDC §15 — soft delete obligatoire

  fournisseur Fournisseur @relation(fields: [fournisseurId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fournisseurId])
}

enum StatutLitigeFournisseur {
  OUVERT
  RESOLU
  REJETE
}

/// Litige/réclamation fournisseur (CDC §8 — critère d'évaluation "Litiges").
/// Sans ce modèle, ce critère n'a aucune source de donnée à calculer.
model LitigeFournisseur {
  id            Int                     @id @default(autoincrement())
  fournisseurId Int
  fournisseur   Fournisseur             @relation(fields: [fournisseurId], references: [id], onDelete: Cascade)
  motif         String
  description   String?
  statut        StatutLitigeFournisseur @default(OUVERT)

  bonCommandeId Int?
  bonCommande   BonCommande? @relation(fields: [bonCommandeId], references: [id])

  creeParId      Int
  creePar        User      @relation("LitigeFournisseurCreePar", fields: [creeParId], references: [id])
  resoluParId    Int?
  resoluPar      User?     @relation("LitigeFournisseurResoluPar", fields: [resoluParId], references: [id])
  dateResolution DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fournisseurId])
  @@index([statut])
}

// ============================================================
// CATALOGUE — RÉFÉRENTIELS (Catalogue §2, §3) — Phase 1
// ============================================================

// Statut de commercialisation d'un produit (Catalogue §14, §21).
enum StatutProduit {
  ACTIF // commercialisé normalement
  EN_ATTENTE // créé, en attente de validation / complétion
  SUSPENDU // temporairement retiré de la vente
  MASQUE // masqué des vues (non visible au catalogue) mais conservé
  ARCHIVE // archivé (fin de vie), conservé pour l'historique
}

model FamilleProduit {
  id           Int                  @id @default(autoincrement())
  nom          String               @unique
  description  String?
  actif        Boolean              @default(true)
  sousFamilles SousFamilleProduit[]
  produits     Produit[]
  promotions   Promotion[]

  // ── Comptabilisation par famille (CDC Comptabilité §53) : niveau intermédiaire
  // de la cascade Produit > Catégorie > Famille > Configuration générale.
  // Résolu par lib/comptabilite/comptesProduit.ts::resoudreComptesProduit.
  compteAchat               String?
  compteVente               String?
  compteStock               String?
  compteVariationStock      String?
  compteTvaAchat            String?
  compteTvaVente            String?
  sectionAnalytiqueDefautId Int?
  sectionAnalytiqueDefaut   SectionAnalytique? @relation("FamilleSectionAnalytique", fields: [sectionAnalytiqueDefautId], references: [id])
  taxesConditionnelles      TaxeConfig[]
  campagnesMarketing        CampagneProduit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SousFamilleProduit {
  id        Int            @id @default(autoincrement())
  nom       String
  familleId Int
  famille   FamilleProduit @relation(fields: [familleId], references: [id], onDelete: Cascade)
  actif     Boolean        @default(true)
  produits  Produit[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([familleId, nom])
  @@index([familleId])
}

model CategorieProduit {
  id             Int                    @id @default(autoincrement())
  nom            String                 @unique
  description    String?
  actif          Boolean                @default(true)
  sousCategories SousCategorieProduit[]
  produits       Produit[]
  promotions     Promotion[]

  // ── Comptabilisation par catégorie (CDC Comptabilité §53) : niveau
  // intermédiaire de la cascade Produit > Catégorie > Famille > Config générale.
  compteAchat               String?
  compteVente               String?
  compteStock               String?
  compteVariationStock      String?
  compteTvaAchat            String?
  compteTvaVente            String?
  sectionAnalytiqueDefautId Int?
  sectionAnalytiqueDefaut   SectionAnalytique? @relation("CategorieSectionAnalytique", fields: [sectionAnalytiqueDefautId], references: [id])
  taxesConditionnelles      TaxeConfig[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SousCategorieProduit {
  id          Int              @id @default(autoincrement())
  nom         String
  categorieId Int
  categorie   CategorieProduit @relation(fields: [categorieId], references: [id], onDelete: Cascade)
  actif       Boolean          @default(true)
  produits    Produit[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([categorieId, nom])
  @@index([categorieId])
}

model MarqueProduit {
  id         Int         @id @default(autoincrement())
  nom        String      @unique
  logoUrl    String?
  actif      Boolean     @default(true)
  produits   Produit[]
  promotions Promotion[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

// Unité de mesure (vente ou achat) : "Kilogramme" (kg), "Carton", "Pièce"…
model UniteProduit {
  id            Int       @id @default(autoincrement())
  nom           String    @unique
  symbole       String?
  actif         Boolean   @default(true)
  produitsVente Produit[] @relation("ProduitUniteVente")
  produitsAchat Produit[] @relation("ProduitUniteAchat")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ============================================================
// PRODUITS & STOCK
// ============================================================

model Produit {
  id           Int      @id @default(autoincrement())
  reference    String?  @unique // référence interne (saisie manuelle)
  nom          String
  description  String?
  categorie    String? // legacy (texte libre) — conservé ; classification structurée ci-dessous
  unite        String? // legacy ("kg", "litre"…) — conservé ; unités structurées ci-dessous
  prixUnitaire Decimal
  prixAchat    Decimal? // 👈 nouveau champ (nullable conseillé)
  alerteStock  Int      @default(0) // seuil d'alerte global
  actif        Boolean  @default(true)

  // ── Catalogue §3 : identification enrichie ───────────────────────────────
  codeProduit   String?       @unique // code produit auto-généré (ex: PRD-000001)
  codeBarre     String?       @unique // code-barres (EAN/UPC)
  qrCode        String? // contenu/URL encodé dans le QR
  nomCommercial String?
  statut        StatutProduit @default(ACTIF)

  // ── Catalogue §3 : classification structurée ─────────────────────────────
  familleId               Int?
  famille                 FamilleProduit?        @relation(fields: [familleId], references: [id])
  sousFamilleId           Int?
  sousFamille             SousFamilleProduit?    @relation(fields: [sousFamilleId], references: [id])
  categorieId             Int?
  categorieProduit        CategorieProduit?      @relation(fields: [categorieId], references: [id])
  sousCategorieId         Int?
  sousCategorie           SousCategorieProduit?  @relation(fields: [sousCategorieId], references: [id])
  marqueId                Int?
  marque                  MarqueProduit?         @relation(fields: [marqueId], references: [id])
  fournisseurPrincipalId  Int?
  fournisseurPrincipal    Fournisseur?           @relation(fields: [fournisseurPrincipalId], references: [id])
  fournisseursSecondaires Fournisseur[]          @relation("ProduitFournisseursSecondaires") // CDC §5 — sources alternatives
  paysOrigine             String?
  coupons                 Coupon[]
  landingPagesMarketing   LandingPageMarketing[]

  // ── Comptabilité §52 : mapping comptable de la fiche produit — niveau le plus
  // précis de la cascade Produit > Catégorie > Famille > Configuration générale
  // (CDC §53). Résolu par lib/comptabilite/comptesProduit.ts::resoudreComptesProduit,
  // chaque champ hérité indépendamment si laissé vide ici.
  compteAchat               String?
  compteVente               String?
  compteStock               String?
  compteVariationStock      String?
  compteTvaAchat            String?
  compteTvaVente            String?
  sectionAnalytiqueDefautId Int?
  sectionAnalytiqueDefaut   SectionAnalytique? @relation("ProduitSectionAnalytique", fields: [sectionAnalytiqueDefautId], references: [id])

  // ── Catalogue §3 : caractéristiques ──────────────────────────────────────
  poids            Decimal? // en kg
  volume           Decimal? // en litres
  dimensions       String? // ex: "30x20x10 cm"
  couleur          String?
  saveur           String?
  conditionnement  String? // ex: "Carton de 12" (colisage)
  unitesParPalette Int? // CDC §5 — palettisation
  uniteVenteId     Int?
  uniteVente       UniteProduit? @relation("ProduitUniteVente", fields: [uniteVenteId], references: [id])
  uniteAchatId     Int?
  uniteAchat       UniteProduit? @relation("ProduitUniteAchat", fields: [uniteAchatId], references: [id])

  // ── Catalogue §3 : images & documents ────────────────────────────────────
  imagePrincipaleUrl String?
  imagesSecondaires  String[] // URLs / data-URIs (Postgres array)
  ficheTechniqueUrl  String?
  videoUrl           String?

  // Stock localisé par site (remplace l'ancien champ global stock)
  stocks         StockSite[]
  mouvements     MouvementStock[]
  historiquePrix HistoriquePrixProduit[]

  // Packs & fidélité
  lignesReceptionPack LigneReceptionPack[]
  recompensesFidelite RecompenseFidelite[]
  packsCibleProduit   Pack[]               @relation("PackProduitCible")

  // Opérations stock
  anomalies            AnomalieStock[]
  lignesVenteDirecte   LigneVenteDirecte[]
  lignesTransfert      LigneTransfertStock[]
  lignesReceptionAppro LigneReceptionAppro[]
  lignesInventaire     LigneInventaireSite[]
  lignesCommande       LigneCommandeInterne[]
  lignesBonSortie      LigneBonSortie[]

  // Crédits clients
  lignesCreditProduit   LigneCreditClient[] @relation("LigneCreditProduit")
  lignesCreditSubstitut LigneCreditClient[] @relation("LigneCreditSubstitut")

  // Ajustements stock
  demandesAjustement DemandeAjustementStock[]

  // Lignes souscription produits
  lignesSouscriptionDemande   LigneSouscriptionProduit[] @relation("LigneProduitDemande")
  lignesSouscriptionSubstitut LigneSouscriptionProduit[] @relation("LigneProduitSubstitut")

  prix                    PrixProduit[] // tarification multiple (Catalogue §4) — Phase 2
  demandesPrix            DemandeChangementPrix[] // demandes de changement de prix (Catalogue §15) — Phase 4
  promotions              Promotion[]             @relation("PromotionProduit") // promotions ciblant ce produit (Catalogue §9) — Phase 5
  lots                    LotProduit[] // lots & péremption FEFO (Catalogue Ent.#5) — Phase 10
  substituts              ProduitSubstitut[]      @relation("ProduitSubstituts") // équivalents proposés pour CE produit (Ent.#4) — Phase 11
  estSubstitutDe          ProduitSubstitut[]      @relation("ProduitEstSubstitutDe") // produits dont CE produit est l'équivalent
  demandesCotation        DemandeCotation[] // RFQ portant sur ce produit
  lignesBonCommande       LigneBonCommande[] // lignes de bons de commande portant sur ce produit
  lignesEcritureComptable LigneEcriture[] // imputation analytique axe Produit (Comptabilité §24)
  lignesBudget            LigneBudget[] // ventilation budgétaire par produit (Comptabilité §25)
  campagnesMarketing      CampagneProduit[] // produits ciblés par une campagne marketing (Phase 1)
  publicationsSociales    PublicationSociale[] // publications réseaux sociaux liées à ce produit (Phase 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut])
  @@index([familleId])
  @@index([categorieId])
  @@index([marqueId])
  @@index([fournisseurPrincipalId])
}

// ============================================================
// CATALOGUE — TARIFICATION FLEXIBLE (Catalogue §4, Ent.#1/#2/#6) — Phase 2
// ============================================================

// Type / profil de prix. Un même produit peut avoir plusieurs prix simultanés,
// éventuellement spécifiques à une agence, une ville ou une région (Ent.#1),
// ou associés à un profil de client (Ent.#2).
enum TypePrix {
  ACHAT // prix d'achat
  FOURNISSEUR // prix fournisseur (avant négociation/frais)
  REVIENT // prix de revient (calculé : achat + frais logistiques)
  GROS // prix de gros / grossiste
  DETAIL // prix de détail (= prix comptant public)
  COMMUNAUTE // prix Communauté AfriSime
  VIP // prix VIP
  PROMOTION // prix promotionnel (piloté aussi par le module Promotions)
  PERSONNEL // prix personnel (employés)
  PARTENAIRE // prix partenaire
  REVENDEUR // prix revendeur
  CREDIT // prix spécifique vente à crédit
  NOUVEAU_CLIENT // profil fidélité : nouveau client
  FIDELE // profil fidélité : client fidèle
}

// Portée géographique d'un prix (Ent.#1 — tarification géographique).
enum PorteePrix {
  GLOBAL // s'applique partout (défaut)
  AGENCE // spécifique à un point de vente
  VILLE // spécifique à une ville
  REGION // spécifique à une région
}

// Ligne de prix d'un produit. La combinaison (produit, type, portée, cible) est
// unique parmi les lignes actives — l'unicité fine est gérée applicativement.
model PrixProduit {
  id        Int      @id @default(autoincrement())
  produitId Int
  produit   Produit  @relation(fields: [produitId], references: [id], onDelete: Cascade)
  type      TypePrix
  montant   Decimal
  devise    String   @default("XOF")

  portee         PorteePrix    @default(GLOBAL)
  pointDeVenteId Int? // si portee = AGENCE
  pointDeVente   PointDeVente? @relation("PrixProduitPDV", fields: [pointDeVenteId], references: [id])
  ville          String? // si portee = VILLE
  region         String? // si portee = REGION

  // Origine du prix : MANUEL (saisi) ou AUTO (moteur de prix). Ent.#6.
  auto      Boolean   @default(false)
  actif     Boolean   @default(true)
  dateDebut DateTime? // début de validité (optionnel)
  dateFin   DateTime? // fin de validité (optionnel)

  creeParId Int?
  creePar   User? @relation("PrixProduitCreePar", fields: [creeParId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([produitId])
  @@index([type])
  @@index([produitId, type, portee])
  @@index([pointDeVenteId])
}

// Paramétrage du moteur de prix automatique (Ent.#6) — enregistrement unique id=1.
// prixVente = arrondi( (coûtAchat + fraisLogistiques) × (1 + margeCible%) ).
model ParametragePrixAuto {
  id                        Int      @id @default(1)
  actif                     Boolean  @default(false) // le recalcul auto n'écrase rien tant que désactivé
  margeCiblePct             Decimal  @default(20) // marge cible par défaut (% sur le prix de revient)
  fraisLogistiquePct        Decimal  @default(0) // frais logistiques ajoutés au coût (% de l'achat)
  arrondi                   Int      @default(0) // arrondir le prix au multiple de N (0 = pas d'arrondi)
  appliquerSurCredit        Boolean  @default(false) // recalcule aussi le prix CREDIT (avec marge crédit)
  margeCreditPct            Decimal  @default(0) // marge additionnelle appliquée au prix crédit
  // Gouvernance des prix (Catalogue §15) : si activé, tout changement de prix de
  // vente/achat doit passer par une demande validée (Chef d'agence/Admin/Resp. Marketing).
  validationPrixObligatoire Boolean  @default(false)
  updatedAt                 DateTime @updatedAt
}

// Statut d'une demande de changement de prix (Catalogue §15).
enum StatutDemandePrix {
  EN_ATTENTE
  APPROUVE
  REJETE
}

// Base de prix visée par une demande (les deux prix « socle » du produit).
enum ChampPrixDemande {
  VENTE // prix de vente (Produit.prixUnitaire)
  ACHAT // prix d'achat (Produit.prixAchat)
}

// Demande de changement de prix soumise à validation (Catalogue §5, §15).
model DemandeChangementPrix {
  id          Int               @id @default(autoincrement())
  produitId   Int
  produit     Produit           @relation(fields: [produitId], references: [id], onDelete: Cascade)
  champ       ChampPrixDemande
  ancienPrix  Decimal?
  nouveauPrix Decimal
  motif       String
  statut      StatutDemandePrix @default(EN_ATTENTE)

  // Traçabilité complète (Catalogue §15)
  demandeParId Int
  demandePar   User     @relation("DemandePrixDemandeur", fields: [demandeParId], references: [id])
  ip           String?
  agence       String?
  createdAt    DateTime @default(now())

  valideParId Int?
  validePar   User?     @relation("DemandePrixValideur", fields: [valideParId], references: [id])
  valideAt    DateTime?
  motifRejet  String?

  @@index([produitId])
  @@index([statut])
}

// ============================================================
// CATALOGUE — PROMOTIONS (Catalogue §9) — Phase 5
// ============================================================

// Nature de la remise appliquée par une promotion (§9 : fixe / % / lot).
enum TypeRemisePromotion {
  POURCENTAGE // remise en % du prix (ex : -15 %)
  MONTANT // remise d'un montant fixe (ex : -500 XOF)
  LOT // offre par lot (ex : acheté N, payé M)
}

// Périmètre produit d'une promotion : sur quoi elle porte (§9).
enum CiblePromotion {
  PRODUIT // un produit précis
  CATEGORIE // toute une catégorie
  FAMILLE // toute une famille
  MARQUE // toute une marque
  TOUS // tout le catalogue
}

// Promotion commerciale (Catalogue §9). Une promo porte sur un périmètre produit
// (produit/catégorie/famille/marque/tous) et peut être restreinte à une agence,
// un segment (communauté) ou un client précis, sur une période donnée.
model Promotion {
  id          Int     @id @default(autoincrement())
  code        String  @unique // auto : PROMO-000001
  nom         String
  description String?

  // ── Périmètre produit (Catalogue §9) ─────────────────────────────────────
  cible       CiblePromotion    @default(PRODUIT)
  produitId   Int?
  produit     Produit?          @relation("PromotionProduit", fields: [produitId], references: [id])
  categorieId Int?
  categorie   CategorieProduit? @relation(fields: [categorieId], references: [id])
  familleId   Int?
  famille     FamilleProduit?   @relation(fields: [familleId], references: [id])
  marqueId    Int?
  marque      MarqueProduit?    @relation(fields: [marqueId], references: [id])

  // ── Nature de la remise (fixe / % / lot) ─────────────────────────────────
  typeRemise TypeRemisePromotion
  valeur     Decimal             @default(0) // % (POURCENTAGE) ou montant XOF (MONTANT)
  lotAchete  Int? // LOT : quantité à acheter
  lotPaye    Int? // LOT : quantité facturée

  // ── Restrictions bénéficiaires (agence / communauté / client) ────────────
  pointDeVenteId Int?
  pointDeVente   PointDeVente?  @relation("PromotionPDV", fields: [pointDeVenteId], references: [id])
  segment        SegmentClient? // limite à un segment (communauté) — null = tous
  clientId       Int?
  client         Client?        @relation("PromotionClient", fields: [clientId], references: [id])

  // ── Période & activation ─────────────────────────────────────────────────
  dateDebut DateTime
  dateFin   DateTime
  actif     Boolean  @default(true)
  priorite  Int      @default(0) // départage si plusieurs promos matchent (plus haut = prioritaire)

  // Attribution CA à une campagne marketing (Marketing §32, Phase 5) — additif,
  // même pattern que VenteDirecte.campagneId/CreditClient.campagneId (Phase 1).
  campagneId Int?
  campagne   Campagne? @relation(fields: [campagneId], references: [id])

  creeParId Int?
  creePar   User?    @relation("PromotionCreePar", fields: [creeParId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([actif, dateDebut, dateFin])
  @@index([cible])
  @@index([produitId])
  @@index([categorieId])
  @@index([familleId])
  @@index([marqueId])
  @@index([pointDeVenteId])
  @@index([campagneId])
}

// ============================================================
// MARKETING — Phase 5 : Coupons (CDC §35)
// ============================================================
// Distinct de Promotion (remise automatique par ligne, sans code) : un Coupon
// est un CODE saisi (ex AFRI10) appliqué au panier (VenteDirecte.montantTotal),
// avec plafond d'utilisation. Réutilise TypeRemisePromotion (POURCENTAGE/MONTANT).

model Coupon {
  id          Int     @id @default(autoincrement())
  code        String  @unique // ex AFRI10 (saisi ou généré)
  nom         String
  description String?

  campagneId Int?
  campagne   Campagne? @relation(fields: [campagneId], references: [id])

  typeRemise TypeRemisePromotion
  valeur     Decimal             @default(0)

  audienceId Int?
  audience   AudienceMarketing? @relation(fields: [audienceId], references: [id])

  pointDeVenteId Int?
  pointDeVente   PointDeVente? @relation(fields: [pointDeVenteId], references: [id])

  produitId Int?
  produit   Produit? @relation(fields: [produitId], references: [id])

  dateDebut      DateTime
  dateFin        DateTime
  utilisationMax Int? // null = illimité (global)
  actif          Boolean  @default(true)

  utilisations CouponUtilisation[]
  ventes       VenteDirecte[]

  // Marketing (Phase 6) — coupon émis pour un partenaire (influenceur/affilié).
  lienAffiliation LienAffiliation?

  creeParId Int
  creePar   User     @relation(fields: [creeParId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([actif, dateDebut, dateFin])
  @@index([campagneId])
}

/// Un client n'utilise un coupon donné qu'une fois (@@unique) — simplification
/// assumée, cohérente avec les codes d'exemple du CDC (AFRI10, WELCOME…).
model CouponUtilisation {
  id       Int           @id @default(autoincrement())
  couponId Int
  coupon   Coupon        @relation(fields: [couponId], references: [id], onDelete: Cascade)
  clientId Int
  client   Client        @relation(fields: [clientId], references: [id])
  venteId  Int?
  vente    VenteDirecte? @relation(fields: [venteId], references: [id])

  montantRemise   Decimal
  dateUtilisation DateTime @default(now())

  @@unique([couponId, clientId])
  @@index([couponId])
}

// ============================================================
// CATALOGUE — LOTS & PÉREMPTION (FEFO) (Enterprise #5) — Phase 10
// ============================================================

// Cycle de vie d'un lot.
enum StatutLot {
  ACTIF // en stock, vendable
  EPUISE // quantité épuisée
  PERIME // DLC dépassée, retiré de la vente
  RETIRE // retiré manuellement (rappel, casse, don…)
}

// Nature d'un mouvement de lot (traçabilité FEFO).
enum TypeMouvementLot {
  ENTREE // réception / création du lot
  SORTIE // déstockage (vente/livraison) — FEFO
  AJUSTEMENT // correction de quantité
  PEREMPTION // retrait pour péremption
  RETRAIT // retrait manuel (rappel, casse)
}

// Lot d'un produit sur un site : quantité tracée avec date de péremption (DLC)
// et/ou durabilité minimale (DLUO). Le déstockage suit le principe FEFO
// (First Expired, First Out) : on consomme d'abord le lot qui périme le plus tôt.
model LotProduit {
  id             Int          @id @default(autoincrement())
  numeroLot      String
  produitId      Int
  produit        Produit      @relation(fields: [produitId], references: [id], onDelete: Cascade)
  pointDeVenteId Int
  pointDeVente   PointDeVente @relation(fields: [pointDeVenteId], references: [id])

  quantiteInitiale Int
  quantite         Int       @default(0) // quantité restante dans le lot
  dateFabrication  DateTime? // CDC §5 — date de fabrication (distincte de la DLC)
  dlc              DateTime? // date limite de consommation (péremption stricte)
  dluo             DateTime? // date de durabilité minimale (qualité optimale)
  dateReception    DateTime  @default(now())
  prixAchat        Decimal?
  statut           StatutLot @default(ACTIF)

  fournisseurId    Int?
  fournisseur      Fournisseur?                @relation(fields: [fournisseurId], references: [id])
  receptionApproId Int? // réception d'appro à l'origine du lot (traçabilité)
  receptionAppro   ReceptionApprovisionnement? @relation(fields: [receptionApproId], references: [id])
  notes            String?

  creeParId Int?
  creePar   User?    @relation("LotProduitCreePar", fields: [creeParId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mouvements      MouvementLot[]
  lignesReception LigneReceptionAppro[]

  @@unique([produitId, pointDeVenteId, numeroLot])
  @@index([produitId, pointDeVenteId, statut])
  @@index([dlc])
  @@index([statut])
  @@index([receptionApproId])
}

// Journal des mouvements d'un lot (entrées / sorties FEFO / ajustements).
model MouvementLot {
  id          Int              @id @default(autoincrement())
  lotId       Int
  lot         LotProduit       @relation(fields: [lotId], references: [id], onDelete: Cascade)
  type        TypeMouvementLot
  quantite    Int // valeur positive ; le sens dépend du type
  motif       String?
  operateurId Int?
  operateur   User?            @relation("MouvementLotOperateur", fields: [operateurId], references: [id])
  createdAt   DateTime         @default(now())

  @@index([lotId])
  @@index([type])
}

// ============================================================
// CATALOGUE — PRODUITS DE SUBSTITUTION (Enterprise #4) — Phase 11
// ============================================================

// Lien de substitution : `substitut` est un équivalent proposé pour `produit`
// (typiquement quand `produit` est en rupture). Relation dirigée + option
// `bidirectionnel` pour proposer aussi l'inverse. Priorité = ordre de préférence.
model ProduitSubstitut {
  id             Int      @id @default(autoincrement())
  produitId      Int
  produit        Produit  @relation("ProduitSubstituts", fields: [produitId], references: [id], onDelete: Cascade)
  substitutId    Int
  substitut      Produit  @relation("ProduitEstSubstitutDe", fields: [substitutId], references: [id], onDelete: Cascade)
  priorite       Int      @default(0) // ordre de préférence (décroissant)
  bidirectionnel Boolean  @default(true) // si vrai, l'inverse est aussi un substitut
  note           String?
  creeParId      Int?
  creePar        User?    @relation("ProduitSubstitutCreePar", fields: [creeParId], references: [id])
  createdAt      DateTime @default(now())

  @@unique([produitId, substitutId])
  @@index([produitId])
  @@index([substitutId])
}

// ============================================================
// CATALOGUE — VUES PERSONNALISÉES (Catalogue §21-24) — Phase 12
// ============================================================

// Mode d'affichage du stock dans une vue (§21.H : le client ne voit jamais la
// quantité exacte, seulement un palier).
enum ModeStockVue {
  EXACT // quantité exacte (personnel interne)
  PALIER // tranche « Plus de 50 / Disponible / Stock limité / Sur commande »
  AUCUN // stock masqué
}

// Configuration d'une vue catalogue par profil/rôle (§22 — moteur de vues).
// Décrit, pour un rôle (Admin, Caissier, Client, Visiteur…), quels CHAMPS du
// produit sont visibles, comment le stock est affiché, et des filtres par
// défaut. Distinct du RBAC d'actions : ici on pilote la VISIBILITÉ des données.
// La configuration est centralisée (source unique) → cohérence entre surfaces
// mobile / web / borne / QR (§24 synchro).
model VueCatalogue {
  id             Int          @id @default(autoincrement())
  cle            String       @unique // ADMIN, CAISSIER, CLIENT, VISITEUR, ...
  nom            String
  description    String?
  champsVisibles String[] // clés de champs visibles (voir lib/vuesCatalogue)
  modeStock      ModeStockVue @default(EXACT)
  filtres        Json? // filtres par défaut (statut, famille, agence…) — §23
  actif          Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// Stock d'un produit sur un site précis (PDV ou dépôt central)
model StockSite {
  id                 Int   @id @default(autoincrement())
  produitId          Int
  pointDeVenteId     Int
  quantite           Float @default(0) // 4.1 disponible — physiquement vendable (décimal : demi-quantités crédit)
  quantiteReservee   Float @default(0) // 4.2 réservé — engagé (ventes crédit en attente d'approbation)
  quantiteEnTransit  Int   @default(0) // 4.3 en transit — commandé, non encore réceptionné
  quantiteEndommagee Int   @default(0) // 4.4 endommagé — non vendable (perte/casse mis de côté)
  quantiteBloquee    Int   @default(0) // CDC §11 — sous blocage qualité/litige, non vendable
  quantiteConsignee  Int   @default(0) // CDC §11 — en dépôt-vente, propriété du fournisseur jusqu'à vente
  // 4.5 stockTheorique = quantite + quantiteReservee + quantiteEnTransit - quantiteEndommagee (calculé)
  alerteStock        Int? // seuil d'alerte spécifique au site (override global)

  // ── Catalogue §6 : paramétrage par agence — Phase 3 ──────────────────────
  disponible    Boolean @default(true) // produit commercialisé (Oui/Non) sur cette agence
  stockMin      Int? // stock minimum (déclenche le réapprovisionnement)
  stockMax      Int? // stock maximum (capacité cible)
  seuilCritique Int? // seuil de rupture imminente (rouge) — sous ce niveau = critique
  rayon         String? // emplacement : rayon
  etagere       String? // emplacement : étagère
  allee         String? // emplacement : allée

  produit      Produit      @relation(fields: [produitId], references: [id])
  pointDeVente PointDeVente @relation(fields: [pointDeVenteId], references: [id])

  @@unique([produitId, pointDeVenteId])
  @@index([pointDeVenteId])
  @@index([produitId])
}

// Journal de chaque mouvement de stock (entrée / sortie / ajustement)
model MouvementStock {
  id             Int              @id @default(autoincrement())
  produitId      Int
  pointDeVenteId Int? // PDV ou dépôt concerné (nullable pour rétrocompat)
  type           TypeMouvement
  typeEntree     TypeEntreeStock? // précision si type == ENTREE
  typeSortie     TypeSortieStock? // précision si type == SORTIE
  quantite       Int
  prixUnitaire   Decimal? // prix de vente au client (renseigné pour les sorties livraison pack)
  motif          String?
  reference      String           @unique
  dateMouvement  DateTime         @default(now())
  operateurId    Int? // userId de l'opérateur

  // Références aux documents sources (traçabilité)
  receptionApproId Int?
  transfertStockId Int?
  venteDirecteId   Int?
  souscriptionId   Int? // pour livraison pack
  bonSortieId      Int? // pour sortie exceptionnelle (perte, casse, don…)

  produit      Produit       @relation(fields: [produitId], references: [id])
  pointDeVente PointDeVente? @relation(fields: [pointDeVenteId], references: [id])
  operateur    User?         @relation("MouvementsStock", fields: [operateurId], references: [id])

  @@index([produitId])
  @@index([pointDeVenteId])
  @@index([type])
  @@index([dateMouvement])
}

// Type de changement de prix (ce qui a été modifié dans l'entrée d'historique)
enum TypeChangementPrix {
  INITIAL // création du produit
  ACHAT // seul le prix d'achat a changé (typiquement lors d'un approvisionnement)
  VENTE // seul le prix de vente (prixUnitaire) a changé
  LES_DEUX // achat et vente modifiés en même temps
}

// Historique daté des prix d'un produit (achat & vente) — traçabilité & transparence.
// Chaque entrée est un SNAPSHOT des deux prix effectifs à partir de `dateEffet`,
// même si un seul des deux a changé : cela permet de retrouver le prix appliqué à
// n'importe quelle date et de calculer la marge figée du moment.
model HistoriquePrixProduit {
  id               Int                @id @default(autoincrement())
  produitId        Int
  prixAchat        Decimal? // prix d'achat effectif à partir de dateEffet
  prixVente        Decimal // prix de vente (prixUnitaire) effectif à partir de dateEffet
  marge            Decimal? // vente - achat (valeur), figée au moment du changement
  type             TypeChangementPrix
  source           String? // MANUEL | APPRO | INITIAL | VALIDATION | ...
  motif            String?
  receptionApproId Int? // réception d'appro à l'origine d'un changement de prix d'achat
  ip               String? // adresse IP de l'auteur (Catalogue §15)
  agence           String? // agence de l'auteur au moment du changement (Catalogue §15)
  valideParId      Int? // validateur si le changement a suivi le workflow (Catalogue §5)
  dateEffet        DateTime           @default(now())
  creeParId        Int?
  createdAt        DateTime           @default(now())

  produit Produit @relation(fields: [produitId], references: [id], onDelete: Cascade)
  creePar User?   @relation("HistoriquePrixCreateur", fields: [creeParId], references: [id])

  @@index([produitId, dateEffet])
  @@index([dateEffet])
}

// ============================================================
// RÉCEPTIONS D'APPROVISIONNEMENT (Magasinier / Agent Logistique)
// ============================================================

model ReceptionApprovisionnement {
  id        Int                  @id @default(autoincrement())
  reference String               @unique
  type      TypeReceptionAppro
  statut    StatutReceptionAppro @default(BROUILLON)

  // Site qui réceptionne (PDV ou dépôt)
  pointDeVenteId Int
  pointDeVente   PointDeVente @relation(fields: [pointDeVenteId], references: [id])

  // Pour réception FOURNISSEUR
  fournisseurId  Int?
  fournisseur    Fournisseur? @relation(fields: [fournisseurId], references: [id])
  fournisseurNom String? // si fournisseur non encore enregistré

  // PO honoré par cette réception (facultatif — une réception peut aussi être
  // libre, sans bon de commande formel, comme aujourd'hui)
  bonCommandeId Int?
  bonCommande   BonCommande? @relation(fields: [bonCommandeId], references: [id])

  // Pour réception INTERNE (depuis un autre dépôt / siège)
  origineId    Int?
  origineNom   String?
  origineDepot PointDeVente? @relation("ReceptionsEnTantQuOrigine", fields: [origineId], references: [id])

  datePrevisionnelle DateTime
  dateReception      DateTime?

  // Achat comptant/crédit (CDC Comptabilité) — détermine si l'écriture générée
  // crédite le fournisseur (401, par défaut) ou directement la trésorerie
  // (comptant, réglé à la livraison). modePaiement n'est utilisé que si COMPTANT
  // (ESPECES/VIREMENT/CHEQUE/MOBILE_MONEY).
  modeReglement ModeReglementAchat @default(CREDIT)
  modePaiement  String?

  // Contrôle qualité — saisie obligatoire avant mise en stock
  controlQualite Boolean @default(false)
  notesQualite   String?
  notes          String?

  receptionneParId Int
  receptionnePar   User  @relation("ReceptionnaireAppro", fields: [receptionneParId], references: [id])
  valideParId      Int?
  validePar        User? @relation("ValidateurAppro", fields: [valideParId], references: [id])

  lignes        LigneReceptionAppro[]
  lots          LotProduit[]
  facturesAchat FactureAchat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut])
  @@index([type])
  @@index([pointDeVenteId])
}

model LigneReceptionAppro {
  id                 Int      @id @default(autoincrement())
  receptionId        Int
  produitId          Int
  quantiteAttendue   Int
  quantiteRecue      Int?
  quantiteRefusee    Int?     @default(0) // CDC §10 — refusé/retourné au fournisseur, n'entre jamais en stock
  quantiteEndommagee Int?     @default(0) // CDC §10 — abîmé mais conservé, entre en stock côté StockSite.quantiteEndommagee (non vendable)
  prixUnitaire       Decimal?
  etatQualite        String? // "BON" | "DEFECTUEUX" | "PARTIEL"
  notes              String?

  // Lot & péremption (Enterprise #5) : si renseignés à la réception, un LotProduit
  // est créé automatiquement à la validation (traçabilité FEFO). Optionnels.
  numeroLot       String?
  dateFabrication DateTime? // CDC §5/§10 — date de fabrication (distincte de la DLC)
  dlc             DateTime? // date limite de consommation
  dluo            DateTime? // date de durabilité minimale
  // Lot effectivement créé/réalimenté par cette ligne (renseigné après la mise en stock).
  lotId           Int?
  lot             LotProduit? @relation(fields: [lotId], references: [id])

  reception ReceptionApprovisionnement @relation(fields: [receptionId], references: [id], onDelete: Cascade)
  produit   Produit                    @relation(fields: [produitId], references: [id])

  @@index([lotId])
}

// ============================================================
// RFQ — DEMANDE DE COTATION (CDC Approvisionnement §7 étapes 5-6)
// Consultation de plusieurs fournisseurs avec comparatif automatique
// (prix / délai / qualité) et recommandation du meilleur. Pas de portail
// fournisseur externe : les cotations reçues (téléphone, email…) sont
// saisies par l'agent appro ; l'email de consultation, lui, est envoyé
// automatiquement (lib/email.ts) si le fournisseur a une adresse.
// ============================================================

enum StatutRFQ {
  BROUILLON // en préparation, fournisseurs pas encore consultés
  ENVOYEE // consultation envoyée aux fournisseurs sélectionnés
  REPONSES_RECUES // au moins une cotation saisie
  CLOTUREE // fournisseur retenu
  ANNULEE
}

enum StatutReponseRFQ {
  EN_ATTENTE
  RECUE
  RETENUE
  REJETEE
}

model DemandeCotation {
  id        Int       @id @default(autoincrement())
  reference String    @unique // ex RFQ-TG-2026-000001
  statut    StatutRFQ @default(BROUILLON)

  produitId Int
  produit   Produit @relation(fields: [produitId], references: [id])
  quantite  Int

  // Site demandeur (facultatif — RFQ peut couvrir un besoin agrégé multi-agences)
  pointDeVenteId Int?
  pointDeVente   PointDeVente? @relation(fields: [pointDeVenteId], references: [id])

  dateLimiteReponse DateTime?
  notes             String?

  creeParId Int // User.id

  fournisseurRetenuId Int?
  fournisseurRetenu   Fournisseur? @relation("RFQFournisseurRetenu", fields: [fournisseurRetenuId], references: [id])
  dateCloture         DateTime?

  reponses     ReponseRFQ[]
  bonsCommande BonCommande[] // PO créés à partir de cette RFQ

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut])
  @@index([produitId])
}

model ReponseRFQ {
  id            Int              @id @default(autoincrement())
  demandeId     Int
  demande       DemandeCotation  @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  fournisseurId Int
  fournisseur   Fournisseur      @relation(fields: [fournisseurId], references: [id])
  statut        StatutReponseRFQ @default(EN_ATTENTE)

  emailEnvoyeA        DateTime? // date d'envoi de la consultation à ce fournisseur
  prixUnitaire        Decimal?
  delaiLivraisonJours Int?
  notes               String?
  dateReponse         DateTime? // date de saisie de la cotation reçue

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([demandeId, fournisseurId])
  @@index([fournisseurId])
}

// ============================================================
// BON DE COMMANDE (PO) — CDC Approvisionnement §7 étapes 7-8
// Document distinct de la réception physique (ReceptionApprovisionnement) :
// le PO couvre la commande/l'engagement fournisseur (workflow d'approbation,
// envoi, "signature"), la réception couvre la mise en stock effective.
// Une réception peut référencer le PO qu'elle honore (bonCommandeId).
//
// "Signature électronique" : pas de prestataire de signature qualifiée
// intégré (DocuSign etc.) — implémentée comme un tampon interne (utilisateur
// + horodatage) au moment de l'approbation, pas une signature cryptographique
// à valeur probatoire. À remplacer si une vraie solution de signature est
// requise plus tard.
// ============================================================

enum StatutBonCommande {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  ACKNOWLEDGED
  PARTIALLY_DELIVERED
  COMPLETED
  CANCELLED
}

enum StatutLivraisonPO {
  PREPARATION
  EXPEDIEE
  EN_TRANSIT
  DOUANE
  LIVREE
  RECEPTIONNEE
}

model BonCommande {
  id              Int                @id @default(autoincrement())
  reference       String             @unique // ex PO-TG-2026-000001
  statut          StatutBonCommande  @default(DRAFT)
  statutLivraison StatutLivraisonPO?

  fournisseurId  Int
  fournisseur    Fournisseur  @relation(fields: [fournisseurId], references: [id])
  pointDeVenteId Int
  pointDeVente   PointDeVente @relation(fields: [pointDeVenteId], references: [id])

  // Origine RFQ (facultatif — un PO peut aussi être créé directement)
  demandeCotationId Int?
  demandeCotation   DemandeCotation? @relation(fields: [demandeCotationId], references: [id])

  dateCommande        DateTime  @default(now())
  dateLivraisonPrevue DateTime?
  devise              String?   @default("XOF")
  montantTotal        Decimal   @default(0) // recalculé à chaque modif de lignes
  montantPaye         Decimal   @default(0) // CDC §14 — alimente "factures à payer" / prévisions de trésorerie

  notes String?

  creeParId       Int
  creePar         User      @relation("BonCommandeCreateur", fields: [creeParId], references: [id])
  approuveParId   Int?
  approuvePar     User?     @relation("BonCommandeApprobateur", fields: [approuveParId], references: [id])
  dateApprobation DateTime?
  envoyeParId     Int?
  envoyePar       User?     @relation("BonCommandeEnvoyeur", fields: [envoyeParId], references: [id])
  dateEnvoi       DateTime?
  signeParId      Int?
  signePar        User?     @relation("BonCommandeSignataire", fields: [signeParId], references: [id])
  dateSignature   DateTime?

  lignes      LigneBonCommande[]
  receptions  ReceptionApprovisionnement[]
  importation Importation?
  litiges     LitigeFournisseur[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut])
  @@index([fournisseurId])
  @@index([pointDeVenteId])
}

model LigneBonCommande {
  id            Int         @id @default(autoincrement())
  bonCommandeId Int
  bonCommande   BonCommande @relation(fields: [bonCommandeId], references: [id], onDelete: Cascade)
  produitId     Int
  produit       Produit     @relation(fields: [produitId], references: [id])
  quantite      Int
  prixUnitaire  Decimal
  quantiteRecue Int         @default(0) // alimenté à la réception, pilote PARTIALLY_DELIVERED/COMPLETED

  @@index([bonCommandeId])
}

// ============================================================
// IMPORTATIONS — CDC Approvisionnement §9
// Rattachée à un bon de commande (achat international). "Suivi temps réel" :
// pas d'intégration transporteur/API douane — journal de checkpoints saisis
// manuellement par l'agent appro au fil des informations reçues du transitaire,
// pas un flux GPS/EDI automatique.
// ============================================================

model Importation {
  id            Int         @id @default(autoincrement())
  bonCommandeId Int         @unique
  bonCommande   BonCommande @relation(fields: [bonCommandeId], references: [id])

  paysOrigine     String?
  portDepart      String?
  portArrivee     String?
  numeroConteneur String?
  incoterm        String? // EXW, FOB, CIF, DDP… (texte libre — trop de variantes pour un enum strict)

  // Transitaire — peut être un Fournisseur déjà enregistré (type TRANSPORTEUR) ou une saisie libre
  transitaireId  Int?
  transitaire    Fournisseur? @relation("ImportationTransitaire", fields: [transitaireId], references: [id])
  transitaireNom String?

  referenceDouane  String?
  dateDedouanement DateTime?
  assurancePolice  String?
  assuranceMontant Decimal?

  dateETD           DateTime? // date de départ estimée
  dateETA           DateTime? // date d'arrivée estimée
  dateArriveeReelle DateTime?

  notes String?

  evenements EvenementImportation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Checkpoint de suivi (CDC §9 "suivi temps réel") — saisie manuelle datée.
model EvenementImportation {
  id            Int         @id @default(autoincrement())
  importationId Int
  importation   Importation @relation(fields: [importationId], references: [id], onDelete: Cascade)

  date        DateTime           @default(now())
  statut      StatutLivraisonPO? // réutilise l'échelle du PO si le checkpoint correspond à une étape
  lieu        String?
  commentaire String?

  creeParId Int
  creePar   User @relation("EvenementImportationCreateur", fields: [creeParId], references: [id])

  createdAt DateTime @default(now())

  @@index([importationId])
}

// ============================================================
// TRANSFERTS DE STOCK (entre PDV et/ou dépôts)
// ============================================================

model TransfertStock {
  id        Int                  @id @default(autoincrement())
  reference String               @unique
  statut    StatutTransfertStock @default(EN_COURS)

  origineId     Int? // nullable tant que statut = DEMANDE (l'agence ne choisit pas la source)
  origine       PointDeVente? @relation("TransfertOrigine", fields: [origineId], references: [id])
  destinationId Int
  destination   PointDeVente  @relation("TransfertDestination", fields: [destinationId], references: [id])

  creeParId   Int
  creePar     User  @relation("CreateurTransfert", fields: [creeParId], references: [id])
  valideParId Int?
  validePar   User? @relation("ValidateurTransfert", fields: [valideParId], references: [id])

  // Validation de la DEMANDE (CDC §13, avant préparation) — distincte de
  // valideParId/dateReception qui concernent la confirmation de réception.
  approuveParId   Int?
  approuvePar     User?     @relation("ApprobateurTransfert", fields: [approuveParId], references: [id])
  dateApprobation DateTime?

  dateExpedition DateTime?
  dateReception  DateTime?
  notes          String?

  // Comptabilisation (CDC §56) — écriture générée à la réception confirmée,
  // renseignée pour empêcher une double comptabilisation
  // (lib/comptabilite/ecrituresTransfert.ts). Même compte stock des deux
  // côtés (aucun impact P&L) — seule la dimension analytique par PDV bouge.
  ecritureId Int?

  lignes LigneTransfertStock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut])
  @@index([origineId])
  @@index([destinationId])
}

model LigneTransfertStock {
  id          Int      @id @default(autoincrement())
  transfertId Int
  produitId   Int
  quantite    Int
  prixUnit    Decimal?

  transfert TransfertStock @relation(fields: [transfertId], references: [id], onDelete: Cascade)
  produit   Produit        @relation(fields: [produitId], references: [id])
}

// ============================================================
// INVENTAIRES (PDV et dépôts)
// ============================================================

model InventaireSite {
  id             Int              @id @default(autoincrement())
  reference      String           @unique
  statut         StatutInventaire @default(EN_COURS)
  pointDeVenteId Int
  dateInventaire DateTime         @default(now())
  notes          String?

  // Comptabilisation de l'écart d'inventaire (lib/comptabilite/ecrituresInventaire.ts) —
  // renseigné une fois l'écriture générée, pour empêcher une double comptabilisation.
  ecritureRegularisationId Int?

  realiseParId Int
  realisePar   User  @relation("RealisateurInventaire", fields: [realiseParId], references: [id])
  valideParId  Int?
  validePar    User? @relation("ValidateurInventaire", fields: [valideParId], references: [id])

  pointDeVente PointDeVente          @relation(fields: [pointDeVenteId], references: [id])
  lignes       LigneInventaireSite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut])
  @@index([pointDeVenteId])
}

model LigneInventaireSite {
  id                Int @id @default(autoincrement())
  inventaireId      Int
  produitId         Int
  quantiteSysteme   Int // quantité selon le système
  quantiteConstatee Int // quantité réelle comptée
  ecart             Int // = constatée - système

  inventaire InventaireSite @relation(fields: [inventaireId], references: [id], onDelete: Cascade)
  produit    Produit        @relation(fields: [produitId], references: [id])
}

// ============================================================
// COMMANDES INTERNES (réapprovisionnement demandé par un PDV/dépôt)
// ============================================================

model CommandeInterne {
  id             Int                   @id @default(autoincrement())
  reference      String                @unique
  statut         StatutCommandeInterne @default(BROUILLON)
  demandeurId    Int
  demandeur      User                  @relation("DemandeurCommande", fields: [demandeurId], references: [id])
  pointDeVenteId Int
  pointDeVente   PointDeVente          @relation(fields: [pointDeVenteId], references: [id])
  notes          String?

  lignes LigneCommandeInterne[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut])
  @@index([pointDeVenteId])
}

model LigneCommandeInterne {
  id               Int  @id @default(autoincrement())
  commandeId       Int
  produitId        Int
  quantiteDemandee Int
  quantiteValidee  Int?

  commande CommandeInterne @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  produit  Produit         @relation(fields: [produitId], references: [id])
}

// ============================================================
// BONS DE SORTIE EXCEPTIONNELS (pertes, casses, dons, conso interne)
// Pour les sorties groupant plusieurs produits — document formel imprimable
// ============================================================

enum StatutBonSortie {
  BROUILLON
  VALIDE
  ANNULE
}

model BonSortie {
  id             Int             @id @default(autoincrement())
  reference      String          @unique
  typeSortie     TypeSortieStock // PERTE, CASSE, DON, CONSOMMATION_INTERNE, LIVRAISON_CLIENT
  statut         StatutBonSortie @default(BROUILLON)
  pointDeVenteId Int
  motif          String
  notes          String?
  creeParId      Int
  valideParId    Int?

  // Comptabilisation (CDC §56) — écriture générée à la validation, renseignée
  // pour empêcher une double comptabilisation (lib/comptabilite/ecrituresBonSortie.ts).
  ecritureId Int?

  pointDeVente PointDeVente     @relation(fields: [pointDeVenteId], references: [id])
  creePar      User             @relation("BonsSortieCreePar", fields: [creeParId], references: [id])
  validePar    User?            @relation("BonsSortieValidePar", fields: [valideParId], references: [id])
  lignes       LigneBonSortie[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut])
  @@index([pointDeVenteId])
  @@index([typeSortie])
}

model LigneBonSortie {
  id          Int      @id @default(autoincrement())
  bonSortieId Int
  produitId   Int
  quantite    Int
  prixUnit    Decimal?

  bonSortie BonSortie @relation(fields: [bonSortieId], references: [id], onDelete: Cascade)
  produit   Produit   @relation(fields: [produitId], references: [id])
}

// ============================================================
// ANOMALIES STOCK
// ============================================================

model AnomalieStock {
  id             Int            @id @default(autoincrement())
  reference      String         @unique
  produitId      Int
  pointDeVenteId Int?
  type           TypeAnomalie
  quantite       Int
  description    String
  statut         StatutAnomalie @default(EN_ATTENTE)
  signalePar     Int
  traitePar      Int?
  commentaire    String?

  produit      Produit       @relation(fields: [produitId], references: [id])
  pointDeVente PointDeVente? @relation(fields: [pointDeVenteId], references: [id])
  magasinier   User          @relation("AnomaliesSignalees", fields: [signalePar], references: [id])
  traiteur     User?         @relation("AnomaliesTraitees", fields: [traitePar], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([produitId])
  @@index([statut])
}

// Demande d'ajustement de stock — doit être approuvée par un admin avant application
model DemandeAjustementStock {
  id               Int                     @id @default(autoincrement())
  produitId        Int
  pointDeVenteId   Int
  ancienneQuantite Int
  nouvelleQuantite Int
  justification    String
  statut           StatutDemandeAjustement @default(EN_ATTENTE)
  source           String                  @default("ADMIN") // "ADMIN" | "MAGAZINIER"

  demandeurId           Int
  validateurId          Int?
  commentaireValidation String?

  // Comptabilisation (CDC §56) — écriture générée à l'approbation, renseignée
  // pour empêcher une double comptabilisation (lib/comptabilite/ecrituresAjustement.ts).
  ecritureId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  produit      Produit      @relation(fields: [produitId], references: [id])
  pointDeVente PointDeVente @relation(fields: [pointDeVenteId], references: [id])
  demandeur    User         @relation("DemandesAjustement", fields: [demandeurId], references: [id])
  validateur   User?        @relation("ValidationsAjustement", fields: [validateurId], references: [id])

  @@index([statut])
  @@index([produitId])
  @@index([pointDeVenteId])
}

// ============================================================
// CAISSE — Grande caisse (Caissier) + Petite caisse RPV
// ============================================================

model SessionCaisse {
  id             Int                 @id @default(autoincrement())
  caissierNom    String
  caissierId     Int // FK déclarée ci-dessous
  pointDeVenteId Int?
  fondsCaisse    Decimal             @default(0)
  statut         StatutSessionCaisse @default(OUVERTE)
  dateOuverture  DateTime            @default(now())
  dateFermeture  DateTime?
  notes          String?

  pointDeVente    PointDeVente?     @relation(fields: [pointDeVenteId], references: [id])
  caissier        User              @relation("SessionsCaisseCaissier", fields: [caissierId], references: [id])
  operations      OperationCaisse[]
  transferts      TransfertCaisse[]
  transfertsRecus TransfertCaisse[] @relation("TransfertsCaisseDestination")
  clotures        ClotureCaisse[]
  caissesPDV      CaissePDV[]
  ventesDirectes  VenteDirecte[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Petite caisse RPV — liée automatiquement à la grande caisse du caissier
model CaissePDV {
  id              Int                 @id @default(autoincrement())
  nom             String
  rpvId           Int // FK déclarée ci-dessous
  pointDeVenteId  Int
  sessionCaisseId Int? // grande caisse associée
  fondsCaisse     Decimal             @default(0)
  statut          StatutSessionCaisse @default(OUVERTE)
  dateOuverture   DateTime            @default(now())
  dateFermeture   DateTime?
  notes           String?

  pointDeVente   PointDeVente         @relation(fields: [pointDeVenteId], references: [id])
  rpv            User                 @relation("CaissesPDVRPV", fields: [rpvId], references: [id])
  sessionCaisse  SessionCaisse?       @relation(fields: [sessionCaisseId], references: [id])
  operations     OperationCaissePDV[]
  ventesDirectes VenteDirecte[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OperationCaissePDV {
  id           Int                    @id @default(autoincrement())
  caissePDVId  Int
  type         TypeOperationCaisse
  mode         ModePaiement?
  categorie    CategorieDecaissement?
  montant      Decimal
  motif        String
  reference    String                 @unique
  operateurNom String
  operateurId  Int
  createdAt    DateTime               @default(now())

  caissePDV CaissePDV @relation(fields: [caissePDVId], references: [id])
  operateur User      @relation("OperationsCaissePDV", fields: [operateurId], references: [id])
}

model OperationCaisse {
  id           Int                    @id @default(autoincrement())
  sessionId    Int
  type         TypeOperationCaisse
  mode         ModePaiement?
  categorie    CategorieDecaissement?
  montant      Decimal
  motif        String
  reference    String                 @unique
  pieceJointe  String?
  operateurNom String
  operateurId  Int
  createdAt    DateTime               @default(now())

  session   SessionCaisse @relation(fields: [sessionId], references: [id])
  operateur User          @relation("OperationsCaisse", fields: [operateurId], references: [id])
}

model TransfertCaisse {
  id           Int      @id @default(autoincrement())
  sessionId    Int
  origine      String
  destination  String
  montant      Decimal
  motif        String?
  reference    String   @unique
  operateurNom String
  operateurId  Int
  createdAt    DateTime @default(now())

  // CDC §20 — transfert symétrique : quand `destination` correspond à une
  // SessionCaisse active identifiable, son solde théorique est crédité en
  // clôture (app/api/caissier/cloture/route.ts). null = destination purement
  // descriptive (comportement historique préservé, ex. "Banque Ecobank").
  destinationSessionId Int?
  destinationSession   SessionCaisse? @relation("TransfertsCaisseDestination", fields: [destinationSessionId], references: [id])

  session   SessionCaisse @relation(fields: [sessionId], references: [id])
  operateur User          @relation("TransfertsCaisse", fields: [operateurId], references: [id])
}

model ClotureCaisse {
  id                       Int      @id @default(autoincrement())
  date                     DateTime
  caissierNom              String
  pointDeVenteId           Int?
  totalVentes              Int
  montantTotal             Decimal
  panierMoyen              Decimal
  nbClients                Int
  notes                    String?
  sessionId                Int?
  fondsCaisse              Decimal  @default(0)
  totalEncaissementsAutres Decimal  @default(0)
  totalDecaissements       Decimal  @default(0)
  totalTransferts          Decimal  @default(0)
  soldeTheorique           Decimal  @default(0)
  soldeReel                Decimal?
  ecart                    Decimal?

  pointDeVente PointDeVente?  @relation(fields: [pointDeVenteId], references: [id])
  session      SessionCaisse? @relation(fields: [sessionId], references: [id])

  createdAt DateTime @default(now())

  // Une seule clôture par PDV par session (pas par date brute)
  @@unique([sessionId, pointDeVenteId])
}

// ============================================================
// VENTES DIRECTES (hors packs)
// ============================================================

model VenteDirecte {
  id        Int                @id @default(autoincrement())
  reference String             @unique
  statut    StatutVenteDirecte @default(BROUILLON)

  pointDeVenteId       Int
  vendeurId            Int // User (RPV, agent terrain, magasinier, admin, etc.)
  modePaiement         ModePaiementVente
  montantTotal         Decimal
  montantPaye          Decimal
  monnaieRendue        Decimal           @default(0)
  montantCompteCourant Decimal           @default(0) // part réglée depuis le compte courant client (CDC §3)
  notes                String?

  // Client enregistré ou walk-in
  clientId        Int?
  clientNom       String? // pour les clients non enregistrés
  clientTelephone String?

  // Lien crédit (optionnel — renseigné si modePaiement = CREDIT)
  creditClientId Int?
  creditClient   CreditClient? @relation(fields: [creditClientId], references: [id])

  // Caisse associée (petite ou grande)
  caissePDVId     Int? // petite caisse RPV
  sessionCaisseId Int? // grande caisse caissier

  // Attribution marketing (Phase 1, CDC §56-57) — tag optionnel à la saisie
  // pour rattacher cette vente au CA d'une campagne.
  campagneId Int?
  campagne   Campagne? @relation("VenteCampagne", fields: [campagneId], references: [id])

  // Coupon marketing (Phase 5, CDC §35) — remise panier appliquée à la vente.
  couponId           Int?
  coupon             Coupon?             @relation(fields: [couponId], references: [id])
  couponUtilisations CouponUtilisation[]

  pointDeVente  PointDeVente        @relation(fields: [pointDeVenteId], references: [id])
  vendeur       User                @relation("VendeurVente", fields: [vendeurId], references: [id])
  client        Client?             @relation(fields: [clientId], references: [id])
  caissePDV     CaissePDV?          @relation(fields: [caissePDVId], references: [id])
  sessionCaisse SessionCaisse?      @relation(fields: [sessionCaisseId], references: [id])
  lignes        LigneVenteDirecte[]
  factureVente  FactureVente?       @relation("VenteDirecteFacture")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut])
  @@index([pointDeVenteId])
  @@index([vendeurId])
  @@index([creditClientId])
  @@index([campagneId])
}

model LigneVenteDirecte {
  id           Int     @id @default(autoincrement())
  venteId      Int
  produitId    Int? // nullable si produit hors catalogue
  produitNom   String? // nom libre saisi par l'agent si hors catalogue
  quantite     Int
  prixUnitaire Decimal
  montant      Decimal

  vente   VenteDirecte @relation(fields: [venteId], references: [id], onDelete: Cascade)
  produit Produit?     @relation(fields: [produitId], references: [id])
}

// ============================================================
// CONTRÔLE TERRAIN
// ============================================================

model VisiteControle {
  id             Int                  @id @default(autoincrement())
  reference      String               @unique
  statut         StatutVisiteControle @default(PLANIFIEE)
  controleurId   Int
  pointDeVenteId Int? // PDV visité (null = visite multi-sites)
  datePlanifiee  DateTime
  dateRealise    DateTime?
  objectif       String
  notes          String?

  controleur   User              @relation("ControleurVisite", fields: [controleurId], references: [id])
  pointDeVente PointDeVente?     @relation(fields: [pointDeVenteId], references: [id])
  rapports     RapportControle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut])
  @@index([controleurId])
}

model RapportControle {
  id              Int     @id @default(autoincrement())
  visiteId        Int
  titre           String
  contenu         String
  recommandations String?
  // Destinataires séparés par virgule: "ADMIN,CHEF_AGENCE"
  destinataires   String?

  visite  VisiteControle  @relation(fields: [visiteId], references: [id], onDelete: Cascade)
  alertes AlerteRapport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AlerteRapport {
  id        Int                  @id @default(autoincrement())
  rapportId Int
  niveau    NiveauAlerteControle
  message   String

  rapport   RapportControle @relation(fields: [rapportId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())
}

// ============================================================
// WALLET & TRANSACTIONS
// ============================================================

model Wallet {
  id           Int     @id @default(autoincrement())
  memberId     Int     @unique
  soldeGeneral Decimal @default(0.0)
  soldeTontine Decimal @default(0.0)
  soldeCredit  Decimal @default(0.0)

  member       User                @relation(fields: [memberId], references: [id])
  transactions WalletTransaction[]
  paiements    Paiement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WalletTransaction {
  id          Int             @id @default(autoincrement())
  walletId    Int
  type        TransactionType
  montant     Decimal
  description String?
  reference   String          @unique

  wallet Wallet @relation(fields: [walletId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// FACTURES & PAIEMENTS
// ============================================================

model Facture {
  id        Int           @id @default(autoincrement())
  reference String        @unique
  memberId  Int
  montant   Decimal
  type      TypeFacture
  statut    StatutFacture

  member    User       @relation(fields: [memberId], references: [id])
  paiements Paiement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Paiement {
  id        Int          @id @default(autoincrement())
  factureId Int
  walletId  Int
  montant   Decimal
  type      TypePaiement
  reference String       @unique
  createdAt DateTime     @default(now())

  facture Facture @relation(fields: [factureId], references: [id])
  wallet  Wallet  @relation(fields: [walletId], references: [id])
}

// ============================================================
// PACKS AfriSime
// ============================================================

model Pack {
  id                 Int                @id @default(autoincrement())
  nom                String
  type               TypePack
  description        String?
  actif              Boolean            @default(true)
  dureeJours         Int?
  frequenceVersement FrequenceVersement @default(HEBDOMADAIRE)
  montantVersement   Decimal?
  formuleRevendeur   FormuleRevendeur?
  montantCredit      Decimal?
  montantSeuil       Decimal?
  produitCibleId     Int?
  produitCible       Produit?           @relation("PackProduitCible", fields: [produitCibleId], references: [id])
  bonusPourcentage   Decimal?
  cyclesBonusTrigger Int?
  acomptePercent     Decimal?
  pointsParTranche   Int?
  montantTranche     Decimal?

  souscriptions      SouscriptionPack[]
  campagnesMarketing CampagneProduit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SouscriptionPack {
  id                 Int                 @id @default(autoincrement())
  packId             Int
  pack               Pack                @relation(fields: [packId], references: [id])
  userId             Int?
  user               User?               @relation(fields: [userId], references: [id])
  clientId           Int?
  client             Client?             @relation(fields: [clientId], references: [id])
  statut             StatutSouscription  @default(EN_ATTENTE)
  formuleRevendeur   FormuleRevendeur?
  frequenceVersement FrequenceVersement?
  dateDebut          DateTime            @default(now())
  dateFin            DateTime?
  dateCloture        DateTime?
  montantTotal       Decimal
  montantVerse       Decimal             @default(0)
  montantRestant     Decimal
  numeroCycle        Int                 @default(1)
  bonusObtenu        Boolean             @default(false)
  notes              String?
  enregistrePar      String?

  // Attribution marketing (CDC §85) — campagne active choisie à la souscription,
  // même mécanique que VenteDirecte.campagneId/CreditClient.campagneId : fixée
  // à la création, jamais réévaluée sur la durée de vie de la souscription.
  campagneId Int?
  campagne   Campagne? @relation("SouscriptionPackCampagne", fields: [campagneId], references: [id])

  versements     VersementPack[]
  echeances      EcheancePack[]
  receptions     ReceptionProduitPack[]
  lignesCollecte LigneCollecte[]
  lignesProduits LigneSouscriptionProduit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campagneId])
}

model VersementPack {
  id             Int                 @id @default(autoincrement())
  souscriptionId Int
  souscription   SouscriptionPack    @relation(fields: [souscriptionId], references: [id])
  type           TypeVersement
  montant        Decimal
  statut         StatutVersementPack @default(PAYE)
  datePrevue     DateTime?
  datePaiement   DateTime            @default(now())
  reference      String?             @unique
  notes          String?
  encaisseParId  Int?
  encaisseParNom String?

  ligneCollecte LigneCollecte? // relation inverse (1 versement ↔ 1 ligne collecte max)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EcheancePack {
  id             Int                 @id @default(autoincrement())
  souscriptionId Int
  souscription   SouscriptionPack    @relation(fields: [souscriptionId], references: [id])
  numero         Int
  montant        Decimal
  datePrevue     DateTime
  datePaiement   DateTime?
  statut         StatutVersementPack @default(EN_ATTENTE)
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([souscriptionId, numero])
}

model ReceptionProduitPack {
  id                 Int                 @id @default(autoincrement())
  souscriptionId     Int
  souscription       SouscriptionPack    @relation(fields: [souscriptionId], references: [id])
  statut             StatutReceptionPack @default(PLANIFIEE)
  datePrevisionnelle DateTime
  dateLivraison      DateTime?
  livreurNom         String?
  notes              String?

  // PDV cible : détermine quel magasinier doit confirmer la sortie stock
  pointDeVenteId Int?
  pointDeVente   PointDeVente? @relation(fields: [pointDeVenteId], references: [id])

  lignes        LigneReceptionPack[]
  facturesVente FactureVente[]       @relation("ReceptionPackFactures")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pointDeVenteId])
}

model LigneReceptionPack {
  id           Int                  @id @default(autoincrement())
  receptionId  Int
  reception    ReceptionProduitPack @relation(fields: [receptionId], references: [id], onDelete: Cascade)
  produitId    Int
  produit      Produit              @relation(fields: [produitId], references: [id])
  quantite     Int
  prixUnitaire Decimal
}

// ============================================================
// LIGNES PRODUITS SOUSCRIPTION
// ============================================================

model LigneSouscriptionProduit {
  id             Int              @id @default(autoincrement())
  souscriptionId Int
  souscription   SouscriptionPack @relation(fields: [souscriptionId], references: [id], onDelete: Cascade)

  // Produit lié (null si nouveau produit non encore créé dans le catalogue)
  produitId Int?
  produit   Produit? @relation("LigneProduitDemande", fields: [produitId], references: [id])

  // Saisie libre — toujours renseignée pour traçabilité
  produitNomSaisi String
  categorieSaisie String?
  uniteSaisie     String?

  quantite         Int
  quantiteParCycle Int? // pour packs récurrents : qté à chaque cycle
  prixEstime       Decimal? // estimation agent terrain

  statut            StatutLigneSouscription @default(EN_ATTENTE)
  estNouveauProduit Boolean                 @default(false)

  // PDV cible — dénormalisé depuis client.pointDeVenteId pour les agrégations logistique
  // (évite une double jointure souscription → client → pdv à chaque requête prévision)
  pointDeVenteId Int?
  pointDeVente   PointDeVente? @relation(fields: [pointDeVenteId], references: [id])

  // Traitement admin
  notes              String?
  produitSubstitutId Int?
  produitSubstitut   Produit?  @relation("LigneProduitSubstitut", fields: [produitSubstitutId], references: [id])
  traiteParId        Int?
  traitePar          User?     @relation("LignesTraitees", fields: [traiteParId], references: [id])
  dateTraitement     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([souscriptionId])
  @@index([statut])
  @@index([pointDeVenteId, statut]) // index composite pour les agrégations prévisions
}

// ============================================================
// FIDÉLITÉ
// ============================================================

model PointsFidelite {
  id           Int  @id @default(autoincrement())
  solde        Int  @default(0)
  totalGagne   Int  @default(0)
  totalUtilise Int  @default(0)
  userId       Int? @unique
  clientId     Int? @unique

  user   User?   @relation(fields: [userId], references: [id])
  client Client? @relation(fields: [clientId], references: [id])

  mouvements   MouvementPoints[]
  utilisations UtilisationRecompense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MouvementPoints {
  id               Int                 @id @default(autoincrement())
  pointsFideliteId Int
  pointsFidelite   PointsFidelite      @relation(fields: [pointsFideliteId], references: [id])
  type             TypeMouvementPoints
  points           Int
  description      String?
  referenceId      Int?
  referenceType    String?

  createdAt DateTime @default(now())
}

model RecompenseFidelite {
  id             Int            @id @default(autoincrement())
  nom            String
  description    String?
  type           TypeRecompense
  coutPoints     Int
  valeur         Decimal?
  produitId      Int?
  produit        Produit?       @relation(fields: [produitId], references: [id])
  actif          Boolean        @default(true)
  dateExpiration DateTime?

  // legacy — branché sur PointsFidelite (grand livre mort, cf. mémoire projet).
  utilisations UtilisationRecompense[]
  // actif — branché sur CompteFidelite (Marketing Phase 5, CDC §36).
  echanges     RecompenseEchange[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Rachat d'une RecompenseFidelite contre des points (Marketing Phase 5, CDC §36).
/// Branché sur CompteFidelite (source de vérité active) — PAS sur PointsFidelite/
/// UtilisationRecompense (legacy, mort). Le catalogue RecompenseFidelite existait
/// déjà mais n'était référencé nulle part dans le code applicatif avant cette phase.
model RecompenseEchange {
  id               Int                @id @default(autoincrement())
  recompenseId     Int
  recompense       RecompenseFidelite @relation(fields: [recompenseId], references: [id])
  compteFideliteId Int
  compteFidelite   CompteFidelite     @relation(fields: [compteFideliteId], references: [id])
  pointsUtilises   Int
  statut           StatutRecompense   @default(DISPONIBLE)
  dateUtilisation  DateTime?
  creeParId        Int
  creePar          User               @relation(fields: [creeParId], references: [id])
  createdAt        DateTime           @default(now())
}

// ============================================================
// MARKETING — Phase 5 : Gamification (CDC §37)
// ============================================================
// Objectif quantifiable minimal (NB_ACHATS ou MONTANT_ACHATS sur une période),
// fidèle à l'exemple unique du CDC ("achetez 5 fois ce mois-ci") — pas de moteur
// de règles générique. Badges = attribution automatique sur condition simple.

enum TypeObjectifChallenge {
  NB_ACHATS
  MONTANT_ACHATS
}

enum StatutChallenge {
  ACTIF
  TERMINE
}

enum StatutParticipationChallenge {
  EN_COURS
  REUSSI
}

model ChallengeMarketing {
  id               Int                   @id @default(autoincrement())
  nom              String
  description      String?
  typeObjectif     TypeObjectifChallenge
  seuil            Int
  recompensePoints Int
  dateDebut        DateTime
  dateFin          DateTime
  statut           StatutChallenge       @default(ACTIF)
  segment          SegmentClient? // ciblage optionnel, réutilise l'enum existant

  participations ParticipationChallenge[]

  creeParId Int
  creePar   User     @relation(fields: [creeParId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Progression d'un client sur un challenge — @@unique protège l'idempotence
/// de l'évaluation cron (un client ne réussit un challenge qu'une fois).
model ParticipationChallenge {
  id           Int                          @id @default(autoincrement())
  challengeId  Int
  challenge    ChallengeMarketing           @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  clientId     Int
  client       Client                       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  progression  Int                          @default(0)
  statut       StatutParticipationChallenge @default(EN_COURS)
  dateReussite DateTime?

  @@unique([challengeId, clientId])
}

model BadgeMarketing {
  id          Int     @id @default(autoincrement())
  nom         String
  description String?
  icone       String? // nom d'icône lucide ou emoji
  condition   Json // {type:"NIVEAU_FIDELITE",niveau:"OR"} | {type:"NB_ACHATS",seuil:N}
  actif       Boolean @default(true)

  attributions BadgeClient[]
  createdAt    DateTime      @default(now())
}

model BadgeClient {
  id              Int            @id @default(autoincrement())
  badgeId         Int
  badge           BadgeMarketing @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  clientId        Int
  client          Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  dateAttribution DateTime       @default(now())

  @@unique([badgeId, clientId])
}

// ============================================================
// MARKETING — Phase 5 : Parrainage (CDC §2, §84)
// ============================================================
// Structure simple confirmée par le CDC lui-même : un parrain (Client), un
// filleul (Client, un seul parrain possible), qualification = premier achat
// du filleul, récompense en points aux deux via attribuerPointsFidelite.

model ParametrageParrainage {
  id            Int      @id @default(1)
  actif         Boolean  @default(true)
  pointsParrain Int      @default(500)
  pointsFilleul Int      @default(200)
  updatedAt     DateTime @updatedAt
}

enum StatutParrainage {
  EN_ATTENTE
  QUALIFIE
  RECOMPENSE
}

model Parrainage {
  id                Int              @id @default(autoincrement())
  parrainId         Int
  parrain           Client           @relation("ParrainageParrain", fields: [parrainId], references: [id])
  filleulId         Int              @unique // un filleul n'a qu'un seul parrain
  filleul           Client           @relation("ParrainageFilleul", fields: [filleulId], references: [id])
  statut            StatutParrainage @default(EN_ATTENTE)
  dateInscription   DateTime         @default(now())
  dateQualification DateTime?
  dateRecompense    DateTime?
}

model UtilisationRecompense {
  id               Int                @id @default(autoincrement())
  recompenseId     Int
  recompense       RecompenseFidelite @relation(fields: [recompenseId], references: [id])
  pointsFideliteId Int
  pointsFidelite   PointsFidelite     @relation(fields: [pointsFideliteId], references: [id])
  pointsUtilises   Int
  statut           StatutRecompense   @default(DISPONIBLE)
  dateUtilisation  DateTime?
  notes            String?

  createdAt DateTime @default(now())
}

// ============================================================
// MESSAGERIE
// ============================================================

model Message {
  id             Int       @id @default(autoincrement())
  expediteurId   Int
  destinataireId Int
  sujet          String
  contenu        String
  lu             Boolean   @default(false)
  dateLecture    DateTime?
  parentId       Int?

  expediteur   User      @relation("MessagesEnvoyes", fields: [expediteurId], references: [id])
  destinataire User      @relation("MessagesRecus", fields: [destinataireId], references: [id])
  parent       Message?  @relation("Reponses", fields: [parentId], references: [id])
  reponses     Message[] @relation("Reponses")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Messagerie instantanée (type WhatsApp) — remplace le modèle Message ci-dessus
/// pour tous les nouveaux échanges. Un seul fil continu par paire d'utilisateurs,
/// ouvert à tous les rôles (admin, gestionnaires, membres simples).
model Conversation {
  id               Int      @id @default(autoincrement())
  /// Toujours le plus petit des deux IDs utilisateur (ordre normalisé pour garantir
  /// l'unicité de la paire, quel que soit qui a démarré la conversation).
  utilisateurAId   Int
  utilisateurBId   Int
  dernierMessageAt DateTime @default(now())
  createdAt        DateTime @default(now())

  utilisateurA User          @relation("ConversationsA", fields: [utilisateurAId], references: [id])
  utilisateurB User          @relation("ConversationsB", fields: [utilisateurBId], references: [id])
  messages     MessageChat[]

  @@unique([utilisateurAId, utilisateurBId])
  @@index([utilisateurAId])
  @@index([utilisateurBId])
}

model MessageChat {
  id                Int       @id @default(autoincrement())
  conversationId    Int
  expediteurId      Int
  contenu           String
  lu                Boolean   @default(false)
  dateLecture       DateTime?
  /// Pièce jointe optionnelle (uploadthing) — un fichier par message, comme WhatsApp.
  pieceJointeUrl    String?
  pieceJointeNom    String?
  pieceJointeType   String?
  pieceJointeTaille Int?
  /// Édition par l'expéditeur — `contenu` est remplacé, `modifie` affiche un indicateur "(modifié)" dans le fil.
  modifie           Boolean   @default(false)
  modifieAt         DateTime?
  /// Suppression douce par l'expéditeur (façon WhatsApp) — contenu et pièce jointe effacés,
  /// le message reste dans le fil sous forme de placeholder "Message supprimé".
  supprime          Boolean   @default(false)
  supprimeAt        DateTime?
  createdAt         DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  expediteur   User         @relation("MessagesChatEnvoyes", fields: [expediteurId], references: [id])

  @@index([conversationId])
  @@index([expediteurId])
}

// ============================================================
// PIÈCES JUSTIFICATIVES
// ============================================================

/// Nature du document (CDC Comptabilité §14) — distincte de `type` (type MIME
/// du fichier). Ne conditionne rien dans le moteur, purement classificatoire.
enum NatureDocumentJustificatif {
  FACTURE
  RECU
  BON_COMMANDE
  BON_LIVRAISON
  CONTRAT
  RELEVE_BANCAIRE
  PIECE_CAISSE
  DOCUMENT_FISCAL
  AUTRE
}

model PieceJustificative {
  id              Int                        @id @default(autoincrement())
  nom             String
  url             String
  uploadthingKey  String
  type            String
  taille          Int
  nature          NatureDocumentJustificatif @default(AUTRE)
  // Association polymorphique
  sourceType      String // VERSEMENT_PACK | OPERATION_CAISSE | MOUVEMENT_STOCK | CLOTURE_COMPTABLE | RECEPTION_APPRO | TRANSFERT_STOCK | ECRITURE_COMPTABLE | IMMOBILISATION
  sourceId        Int
  description     String?
  uploadePar      Int
  uploadeUser     User                       @relation(fields: [uploadePar], references: [id])
  archiverJusquau DateTime
  createdAt       DateTime                   @default(now())

  propositionOCR PropositionImputationOCR?

  @@index([sourceType, sourceId])
}

enum StatutPropositionOCR {
  ANALYSE // extraction faite, en attente de relecture par le comptable
  VALIDEE // comptable a créé l'écriture (BROUILLON) à partir de la proposition
  REJETEE // comptable a rejeté la proposition, saisie manuelle classique
}

/// Proposition d'imputation générée par reconnaissance heuristique de facture
/// fournisseur PDF (CDC IA/Automatisation §51). L'extraction ne crée JAMAIS
/// d'écriture comptable seule — elle propose, le comptable relit/corrige et
/// valide explicitement (lib/comptabilite/moteur.ts::creerEcriture reste
/// toujours appelé avec statut "BROUILLON").
model PropositionImputationOCR {
  id                   Int                @id @default(autoincrement())
  pieceJustificativeId Int                @unique
  pieceJustificative   PieceJustificative @relation(fields: [pieceJustificativeId], references: [id], onDelete: Cascade)

  // Champs extraits (heuristique — jamais garantis, toujours relus par un humain)
  fournisseurDetecte          String?
  fournisseurIdMatche         Int?
  fournisseur                 Fournisseur?       @relation(fields: [fournisseurIdMatche], references: [id])
  dateDetectee                String? // ISO YYYY-MM-DD si parsable
  numeroDetecte               String?
  montantHT                   Decimal?
  montantTVA                  Decimal?
  montantTTC                  Decimal?
  lignesJson                  Json?
  compteDebitProbable         String?
  compteCreditProbable        String?
  compteTvaProbable           String?
  journalProbable             String?
  sectionAnalytiqueProbableId Int?
  sectionAnalytiqueProbable   SectionAnalytique? @relation(fields: [sectionAnalytiqueProbableId], references: [id])

  statut          StatutPropositionOCR @default(ANALYSE)
  ecritureCreeeId Int?

  analyseParId Int
  analysePar   User  @relation("PropositionOCRAnalysePar", fields: [analyseParId], references: [id])
  valideParId  Int?
  validePar    User? @relation("PropositionOCRValidePar", fields: [valideParId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut])
}

// ============================================================
// AUDIT & NOTIFICATIONS
// ============================================================

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  entite    String
  entiteId  Int?
  details   Json? // snapshot avant/après ou données contextuelles
  ip        String? // adresse IP de l'auteur
  userAgent String? // navigateur / appareil
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entite, entiteId])
  @@index([createdAt])
}

/// Sauvegarde applicative (CDC Comptabilité §69) : trace chaque exécution du
/// cron de sauvegarde (export JSON des tables comptables critiques, uploadé
/// sur UploadThing — stockage externe distinct de Neon). Rend l'écran
/// SuperAdmin "Politique de sauvegarde" vérifiable plutôt que décoratif.
model BackupLog {
  id            Int      @id @default(autoincrement())
  dateExecution DateTime @default(now())
  statut        String // SUCCES | ECHEC
  tailleOctets  Int?
  url           String? // fichier UploadThing si succès
  erreur        String?
  dureeMs       Int?

  @@index([dateExecution])
}

model Notification {
  id          Int                  @id @default(autoincrement())
  uuid        String               @unique @default(uuid())
  userId      Int
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  titre       String
  message     String
  priorite    PrioriteNotification @default(NORMAL)
  lue         Boolean              @default(false)
  dateLecture DateTime?
  actionUrl   String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([userId, lue])
  @@index([userId, createdAt])
}

model Parametre {
  cle    String @id
  valeur String
}

/// Préférences de notification RH par utilisateur
/// (canaux activés + déclencheurs souhaités)
model PreferenceNotificationRH {
  id     Int @id @default(autoincrement())
  userId Int @unique

  // ── Canaux ──────────────────────────────────────────────────
  canalApp   Boolean @default(true) // notification in-app (toujours activé)
  canalEmail Boolean @default(false) // envoi email

  // ── Déclencheurs ────────────────────────────────────────────
  finContrat       Boolean @default(true) // CDD expirant J-30 et J-7
  validationConge  Boolean @default(true) // congé approuvé / refusé
  evaluationProg   Boolean @default(true) // évaluation programmée (J-7)
  formationAsuivre Boolean @default(true) // formation inscrite qui démarre (J-3)
  documentExpirant Boolean @default(true) // document collaborateur expirant (J-30)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ============================================================
// COMPTABILITÉ SYSCOHADA
// ============================================================

model ClotureComptable {
  id          Int      @id @default(autoincrement())
  annee       Int
  mois        Int
  notes       String?
  cloturePar  Int
  clotureUser User     @relation(fields: [cloturePar], references: [id])
  createdAt   DateTime @default(now())

  @@unique([annee, mois])
}

model CompteComptable {
  id             Int               @id @default(autoincrement())
  numero         String            @unique
  libelle        String
  classe         Int
  type           TypeCompte
  nature         NatureCompte      @default(DETAIL)
  sens           SensCompte        @default(DEBITEUR)
  actif          Boolean           @default(true)
  statut         StatutCompte      @default(ACTIF)
  compteParentId Int?
  compteParent   CompteComptable?  @relation("HierarchieComptes", fields: [compteParentId], references: [id])
  sousComptes    CompteComptable[] @relation("HierarchieComptes")
  tiersType      String?
  tiersNom       String?

  // Champs CDC Comptabilité §5 (fiche compte complète) — tous additifs, tous
  // nullable/à défaut sûr pour ne rien casser sur les comptes déjà livrés.
  categorie             String? // classification libre (sous-catégorie SYSCOHADA), distincte de classe/type
  estCompteCollectif    Boolean      @default(false) // compte de contrôle (ex: 401/411) par opposition à un compte de détail/auxiliaire
  estCompteBilan        Boolean      @default(false) // dérivé du type à la création (ACTIF/PASSIF/TRESORERIE) mais éditable
  estCompteResultat     Boolean      @default(false) // dérivé du type à la création (CHARGES/PRODUITS) mais éditable
  autoriseLettrage      Boolean      @default(false)
  autoriseRapprochement Boolean      @default(false)
  natureActif           NatureActif? // circulant/immobilisé — pertinent seulement si type == ACTIF

  compteTvaAssocieId    Int?
  compteTvaAssocie      CompteComptable?  @relation("CompteTvaAssocie", fields: [compteTvaAssocieId], references: [id])
  comptesUtilisantCeTva CompteComptable[] @relation("CompteTvaAssocie")

  compteImmobilisationAssocieId Int?
  compteImmobilisationAssocie   CompteComptable?  @relation("CompteImmoAssocie", fields: [compteImmobilisationAssocieId], references: [id])
  comptesUtilisantCetteImmo     CompteComptable[] @relation("CompteImmoAssocie")

  sectionAnalytiqueDefautId Int?
  sectionAnalytiqueDefaut   SectionAnalytique? @relation(fields: [sectionAnalytiqueDefautId], references: [id])

  // Utilisateur créateur (CDC §5) — absent des comptes importés en masse (plan
  // SYSCOHADA de base), renseigné pour toute création individuelle via l'API.
  creeParId Int?
  creePar   User? @relation("CompteComptableCreateur", fields: [creeParId], references: [id])

  // CDC §50 — multi-société (version légère, voir commentaire du modèle Societe) :
  // `null` = compte du plan partagé/société principale. Ne change PAS l'unicité
  // de `numero` (toujours globale) — sert uniquement à filtrer/reporter.
  societeId Int?
  societe   Societe? @relation(fields: [societeId], references: [id])

  // Compte auxiliaire réel (CDC Comptabilité §16-17) : sous-compte 411xxx/401xxx
  // rattaché à un client ou fournisseur précis par FK (et non plus seulement par
  // texte libre tiersNom). Auto-provisionné par lib/comptabilite/auxiliaire.ts.
  clientId      Int?         @unique
  client        Client?      @relation(fields: [clientId], references: [id])
  fournisseurId Int?         @unique
  fournisseur   Fournisseur? @relation(fields: [fournisseurId], references: [id])

  lignesEcriture                LigneEcriture[]
  lignesBudget                  LigneBudget[]
  immobilisationsActif          Immobilisation[]        @relation("ImmobilisationCompte")
  immobilisationsAmortissement  Immobilisation[]        @relation("ImmobilisationCompteAmortissement")
  provisionsCompteProvision     ProvisionDepreciation[] @relation("ProvisionCompteProvision")
  provisionsCompteDotation      ProvisionDepreciation[] @relation("ProvisionCompteDotation")
  provisionsCompteReprise       ProvisionDepreciation[] @relation("ProvisionCompteReprise")
  regularisationsOrigine        RegularisationAvance[]  @relation("RegulCompteOrigine")
  regularisationsRegul          RegularisationAvance[]  @relation("RegulCompteRegul")
  chargesProduitsAttenteOrigine ChargeProduitAttente[]  @relation("AttenteCompteChargeOuProduit")
  chargesProduitsAttenteCompte  ChargeProduitAttente[]  @relation("AttenteCompteAttente")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classe])
  @@index([type])
  @@index([nature])
  @@index([societeId])
}

model EcritureComptable {
  id        Int             @id @default(autoincrement())
  reference String          @unique
  date      DateTime
  libelle   String
  journal   String // code d'un journal builtin (CAISSE/BANQUE/VENTES/ACHATS/OD/PAIE) ou JournalComptable.code (CDC §9)
  statut    StatutEcriture  @default(BROUILLON)
  notes     String?
  userId    Int?
  user      User?           @relation(fields: [userId], references: [id])
  lignes    LigneEcriture[]

  // CDC §10 — "Date de validation" distincte de "Date de saisie" (createdAt) :
  // stampée par le PUT lorsque le statut transite vers VALIDE, jamais modifiée
  // ensuite (une écriture VALIDE ne se modifie plus directement, CDC §13).
  dateValidation DateTime?
  valideParId    Int?
  validePar      User?     @relation("EcritureValidateur", fields: [valideParId], references: [id])

  // Séparation des fonctions (CDC §44) : étape intermédiaire optionnelle
  // "contrôle" (Agent → Comptable → Chef comptable) — un utilisateur distinct
  // du créateur passe l'écriture en A_CONTROLER ; la validation finale (VALIDE)
  // doit alors venir d'un 3e utilisateur, distinct du créateur ET du
  // contrôleur (lib/api : app/api/comptable/ecritures/[id]/route.ts). La
  // transition directe BROUILLON→VALIDE (2 acteurs) reste possible pour ne
  // pas casser le flux existant plus léger.
  dateControle  DateTime?
  controleParId Int?
  controlePar   User?     @relation("EcritureControleur", fields: [controleParId], references: [id])

  // Multi-société (CDC §50) : null = société principale (résolu par le moteur).
  societeId Int?
  societe   Societe? @relation(fields: [societeId], references: [id])

  // Multi-devise (CDC §49) : montants des lignes toujours exprimés en devise
  // fonctionnelle ; devise/tauxChange ne font ici que tracer la devise de la
  // transaction d'origine (pas de conversion automatique ni de calcul d'écart
  // de change — hors scope de cette étape, voir Devise).
  devise     String  @default("XOF")
  tauxChange Decimal @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([journal])
  @@index([statut])
  @@index([date])
  @@index([societeId])
}

model LigneEcriture {
  id         Int               @id @default(autoincrement())
  ecritureId Int
  ecriture   EcritureComptable @relation(fields: [ecritureId], references: [id], onDelete: Cascade)
  compteId   Int
  compte     CompteComptable   @relation(fields: [compteId], references: [id])
  libelle    String
  debit      Decimal           @default(0)
  credit     Decimal           @default(0)
  isTva      Boolean           @default(false)
  tauxTva    Decimal?
  montantTva Decimal?

  // Lettrage (CDC Comptabilité §18) : code partagé par un groupe de lignes du
  // même compte. Groupe équilibré (débit=crédit) = lettrage classique intégral.
  // Groupe déséquilibré = lettrage PARTIEL (ex. facture 500k / paiement 300k) :
  // `montantLettre` porte alors la part de CETTE ligne effectivement soldée
  // (≤ son montant) ; le reliquat (montant - montantLettre) reste "en instance"
  // (cf. lignesNonLettrees dans lib/comptabilite/lettrage.ts). null = non lettrée.
  lettrage      String?
  montantLettre Decimal @default(0)

  // Imputation analytique (CDC §24, 5 axes) : Activité/Projet/Département via
  // SectionAnalytique, Point de vente et Produit réutilisent les modèles
  // existants. Tous optionnels — une ligne peut n'avoir aucune, une ou plusieurs
  // imputations selon ce que l'appelant connaît au moment de l'écriture.
  sectionAnalytiqueId Int?
  sectionAnalytique   SectionAnalytique? @relation(fields: [sectionAnalytiqueId], references: [id])
  pointDeVenteId      Int?
  pointDeVente        PointDeVente?      @relation(fields: [pointDeVenteId], references: [id])
  produitId           Int?
  produit             Produit?           @relation(fields: [produitId], references: [id])

  @@index([ecritureId])
  @@index([compteId])
  @@index([lettrage])
  @@index([sectionAnalytiqueId])
  @@index([pointDeVenteId])
  @@index([produitId])
}

model JournalValidation {
  id          Int      @id @default(autoincrement())
  entryId     String   @unique
  notes       String?
  valideParId Int
  validePar   User     @relation(fields: [valideParId], references: [id])
  createdAt   DateTime @default(now())

  @@index([entryId])
}

model RapprochementBancaire {
  id                Int                 @id @default(autoincrement())
  periode           String
  soldeBancaireReel Decimal
  soldeComptable    Decimal
  ecart             Decimal
  notes             String?
  statut            StatutRapprochement @default(EN_COURS)
  userId            Int?
  user              User?               @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([periode])
  @@index([statut])
}

enum StatutLigneReleve {
  NON_RAPPROCHE
  RAPPROCHE
  IGNORE
}

/// Ligne de relevé bancaire importée (CSV, CDC §19) — rapprochée ligne à ligne
/// avec une écriture comptable existante du compte de trésorerie concerné.
model LigneReleveBancaire {
  id           Int      @id @default(autoincrement())
  compteNumero String // ex "521" — compte de trésorerie concerné
  date         DateTime
  libelle      String
  reference    String?
  debit        Decimal  @default(0) // sortie de fonds (montant débité du compte bancaire)
  credit       Decimal  @default(0) // entrée de fonds

  statut          StatutLigneReleve @default(NON_RAPPROCHE)
  ligneEcritureId Int? // rapprochée avec cette ligne d'écriture comptable

  importeParId Int
  importePar   User     @relation(fields: [importeParId], references: [id])
  importeLe    DateTime @default(now())

  @@index([compteNumero])
  @@index([statut])
  @@index([date])
}

model DeclarationTVA {
  id            Int       @id @default(autoincrement())
  periode       String
  tvaCollectee  Decimal   @default(0)
  tvaDeductible Decimal   @default(0)
  tvaDue        Decimal   @default(0)
  statut        StatutTVA @default(BROUILLON)
  notes         String?
  userId        Int?
  user          User?     @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([periode])
}

// Moteur de règles comptables paramétrable (CDC Comptabilité §7) : associe un
// événement métier (ex. "VENTE_CREDIT_VALIDEE") aux comptes débit/crédit à
// utiliser, sans jamais coder ces numéros en dur dans la logique métier. Le
// module appelant (crédit, paie, remboursement...) ne connaît que le nom de
// l'événement ; la résolution des comptes passe par lib/comptabilite/moteur.ts.
model RegleComptable {
  id           Int    @id @default(autoincrement())
  evenement    String // ex: "VENTE_CREDIT_VALIDEE", "PAIE_VERSEE", "REMBOURSEMENT_CREDIT_CONFIRME"
  moduleSource String // ex: "CREDIT", "PAIE", "TRESORERIE" — informatif, pour l'écran de paramétrage

  // Conditions optionnelles (égalité simple) — la règle la plus précise et
  // prioritaire l'emporte ; laissée vide = s'applique à tout evenement.
  conditionProduit      String?
  conditionFamille      String?
  conditionCategorie    String? // CategorieProduit.nom (ou Produit.categorie legacy) — CDC §6, mapping automatique par catégorie
  conditionModePaiement String?
  conditionTypeClient   String? // CDC §54 — Client.typeClient (COMPTANT|CREDIT)
  conditionPointDeVente Int? // CDC §54/§55 — PointDeVente.id précis
  conditionTypeSortie   String? // CDC §56 — TypeSortieStock (PERTE, CASSE, DON, VOL, CONSOMMATION_INTERNE…)

  compteDebitNumero  String
  compteCreditNumero String
  journal            String // builtin ou JournalComptable.code (CDC §9)

  // Champs CDC Comptabilité §7 (fiche règle complète) — tous additifs/nullables,
  // sans effet sur les règles déjà paramétrées tant qu'ils ne sont pas renseignés.
  compteTvaNumero     String? // "taxe" — ex: 4431 TVA collectée, appliquée si la ligne le permet
  sectionAnalytiqueId Int? // "analytique" — n'importe quel axe (Activité/Projet/Département/Centre de coût)
  sectionAnalytique   SectionAnalytique? @relation("RegleAnalytique", fields: [sectionAnalytiqueId], references: [id])
  centreCoutId        Int? // "centre de coût" — restreint en pratique à une SectionAnalytique d'axe CENTRE_COUT
  centreCout          SectionAnalytique? @relation("RegleCentreCout", fields: [centreCoutId], references: [id])
  devise              String? // null = devise fonctionnelle (XOF) — CDC §49
  dateDebutValidite   DateTime?
  dateFinValidite     DateTime?

  priorite Int                @default(0)
  actif    Boolean            @default(true)
  mode     ModeRegleComptable @default(AUTOMATIQUE)
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([evenement])
  @@index([actif])
}

// ============================================================
// IMMOBILISATIONS & AMORTISSEMENTS (CDC Comptabilité §22)
// ============================================================

enum CategorieImmobilisation {
  TERRAIN
  BATIMENT
  MATERIEL_MOBILIER
  MATERIEL_TRANSPORT
  MATERIEL_INFORMATIQUE
  AUTRE
}

enum StatutImmobilisation {
  EN_SERVICE
  AMORTIE
  CEDEE
  HORS_SERVICE
}

// Seule la méthode LINEAIRE est calculée automatiquement pour le moment
// (lib/comptabilite/immobilisations.ts) ; DEGRESSIF est un champ de
// paramétrage réservé à une évolution future, sans moteur de calcul dédié.
enum MethodeAmortissement {
  LINEAIRE
  DEGRESSIF
}

/// Registre des immobilisations (CDC §22) — chaque acquisition génère son
/// écriture comptable (Dr compte d'immobilisation / Cr fournisseur ou trésorerie),
/// et l'amortissement mensuel est calculé automatiquement (lib/comptabilite/immobilisations.ts).
model Immobilisation {
  id               Int                     @id @default(autoincrement())
  numeroInventaire String                  @unique
  designation      String
  categorie        CategorieImmobilisation

  compteId              Int
  compte                CompteComptable @relation("ImmobilisationCompte", fields: [compteId], references: [id])
  compteAmortissementId Int
  compteAmortissement   CompteComptable @relation("ImmobilisationCompteAmortissement", fields: [compteAmortissementId], references: [id])

  fournisseurId Int?
  fournisseur   Fournisseur? @relation(fields: [fournisseurId], references: [id])

  dateAcquisition   DateTime
  dateMiseEnService DateTime
  coutAcquisition   Decimal
  valeurResiduelle  Decimal              @default(0)
  dureeAnnees       Int
  methode           MethodeAmortissement @default(LINEAIRE)

  amortissementCumule  Decimal @default(0)
  valeurNetteComptable Decimal

  localisation  String?
  responsableId Int?
  responsable   User?   @relation("ImmobilisationResponsable", fields: [responsableId], references: [id])
  numeroSerie   String?
  notes         String?

  statut      StatutImmobilisation @default(EN_SERVICE)
  dateCession DateTime?
  prixCession Decimal?

  ecritureAcquisitionId Int?

  creePar  Int
  createur User @relation("ImmobilisationCreateur", fields: [creePar], references: [id])

  lignesAmortissement    LigneAmortissement[]
  provisionsDepreciation ProvisionDepreciation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categorie])
  @@index([statut])
}

/// Dotation mensuelle calculée pour une immobilisation (une ligne par période,
/// idempotent) — CDC §22 "le système calcule amortissement mensuel/annuel/cumul/VNC".
model LigneAmortissement {
  id               Int            @id @default(autoincrement())
  immobilisationId Int
  immobilisation   Immobilisation @relation(fields: [immobilisationId], references: [id], onDelete: Cascade)
  periode          String // "YYYY-MM"
  montantDotation  Decimal
  cumulApres       Decimal
  vncApres         Decimal
  ecritureId       Int?

  createdAt DateTime @default(now())

  @@unique([immobilisationId, periode])
}

// ============================================================
// PROVISIONS / DÉPRÉCIATIONS & RÉGULARISATIONS D'AVANCE (CCA/PCA)
// (CDC Comptabilité — écritures d'inventaire et de régularisation)
// ============================================================

enum TypeProvision {
  PROVISION_RISQUE_CHARGE
  DEPRECIATION_STOCK
  DEPRECIATION_CLIENT
  DEPRECIATION_IMMOBILISATION
}

enum StatutProvision {
  ACTIVE
  PARTIELLEMENT_REPRISE
  SOLDEE
}

/// Provision pour risque/charge ou dépréciation d'actif (stock/client/immobilisation) —
/// dotée et reprise via lib/comptabilite/provisions.ts (toujours par écriture, jamais
/// de simple modification de solde).
model ProvisionDepreciation {
  id      Int           @id @default(autoincrement())
  libelle String
  type    TypeProvision

  compteProvisionId Int // compte 19x/29x/39x/49x — crédité à la dotation
  compteProvision   CompteComptable @relation("ProvisionCompteProvision", fields: [compteProvisionId], references: [id])
  compteDotationId  Int // compte 68x — débité à la dotation
  compteDotation    CompteComptable @relation("ProvisionCompteDotation", fields: [compteDotationId], references: [id])
  compteRepriseId   Int // compte 78x/79x — crédité à la reprise
  compteReprise     CompteComptable @relation("ProvisionCompteReprise", fields: [compteRepriseId], references: [id])

  montantInitial   Decimal
  montantActuel    Decimal
  motif            String
  dateConstitution DateTime
  statut           StatutProvision @default(ACTIVE)

  clientId         Int?
  client           Client?         @relation(fields: [clientId], references: [id])
  fournisseurId    Int?
  fournisseur      Fournisseur?    @relation(fields: [fournisseurId], references: [id])
  immobilisationId Int?
  immobilisation   Immobilisation? @relation(fields: [immobilisationId], references: [id])

  societeId Int?
  societe   Societe? @relation(fields: [societeId], references: [id])

  creePar  Int
  createur User @relation("ProvisionCreateur", fields: [creePar], references: [id])

  mouvements MouvementProvision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut])
  @@index([type])
}

enum TypeMouvementProvision {
  DOTATION
  REPRISE
}

/// Historique des dotations/reprises d'une provision — une ligne par écriture générée.
model MouvementProvision {
  id          Int                    @id @default(autoincrement())
  provisionId Int
  provision   ProvisionDepreciation  @relation(fields: [provisionId], references: [id], onDelete: Cascade)
  type        TypeMouvementProvision
  montant     Decimal
  date        DateTime
  ecritureId  Int?
  userId      Int
  user        User                   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([provisionId])
}

enum TypeRegularisation {
  CHARGE_CONSTATEE_AVANCE
  PRODUIT_CONSTATE_AVANCE
}

enum StatutRegularisation {
  ACTIVE
  SOLDEE
}

/// Charge ou produit constaté d'avance (CCA/PCA) — la part hors-exercice d'une
/// charge/produit est sortie immédiatement vers 4786/4787 (476/477 sont déjà pris
/// par les écarts de conversion actif/passif dans le plan comptable livré), puis
/// réimputée mois par mois via ses EcheanceRegularisation
/// (lib/comptabilite/regularisationsAvance.ts).
model RegularisationAvance {
  id      Int                @id @default(autoincrement())
  libelle String
  type    TypeRegularisation

  compteChargeOuProduitId Int // compte 6x (CCA) ou 7x (PCA) d'origine
  compteChargeOuProduit   CompteComptable @relation("RegulCompteOrigine", fields: [compteChargeOuProduitId], references: [id])
  compteRegularisationId  Int // 4786 (CCA) ou 4787 (PCA)
  compteRegularisation    CompteComptable @relation("RegulCompteRegul", fields: [compteRegularisationId], references: [id])

  montantTotal Decimal
  dateDebut    DateTime // début de la période à étaler
  dateFin      DateTime // fin de la période à étaler

  ecritureConstatationId Int? // écriture initiale de sortie du 6x/7x vers 4786/4787
  statut                 StatutRegularisation @default(ACTIVE)

  societeId Int?
  societe   Societe? @relation(fields: [societeId], references: [id])

  creePar  Int
  createur User @relation("RegulCreateur", fields: [creePar], references: [id])

  echeances EcheanceRegularisation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut])
  @@index([type])
}

/// Échéance mensuelle d'une régularisation d'avance — comptabilisée une à une
/// (ou en lot depuis l'assistant de clôture) au fil des mois concernés.
model EcheanceRegularisation {
  id               Int                  @id @default(autoincrement())
  regularisationId Int
  regularisation   RegularisationAvance @relation(fields: [regularisationId], references: [id], onDelete: Cascade)
  periode          String // "YYYY-MM"
  montant          Decimal
  ecritureId       Int?
  comptabilise     Boolean              @default(false)

  createdAt DateTime @default(now())

  @@unique([regularisationId, periode])
}

// ============================================================
// ANALYTIQUE (5 axes) & BUDGET (CDC Comptabilité §24-25)
// ============================================================

// Les 5 axes du CDC : POINT_DE_VENTE et PRODUIT réutilisent les modèles existants
// (PointDeVente, Produit → famille/catégorie) plutôt que d'être dupliqués ici.
// Seuls ACTIVITE, PROJET et DEPARTEMENT ont besoin d'un référentiel dédié.
enum AxeAnalytique {
  ACTIVITE
  PROJET
  DEPARTEMENT
  CENTRE_COUT
}

/// Section analytique (CDC §24, axes Activité/Projet/Département) — un même
/// modèle paramétrable pour les 3 axes qui n'ont pas d'entité métier existante.
model SectionAnalytique {
  id      Int           @id @default(autoincrement())
  axe     AxeAnalytique
  code    String        @unique
  libelle String
  actif   Boolean       @default(true)

  lignesEcriture       LigneEcriture[]
  lignesBudget         LigneBudget[]
  comptesParDefaut     CompteComptable[]
  reglesAnalytique     RegleComptable[]           @relation("RegleAnalytique")
  reglesCentreCout     RegleComptable[]           @relation("RegleCentreCout")
  produitsComptables   Produit[]                  @relation("ProduitSectionAnalytique")
  categoriesComptables CategorieProduit[]         @relation("CategorieSectionAnalytique")
  famillesComptables   FamilleProduit[]           @relation("FamilleSectionAnalytique")
  propositionsOCR      PropositionImputationOCR[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([axe])
}

enum StatutBudget {
  BROUILLON
  VALIDE
}

/// Budget annuel (CDC §25) — décliné par compte/section analytique/PDV et par mois.
model Budget {
  id      Int          @id @default(autoincrement())
  annee   Int          @unique
  libelle String?
  statut  StatutBudget @default(BROUILLON)
  userId  Int?
  user    User?        @relation(fields: [userId], references: [id])

  lignes LigneBudget[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LigneBudget {
  id       Int    @id @default(autoincrement())
  budgetId Int
  budget   Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  compteId Int
  compte   CompteComptable @relation(fields: [compteId], references: [id])

  sectionAnalytiqueId Int?
  sectionAnalytique   SectionAnalytique? @relation(fields: [sectionAnalytiqueId], references: [id])
  pointDeVenteId      Int?
  pointDeVente        PointDeVente?      @relation(fields: [pointDeVenteId], references: [id])
  // CDC §24/§25 — 3e axe analytique (Produit), au même titre que sur LigneEcriture.
  produitId           Int?
  produit             Produit?           @relation(fields: [produitId], references: [id])

  mois         Int // 1-12
  montantPrevu Decimal
  // CDC §25 — colonne "Observation" du tableau Budget/Réalisé/Écart.
  observation  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([budgetId])
  @@index([compteId])
  @@index([mois])
  @@index([produitId])
}

// ============================================================
// TAXES GÉNÉRIQUES, ÉCRITURES RÉCURRENTES, EXERCICES (CDC §21/§26/§28-32)
// ============================================================

enum RegimeFiscal {
  REEL_NORMAL
  REEL_SIMPLIFIE
  EXONERE
}

/// Taxe paramétrable (CDC §21) — ne jamais coder un taux fiscal en dur : la TVA
/// dédiée (DeclarationTVA) reste le calcul officiel actuel, ce registre est la
/// base pour paramétrer d'autres taxes (locales, retenues...) sans redéploiement.
model TaxeConfig {
  id     Int     @id @default(autoincrement())
  code   String  @unique
  nom    String
  taux   Decimal // %
  nature String // libre : "TVA", "TAXE_LOCALE", "RETENUE_SOURCE"...

  compteCollecteNumero       String // crédité — taxe collectée sur ventes
  compteDeductibleNumero     String? // débité — taxe déductible sur achats
  compteRegularisationNumero String?

  regimeFiscal    RegimeFiscal @default(REEL_NORMAL)
  applicableAchat Boolean      @default(true)
  applicableVente Boolean      @default(true)
  dateDebut       DateTime?
  dateFin         DateTime?
  actif           Boolean      @default(true)

  // CDC §65 (tax_rules) : conditions optionnelles, même principe que
  // RegleComptable — une condition non renseignée matche tout ; la taxe la
  // plus prioritaire dont toutes les conditions renseignées matchent gagne.
  // Laissé vide partout = comportement historique inchangé (taux global).
  conditionCategorieId    Int?
  conditionCategorie      CategorieProduit? @relation(fields: [conditionCategorieId], references: [id])
  conditionFamilleId      Int?
  conditionFamille        FamilleProduit?   @relation(fields: [conditionFamilleId], references: [id])
  conditionPointDeVenteId Int?
  conditionPointDeVente   PointDeVente?     @relation(fields: [conditionPointDeVenteId], references: [id])
  priorite                Int               @default(0)

  // CDC §50 — multi-société (version légère, voir commentaire du modèle Societe) :
  // `null` = taxe du référentiel partagé/société principale.
  societeId Int?
  societe   Societe? @relation(fields: [societeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nature])
  @@index([actif])
  @@index([societeId])
}

enum TypeChargeProduitAttente {
  CHARGE_A_PAYER
  PRODUIT_A_RECEVOIR
}

enum StatutChargeProduitAttente {
  EN_ATTENTE
  EXTOURNEE
}

/// Charge à payer / produit à recevoir (CDC Comptabilité §27) — distinct des
/// CCA/PCA (RegularisationAvance, étalement d'une charge/produit déjà connu
/// sur plusieurs mois) : ici, la charge/le produit appartient à l'exercice en
/// cours mais la facture n'est pas encore reçue/établie. Constatation
/// immédiate Dr 6x/Cr 408 (charge à payer) ou Dr 418/Cr 7x (produit à
/// recevoir), extournée (écriture inverse) dès réception/émission de la
/// facture réelle — jamais les deux écritures simultanément en compte.
model ChargeProduitAttente {
  id      Int                      @id @default(autoincrement())
  libelle String
  type    TypeChargeProduitAttente

  compteChargeOuProduitId Int // compte 6x (charge à payer) ou 7x (produit à recevoir)
  compteChargeOuProduit   CompteComptable @relation("AttenteCompteChargeOuProduit", fields: [compteChargeOuProduitId], references: [id])
  compteAttenteId         Int // 408 (charge à payer) ou 418 (produit à recevoir) par défaut
  compteAttente           CompteComptable @relation("AttenteCompteAttente", fields: [compteAttenteId], references: [id])

  montant          Decimal
  dateConstatation DateTime
  statut           StatutChargeProduitAttente @default(EN_ATTENTE)

  ecritureConstatationId Int?
  ecritureExtourneId     Int?
  dateExtourne           DateTime?
  notes                  String?

  creeParId Int
  creePar   User @relation("ChargeProduitAttenteCreateur", fields: [creeParId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut])
  @@index([type])
}

enum TypeEngagementHorsBilan {
  CAUTION_DONNEE
  CAUTION_RECUE
  GARANTIE_DONNEE
  GARANTIE_RECUE
  CREDIT_BAIL
  LITIGE_EN_COURS
  AUTRE
}

enum StatutEngagementHorsBilan {
  ACTIF
  LEVE
}

/// Engagement hors-bilan (CDC Comptabilité §39 — notes annexes : "engagements")
/// — cautions, garanties, crédit-bail, litiges en cours dont le montant
/// n'apparaît jamais au bilan mais doit être mentionné en annexe. Suivi pur,
/// ne génère aucune écriture (par nature hors-bilan).
model EngagementHorsBilan {
  id           Int                       @id @default(autoincrement())
  reference    String                    @unique
  type         TypeEngagementHorsBilan
  libelle      String
  montant      Decimal
  beneficiaire String? // tiers concerné (texte libre — pas toujours un client/fournisseur du système)
  dateDebut    DateTime
  dateFin      DateTime?
  statut       StatutEngagementHorsBilan @default(ACTIF)
  dateLevee    DateTime?
  notes        String?

  creeParId Int
  creePar   User @relation("EngagementHorsBilanCreateur", fields: [creeParId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut])
  @@index([type])
}

enum FrequenceRecurrente {
  MENSUEL
  TRIMESTRIEL
  ANNUEL
}

enum StatutRecurrente {
  ACTIF
  SUSPENDU
  TERMINE
}

/// Écriture récurrente (CDC §26) — loyer, abonnement, assurance, frais bancaires...
/// générée automatiquement à échéance par lib/comptabilite/recurrentes.ts.
model EcritureRecurrente {
  id      Int     @id @default(autoincrement())
  libelle String
  montant Decimal

  compteDebitNumero  String
  compteCreditNumero String
  journal            String // builtin ou JournalComptable.code (CDC §9)

  frequence                 FrequenceRecurrente @default(MENSUEL)
  dateDebut                 DateTime
  dateFin                   DateTime?
  nombreOccurrencesMax      Int?
  nombreOccurrencesGenerees Int                 @default(0)
  derniereGenerationLe      DateTime?

  statut StatutRecurrente @default(ACTIF)
  userId Int
  user   User             @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut])
}

enum StatutExercice {
  PREPARATION
  OUVERT
  EN_CLOTURE
  CLOTURE
  ARCHIVE
}

/// Exercice comptable (CDC §28-32) : ouverture/clôture annuelle, avec assistant
/// de clôture (réutilise les contrôles CDC §40) et report à nouveau automatique.
model ExerciceComptable {
  id        Int            @id @default(autoincrement())
  annee     Int            @unique
  dateDebut DateTime
  dateFin   DateTime
  statut    StatutExercice @default(PREPARATION)

  clotureParId Int?
  cloturePar   User?     @relation(fields: [clotureParId], references: [id])
  dateCloture  DateTime?

  ecritureClotureId        Int?
  ecritureReportANouveauId Int?

  // Multi-société (CDC §50) : null = société principale. `annee` reste unique
  // globalement (pas encore (societeId, annee)) tant qu'une seule société existe.
  societeId Int?
  societe   Societe? @relation(fields: [societeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([societeId])
}

/// Configuration comptable initiale (CDC §60 — assistant de première installation).
/// Singleton (id=1, même convention que ParametrageCompteCourant). Les autres
/// étapes de l'assistant (exercice, plan comptable, taxes, journaux, comptes
/// auxiliaires, immobilisations, analytique) ne sont PAS dupliquées ici : leur
/// complétion est calculée à la volée depuis les données réelles
/// (lib/comptabilite/configurationInitiale.ts), pour éviter un état "fait/pas
/// fait" qui pourrait diverger de la réalité.
/// Référentiel comptable versionné (CDC §77) : catalogue historique de quel
/// référentiel/version/pays fait foi et depuis quand. Volontairement léger
/// (pas de FK depuis CompteComptable/RegleComptable/TaxeConfig, migration trop
/// invasive pour un gain marginal) — le versioning temporel granulaire existe
/// déjà au niveau des règles (RegleComptable.dateDebutValidite/dateFinValidite)
/// et des taxes (TaxeConfig.dateDebut/dateFin) ; ce modèle couvre le seul
/// niveau qui manquait : le référentiel global actif, avec historique.
model ReferentielComptable {
  id              Int      @id @default(autoincrement())
  code            String   @unique // ex: "SYSCOHADA_REVISE_2017"
  nom             String // ex: "Acte uniforme OHADA — SYSCOHADA révisé"
  version         String // ex: "2017"
  pays            String // ex: "Togo" (ou "OHADA" si régional commun)
  dateApplication DateTime
  actif           Boolean  @default(true)
  notes           String?

  configurations ConfigurationComptableInitiale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ConfigurationComptableInitiale {
  id          Int    @id @default(1)
  pays        String @default("Togo")
  devise      String @default("XOF")
  referentiel String @default("SYSCOHADA révisé")
  typeEntite  String @default("Société commerciale")

  referentielActifId Int?
  referentielActif   ReferentielComptable? @relation(fields: [referentielActifId], references: [id])

  // ── Comptabilité §53 : dernier niveau de la cascade Produit > Catégorie >
  // Famille > Configuration générale — comptes par défaut appliqués quand aucun
  // niveau plus précis n'est paramétré (avant repli sur REGLES_PAR_DEFAUT codé
  // en dur dans lib/comptabilite/moteur.ts).
  compteAchatDefaut          String?
  compteVenteDefaut          String?
  compteStockDefaut          String?
  compteVariationStockDefaut String?
  compteTvaAchatDefaut       String?
  compteTvaVenteDefaut       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Devise paramétrable (CDC §49) : jamais de taux de change codé en dur. La
/// devise fonctionnelle (celle dans laquelle le grand livre est tenu) a
/// tauxVersFonctionnelle=1 par convention ; les autres devises portent un taux
/// mis à jour manuellement par un comptable habilité (pas de flux temps réel).
model Devise {
  code                  String   @id // "XOF", "EUR", "USD"...
  nom                   String
  symbole               String
  tauxVersFonctionnelle Decimal  @default(1)
  dateTauxMaj           DateTime @default(now())
  actif                 Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Société (CDC §50 — "architecture prévue pour multi-sociétés"). AfriSime
/// SARL est aujourd'hui l'unique société active (estPrincipale=true), mais
/// EcritureComptable/ExerciceComptable/JournalComptable/CompteComptable/
/// TaxeConfig portent déjà un societeId optionnel pour ne jamais bloquer
/// l'ajout d'une 2e entité (`null` = société principale/plan partagé).
/// Le plan comptable (CompteComptable.numero) reste volontairement partagé/non
/// scopé par société (unicité globale sur `numero`, pas composite
/// (societeId, numero)) — le scoper réellement impliquerait de retoucher
/// chaque résolution par numéro dans le moteur (~20 points d'appel) pour un
/// besoin qui n'existe pas encore concrètement (une seule société réelle
/// aujourd'hui) ; à faire le jour où une 2e société réelle est créée avec son
/// propre plan comptable. `societeId` sert dès maintenant à filtrer/reporter
/// (cf. lib/comptabilite/consolidation.ts), pas à séparer les référentiels.
model Societe {
  id                      Int     @id @default(autoincrement())
  nom                     String
  pays                    String  @default("Togo")
  deviseFonctionnelleCode String  @default("XOF")
  referentielComptable    String  @default("SYSCOHADA révisé")
  typeEntite              String  @default("Société commerciale")
  estPrincipale           Boolean @default(false)
  actif                   Boolean @default(true)

  exercices              ExerciceComptable[]
  journaux               JournalComptable[]
  ecritures              EcritureComptable[]
  comptes                CompteComptable[]
  taxes                  TaxeConfig[]
  provisionsDepreciation ProvisionDepreciation[]
  regularisationsAvance  RegularisationAvance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estPrincipale])
}

// ============================================================
// ACTIONNAIRES & ASSEMBLÉES
// ============================================================

model Dividende {
  id             Int             @id @default(autoincrement())
  periode        String
  montantTotal   Decimal
  montantParPart Decimal?
  dateVersement  DateTime?
  statut         StatutDividende @default(PLANIFIE)
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Assemblee {
  id            Int             @id @default(autoincrement())
  titre         String
  description   String?
  type          TypeAssemblee
  statut        StatutAssemblee @default(PLANIFIEE)
  dateAssemblee DateTime
  lieu          String
  ordreJour     String?
  notes         String?

  participants AssembleeParticipant[]
  resolutions  ResolutionAssemblee[]
  procurations ProcurationAssemblee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AssembleeParticipant {
  id               Int                 @id @default(autoincrement())
  assembleeId      Int
  gestionnaireId   Int
  statut           StatutParticipation @default(INVITE)
  dateConfirmation DateTime?

  assemblee    Assemblee       @relation(fields: [assembleeId], references: [id], onDelete: Cascade)
  gestionnaire Gestionnaire    @relation(fields: [gestionnaireId], references: [id])
  votes        VoteAssemblee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assembleeId, gestionnaireId])
}

model ResolutionAssemblee {
  id          Int              @id @default(autoincrement())
  assembleeId Int
  numero      Int
  titre       String
  description String?
  statut      StatutResolution @default(EN_ATTENTE)

  assemblee Assemblee       @relation(fields: [assembleeId], references: [id], onDelete: Cascade)
  votes     VoteAssemblee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assembleeId, numero])
}

model VoteAssemblee {
  id            Int          @id @default(autoincrement())
  resolutionId  Int
  participantId Int
  decision      DecisionVote
  commentaire   String?

  resolution  ResolutionAssemblee  @relation(fields: [resolutionId], references: [id], onDelete: Cascade)
  participant AssembleeParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([resolutionId, participantId])
}

model ActionnaireProfile {
  id             Int               @id @default(autoincrement())
  gestionnaireId Int               @unique
  statut         StatutActionnaire @default(EN_ATTENTE)
  typeAction     TypeActionDetenue @default(ORDINAIRE)
  nombreActions  Int               @default(0)
  prixUnitaire   Decimal           @default(0)
  dateEntree     DateTime?
  notes          String?

  gestionnaire Gestionnaire      @relation(fields: [gestionnaireId], references: [id])
  mouvements   MouvementAction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MouvementAction {
  id           Int                 @id @default(autoincrement())
  profileId    Int
  type         TypeMouvementAction
  quantite     Int
  prixUnitaire Decimal
  montantTotal Decimal
  date         DateTime
  description  String?

  profile ActionnaireProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model ProcurationAssemblee {
  id           Int               @id @default(autoincrement())
  assembleeId  Int
  mandantId    Int
  mandataireId Int
  statut       StatutProcuration @default(EN_ATTENTE)
  notes        String?

  assemblee  Assemblee    @relation(fields: [assembleeId], references: [id], onDelete: Cascade)
  mandant    Gestionnaire @relation("procurationsMandant", fields: [mandantId], references: [id])
  mandataire Gestionnaire @relation("procurationsMandataire", fields: [mandataireId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assembleeId, mandantId])
}

// ============================================================
// BIBLIOTHÈQUE DOCUMENTAIRE
// ============================================================

model DocumentBibliotheque {
  id          Int          @id @default(autoincrement())
  titre       String
  type        TypeDocument
  description String?
  fichierUrl  String?
  fichierNom  String?
  annee       Int?
  estPublic   Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Documents RH stratégiques (CDC §13) — nature E, à l'échelle société ─────────
enum TypeDocumentStrategiqueRH {
  MANUEL_RH
  POLITIQUE_RH
  REGLEMENT_INTERIEUR
  CODE_CONDUITE
  CODE_ETHIQUE
  POLITIQUE_REMUNERATION
  POLITIQUE_DISCIPLINAIRE
  POLITIQUE_RECRUTEMENT
  POLITIQUE_FORMATION
  POLITIQUE_PROMOTION
  POLITIQUE_DIVERSITE
  POLITIQUE_SANTE_SECURITE
  POLITIQUE_CONFIDENTIALITE
  PLAN_EVACUATION
  AUTRE
}

enum StatutDocumentStrategique {
  BROUILLON
  EN_VIGUEUR
  ARCHIVE
}

/// Document RH stratégique (manuel, politique, règlement, code) — une instance
/// société, versionnée par type ; une seule version EN_VIGUEUR par type à la fois.
model DocumentStrategiqueRH {
  id             Int                       @id @default(autoincrement())
  type           TypeDocumentStrategiqueRH
  titre          String
  reference      String?
  version        Int                       @default(1)
  description    String?
  contenu        String? // texte/HTML éditable (optionnel)
  fichierUrl     String? // fichier uploadé (optionnel)
  statut         StatutDocumentStrategique @default(BROUILLON)
  dateEffet      DateTime?
  creePar        Int // User.id
  pointDeVenteId Int? // rattachement site (ex: plan d'évacuation) ; null = document global

  pointDeVente PointDeVente? @relation(fields: [pointDeVenteId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([statut])
  @@index([pointDeVenteId])
}

// ============================================================
// SUPER ADMIN — SYSTÈME
// ============================================================

/// Paramètres globaux de la plateforme (clé-valeur)
model SystemSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  category  String   @default("platform")
  updatedAt DateTime @updatedAt
  updatedBy Int?
}

/// Journal de sécurité (connexions, tentatives, déconnexions forcées…)
model SecurityLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail String?
  action    String
  ipAddress String?
  userAgent String?
  details   String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

/// Permissions personnalisées par utilisateur
model UserPermission {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module     String
  permission String
  granted    Boolean  @default(true)
  grantedBy  Int?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, module, permission])
  @@index([userId])
}

/// Configuration d'accès aux sections/pages par rôle gestionnaire
model RolePageAccess {
  id        Int              @id @default(autoincrement())
  role      RoleGestionnaire
  pageKey   String
  allowed   Boolean          @default(true)
  updatedBy Int?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([role, pageKey])
  @@index([role])
}

/// RBAC granulaire : permission (action) accordée à un rôle sur un module.
/// action ∈ LECTURE|CREATION|MODIFICATION|VALIDATION|EXPORT|SUPPRESSION_LOGIQUE
/// (cf. lib/permissionsRegistry.ts). Les overrides par utilisateur passent par
/// UserPermission avec permission = "ACTION:<module>:<action>".
model RolePermission {
  id        Int              @id @default(autoincrement())
  role      RoleGestionnaire
  module    String
  action    String
  allowed   Boolean          @default(true)
  updatedBy Int?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([role, module, action])
  @@index([role])
}

/// CDC §68 — droits par journal : restreint un rôle à un sous-ensemble de
/// journaux comptables (code JOURNAUX_BUILTIN ou JournalComptable.code).
/// Absence de toute ligne pour un rôle = non restreint (comportement additif,
/// tout journal reste autorisé par défaut — pas de régression sur l'existant).
model RoleJournalAutorise {
  id          Int              @id @default(autoincrement())
  role        RoleGestionnaire
  journalCode String
  createdAt   DateTime         @default(now())

  @@unique([role, journalCode])
  @@index([role])
}

/// Override individuel (priorité sur RoleJournalAutorise) — autorise ou retire
/// explicitement un journal pour un utilisateur donné, même schéma que UserPermission.
model UserJournalAutorise {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  journalCode String
  autorise    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([userId, journalCode])
  @@index([userId])
}

/// Modules de la plateforme — activation / désactivation
model SystemModule {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  nom         String
  description String?
  actif       Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  updatedBy   Int?
}

// ============================================================
// FACTURES DE VENTE
// Générées depuis VenteDirecte (comptant/crédit) ou en standalone (pro-forma)
// ============================================================

model FactureVente {
  id     Int                @id @default(autoincrement())
  numero String             @unique // ex: FAC-2026-00001
  type   TypeFactureVente
  statut StatutFactureVente @default(EMISE)

  // Source (optionnel — absent pour pro-forma standalone)
  venteDirecteId  Int? @unique
  creditClientId  Int?
  receptionPackId Int?

  // PDV (snapshot + relation)
  pointDeVenteId Int?
  pdvNom         String?
  pdvAdresse     String?
  pdvTelephone   String?

  // Client (snapshot pour archivage pérenne)
  clientId        Int?
  clientNom       String
  clientTelephone String?
  clientAdresse   String?

  // Émetteur (snapshot nom + fonction/rôle dans l'entreprise au moment de l'émission)
  emiseParId       Int
  emiseParNom      String
  emiseParFonction String?

  // Montants
  montantHT    Decimal
  montantTVA   Decimal @default(0)
  montantTTC   Decimal
  montantPaye  Decimal @default(0)
  modePaiement String?

  dateEmission DateTime  @default(now())
  dateEcheance DateTime?
  notes        String?
  garantie     String? // snapshot de la garantie du crédit (si facture issue d'un crédit)

  // Relations
  venteDirecte  VenteDirecte?         @relation("VenteDirecteFacture", fields: [venteDirecteId], references: [id])
  creditClient  CreditClient?         @relation("CreditClientFactures", fields: [creditClientId], references: [id])
  receptionPack ReceptionProduitPack? @relation("ReceptionPackFactures", fields: [receptionPackId], references: [id])
  client        Client?               @relation("FacturesVenteClient", fields: [clientId], references: [id])
  pointDeVente  PointDeVente?         @relation("FacturesVentePDV", fields: [pointDeVenteId], references: [id])
  emisePar      User                  @relation("FacturesVenteEmises", fields: [emiseParId], references: [id])
  lignes        LigneFactureVente[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([emiseParId])
  @@index([clientId])
  @@index([pointDeVenteId])
  @@index([creditClientId])
  @@index([receptionPackId])
  @@index([type])
  @@index([statut])
}

model LigneFactureVente {
  id           Int     @id @default(autoincrement())
  factureId    Int
  designation  String
  unite        String?
  quantite     Float
  prixUnitaire Decimal
  montant      Decimal

  facture FactureVente @relation(fields: [factureId], references: [id], onDelete: Cascade)
}

// ============================================================
// OGRH — MODULE 1 : DOSSIER COLLABORATEUR
// Extension RH du Gestionnaire (nomenclature AfriGes)
// ============================================================

enum StatutCollaborateur {
  ACTIF
  EN_PERIODE_ESSAI
  SUSPENDU
  DEMISSIONNAIRE
  LICENCIE
  RETRAITE
  INACTIF
}

enum TypeContrat {
  CDI
  CDD
  STAGE
  CONSULTANT
  PRESTATAIRE
  FREELANCE
}

enum SituationMatrimoniale {
  CELIBATAIRE
  MARIE
  DIVORCE
  VEUF
  UNION_LIBRE
}

enum NiveauHierarchique {
  DIRECTION
  MANAGER
  SUPERVISEUR
  AGENT
  STAGIAIRE
}

enum TypeDocumentCollaborateur {
  CNI
  PASSEPORT
  DIPLOME
  CERTIFICAT
  CV
  ATTESTATION
  CONTRAT
  PHOTO_IDENTITE
  // Pièces administratives (dossier du personnel — CDC §3)
  LETTRE_MOTIVATION
  ACTE_NAISSANCE
  CASIER_JUDICIAIRE
  CERTIFICAT_MEDICAL
  ATTESTATION_CNSS
  COORDONNEES_BANCAIRES
  CONTACT_URGENCE
  CORRESPONDANCE
  AUTRE
}

/// Profil RH d'un Gestionnaire — données administratives et contractuelles
/// Lié à Gestionnaire (1-1) ; toutes les autres entités OGRH pointent vers ProfilRH.id
model ProfilRH {
  id             Int @id @default(autoincrement())
  gestionnaireId Int @unique

  // ── Identité ──────────────────────────────────────────────
  matricule             String                 @unique // ex: MAT-2026-0001 (auto-généré)
  emailProfessionnel    String?                @unique // ex: prenom.nom@company.com (auto-généré à l'onboarding)
  dateNaissance         DateTime?
  lieuNaissance         String?
  sexe                  Sexe?
  nationalite           String?
  situationMatrimoniale SituationMatrimoniale?
  nbEnfants             Int                    @default(0)
  telephoneSecondaire   String?

  // ── Contrat & poste ───────────────────────────────────────
  typeContrat        TypeContrat?
  dateEmbauche       DateTime?
  dateFin            DateTime? // CDD uniquement
  fonction           String?
  service            String?
  departement        String?
  niveauHierarchique NiveauHierarchique?
  statut             StatutCollaborateur @default(ACTIF)
  notes              String?

  // ── Hiérarchie (manager direct = autre ProfilRH) ──────────
  managerId   Int?
  manager     ProfilRH?  @relation("HierarchieRH", fields: [managerId], references: [id])
  subordonnes ProfilRH[] @relation("HierarchieRH")

  // ── Horaires de référence ──────────────────────────────────
  configHoraireId Int?
  configHoraire   ConfigHoraire? @relation(fields: [configHoraireId], references: [id])

  // ── Relations ─────────────────────────────────────────────
  gestionnaire              Gestionnaire               @relation(fields: [gestionnaireId], references: [id])
  documents                 DocumentCollaborateur[]
  soldesConges              SoldeConge[]
  demandesConge             DemandeConge[]
  missions                  Mission[]                  @relation("MissionsCollaborateur")
  missionsValidees          Mission[]                  @relation("MissionsValidateurRH")
  documentsGeneres          DocumentRHGenere[]
  fichesPaie                FichePaie[]
  avancesSalaire            AvanceSalaire[]
  pretsEmploye              PretEmploye[]
  participationsFormation   ParticipationFormation[]
  pointages                 Pointage[]
  avantages                 AvantageRH[]
  remboursementsFrais       RemboursementFrais[]
  evaluations               EvaluationRH[]             @relation("EvaluationsCollaborateur")
  evaluationsEffectuees     EvaluationRH[]             @relation("EvaluationsEffectuees")
  procedures                ProcedureDisciplinaire[]
  historiquesPoste          HistoriquePoste[]
  planCarriere              PlanCarriere?
  successions               SuccesseurPotentiel[]
  onboarding                OnboardingEmploye?
  competences               CollaborateurCompetence[]
  demandesMouvementCarriere DemandeMouvementCarriere[]
  demandesFormation         DemandeFormation[]
  affectationsPlanning      AffectationPlanning[]
  accidentsTravail          AccidentTravail[]
  visitesMedicales          VisiteMedicale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut])
  @@index([departement])
  @@index([managerId])
}

// ============================================================
// OGRH — MODULE 2 : HISTORIQUE ORGANISATIONNEL
// ============================================================

enum TypeMouvementCarriere {
  PROMOTION
  MUTATION
  EVOLUTION
  RECLASSEMENT
}

enum NiveauReadiness {
  PRET_MAINTENANT
  PRET_SOUS_1_AN
  PRET_1_A_3_ANS
  EN_DEVELOPPEMENT
}

/// Trace chaque changement de poste, de manager ou de département d'un collaborateur
model HistoriquePoste {
  id         Int @id @default(autoincrement())
  profilRHId Int

  type TypeMouvementCarriere? // PROMOTION | MUTATION | EVOLUTION | RECLASSEMENT

  // Avant
  ancienManagerId   Int?
  ancienneFonction  String?
  ancienService     String?
  ancienDepartement String?
  ancienSalaire     Decimal?

  // Après
  nouveauManagerId   Int?
  nouvelleFonction   String?
  nouveauService     String?
  nouveauDepartement String?
  nouveauSalaire     Decimal?

  motif      String?
  modifiePar Int // User.id de l'auteur du changement

  profilRH ProfilRH @relation(fields: [profilRHId], references: [id])

  createdAt DateTime @default(now())

  @@index([profilRHId])
  @@index([type])
  @@index([createdAt])
}

/// Plan de carrière individuel d'un collaborateur (upsert — 1 par profilRH)
model PlanCarriere {
  id                Int       @id @default(autoincrement())
  profilRHId        Int       @unique
  aspiration        String?
  prochainPosteVise String?
  dateRevision      DateTime?
  actions           String? // plan d'actions concrètes
  notes             String?

  profilRH ProfilRH @relation(fields: [profilRHId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum StatutDemandeRH {
  EN_ATTENTE
  VALIDE_MANAGER
  VALIDE_RH
  APPROUVE
  REJETE
  ANNULE
}

/// Demande de mouvement de carrière (promotion, mutation, évolution, reclassement)
/// — formalise l'approbation avant l'écriture dans HistoriquePoste (Phase 2 OGRH).
model DemandeMouvementCarriere {
  id         Int                   @id @default(autoincrement())
  profilRHId Int
  type       TypeMouvementCarriere

  nouvelleFonction   String?
  nouveauService     String?
  nouveauDepartement String?
  nouveauSalaire     Decimal?
  nouveauManagerId   Int?

  motif        String?
  demandeParId Int // User.id de l'auteur de la demande
  statut       StatutDemandeRH @default(EN_ATTENTE)

  commentaireRefus   String?
  dateValidationRH   DateTime?
  dateDecisionFinale DateTime?
  historiquePosteId  Int? // renseigné à l'approbation (HistoriquePoste créé)

  profilRH ProfilRH @relation(fields: [profilRHId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profilRHId])
  @@index([statut])
}

/// Poste stratégique nécessitant un plan de succession
model PosteCritique {
  id                  Int     @id @default(autoincrement())
  titre               String
  departement         String?
  description         String?
  nbSuccesseursRequis Int     @default(2)
  actif               Boolean @default(true)

  successeurs SuccesseurPotentiel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([actif])
}

/// Lien collaborateur ↔ poste critique avec niveau de préparation
model SuccesseurPotentiel {
  id              Int             @id @default(autoincrement())
  posteCritiqueId Int
  profilRHId      Int
  readiness       NiveauReadiness
  estTalentCle    Boolean         @default(false)
  notes           String?
  actif           Boolean         @default(true) // soft delete (CDC §8)

  posteCritique PosteCritique @relation(fields: [posteCritiqueId], references: [id], onDelete: Cascade)
  profilRH      ProfilRH      @relation(fields: [profilRHId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([posteCritiqueId, profilRHId])
  @@index([posteCritiqueId])
  @@index([profilRHId])
  @@index([estTalentCle])
}

/// Documents uploadés pour le dossier d'un collaborateur
/// Jamais supprimés — versionning par compteur
model DocumentCollaborateur {
  id             Int                       @id @default(autoincrement())
  profilRHId     Int
  type           TypeDocumentCollaborateur
  nom            String
  fileUrl        String
  version        Int                       @default(1)
  notes          String?
  dateExpiration DateTime? // CNI, passeport, permis… (null = pas d'expiration)
  uploadePar     Int // User.id de l'agent qui a uploadé

  profilRH ProfilRH @relation(fields: [profilRHId], references: [id])

  createdAt DateTime @default(now())

  @@index([profilRHId])
  @@index([type])
  @@index([dateExpiration])
}

// ============================================================
// OGRH — MODULE 6 : CONGÉS & ABSENCES
// ============================================================

enum TypeConge {
  ANNUEL
  MALADIE
  EXCEPTIONNEL
  PERMISSION
  FORMATION
  MATERNITE
  PATERNITE
  SANS_SOLDE
}

enum StatutDemandeConge {
  EN_ATTENTE // soumis par le collaborateur
  VALIDE_MANAGER // approuvé par le manager direct
  VALIDE_RH // approuvé par le RH
  APPROUVE // décision finale favorable
  REJETE // refusé (à n'importe quelle étape)
  ANNULE // annulé par le collaborateur
}

/// Règles de congé par type — configurables par le RH sans dev
model PolitiqueConge {
  id             Int       @id @default(autoincrement())
  type           TypeConge @unique
  joursParAn     Int       @default(0)
  reportable     Boolean   @default(false)
  joursMaxReport Int       @default(0)
  actif          Boolean   @default(true)
  description    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Solde de congés par collaborateur, par type et par année calendaire
model SoldeConge {
  id         Int       @id @default(autoincrement())
  profilRHId Int
  type       TypeConge
  annee      Int
  totalDroit Int       @default(0)
  pris       Int       @default(0) // calculé à chaque validation
  reporte    Int       @default(0)
  restant    Int       @default(0) // totalDroit + reporte - pris

  profilRH ProfilRH @relation(fields: [profilRHId], references: [id])

  @@unique([profilRHId, type, annee])
  @@index([profilRHId])
}

/// Demande de congé avec workflow d'approbation à 2 niveaux
model DemandeConge {
  id         Int                @id @default(autoincrement())
  profilRHId Int
  type       TypeConge
  dateDebut  DateTime
  dateFin    DateTime
  nbJours    Int
  motif      String?
  statut     StatutDemandeConge @default(EN_ATTENTE)

  // Workflow
  managerId          Int? // ProfilRH.gestionnaireId du manager
  rhId               Int? // User.id du responsable RH
  commentaireRefus   String?
  dateValidationMgr  DateTime?
  dateValidationRH   DateTime?
  dateDecisionFinale DateTime?

  profilRH ProfilRH @relation(fields: [profilRHId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profilRHId])
  @@index([statut])
  @@index([dateDebut, dateFin])
}

// ============================================================
// OGRH — MODULE 7 : MISSIONS & DÉPLACEMENTS
