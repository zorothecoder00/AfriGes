// ============================================================
// MODULE COMPTE COURANT CLIENT (portefeuille interne / Wallet AfriSime)
// ============================================================

enum StatutCompteCourant {
  ACTIF
  SUSPENDU
  CLOTURE
  DECEDE
  BLACKLIST
  FRAUDULEUX
}

enum NatureMouvementCC {
  DEPOT
  RETRAIT
  PAIEMENT_CREDIT
  PAIEMENT_COMPTANT
  CORRECTION
  ANNULATION
  TRANSFERT
}

enum StatutMouvementCC {
  VALIDE
  EN_ATTENTE
  ANNULE
}

// Nature du titulaire d'un compte courant (CDC §19.A : individuel ou collectif)
enum TypeCompteCC {
  INDIVIDUEL // une seule personne
  MENAGE // un foyer / une famille
  COMMUNAUTE // une communauté
  GROUPEMENT // un groupement (tontine, coopérative, association…)
}

// Rôle d'un client au sein d'un compte courant collectif (CDC §19.A)
enum RoleMembreCC {
  TITULAIRE // représentant principal du compte (obligatoire, unique par compte)
  MANDATAIRE // habilité à opérer sur le compte pour le compte du groupe
  MEMBRE // membre / bénéficiaire simple
}

// Fréquence de cotisation d'un plan d'épargne programmée (CDC §19.B)
enum FrequenceEpargne {
  QUOTIDIENNE
  HEBDOMADAIRE
  MENSUELLE
}

// Statut d'un plan d'épargne programmée (CDC §19.B)
enum StatutPlanEpargne {
  EN_COURS // en cours de constitution
  ATTEINT // objectif atteint
  ABANDONNE // arrêté volontairement
  EXPIRE // échéance dépassée sans objectif atteint
}

// Niveau de fidélité d'un client (CDC §19.D) — débloque des avantages croissants.
enum NiveauFidelite {
  BRONZE
  ARGENT
  OR
  PLATINE
}

// Nature d'un mouvement de points de fidélité (CDC §19.D)
enum TypeTransactionFidelite {
  GAIN // points gagnés sur un dépôt
  BONUS // bonus manuel (régularité, geste commercial)
  DEPENSE // points échangés (cadeau, avantage)
  AJUSTEMENT // correction manuelle (+/−)
}

// Statut d'un blocage volontaire d'épargne (CDC §19.E)
enum StatutBlocageEpargne {
  ACTIF // fonds indisponibles
  LIBERE // échéance atteinte ou déblocage anticipé
  ANNULE // blocage annulé (créé par erreur)
}

// Paramétrage général du module (enregistrement unique, id = 1)
model ParametrageCompteCourant {
  id                         Int      @id @default(1)
  montantMinOuverture        Decimal  @default(500)
  soldeMinObligatoire        Decimal  @default(500)
  depotMin                   Decimal  @default(500)
  depotMax                   Decimal?
  retraitMin                 Decimal?
  retraitMax                 Decimal?
  soldeMaxAutorise           Decimal?
  autoriserSoldeNegatif      Boolean  @default(false)
  nbRetraitsMaxParMois       Int?
  dureeInactiviteJours       Int      @default(180)
  joursAlerteAvantSuspension Int      @default(15) // délai d'alerte préventive avant suspension pour inactivité (CDC §14)
  codeAgence                 String   @default("TG-228")
  codeGuichet                String   @default("Afrs001")
  // Plan comptable (numéros de compte utilisés pour les écritures automatiques)
  compteCaisseNumero         String   @default("571") // Caisse
  compteCourantClientNumero  String   @default("419") // Clients créditeurs (compte courant)
  compteVentesNumero         String   @default("701") // Ventes (contrepartie paiement)
  updatedAt                  DateTime @updatedAt
}

// Compte courant : un par client
model CompteCourant {
  id           Int    @id @default(autoincrement())
  numeroCompte String @unique // 12 chiffres, commence par 12
  cleRib       String // 2 chiffres (contrôle mod 97)
  codeAgence   String
  codeGuichet  String
  ribComplet   String // ex: "TG-228 Afrs001 12XXXXXXXXXX 87"

  // Titulaire principal (représentant). N'est plus @unique : un client peut être
  // titulaire de son compte individuel ET représentant d'un compte collectif (CDC §19.A).
  // L'unicité « un seul compte INDIVIDUEL par client » est garantie au niveau applicatif.
  clientId Int
  client   Client @relation(fields: [clientId], references: [id])

  typeCompte                TypeCompteCC              @default(INDIVIDUEL) // individuel ou collectif (CDC §19.A)
  libelle                   String? // nom du ménage / communauté / groupement (comptes collectifs)
  membres                   MembreCompteCourant[] // membres du compte (au moins le titulaire)
  plansEpargne              PlanEpargne[] // plans d'épargne programmée (CDC §19.B)
  autorisationsPrelevement  AutorisationPrelevement[] // prélèvements automatiques (CDC §19.C)
  blocagesEpargne           BlocageEpargne[] // blocages volontaires d'épargne (CDC §19.E)
  remboursementsCCEnAttente RemboursementCredit[] // paiements crédit via CC en attente de validation caissier

  dateOuverture   DateTime @default(now())
  agentCreateurId Int
  agentCreateur   User     @relation("CCCreateur", fields: [agentCreateurId], references: [id])

  statut       StatutCompteCourant @default(ACTIF)
  motifBlocage String?

  solde               Decimal   @default(0)
  totalDepose         Decimal   @default(0)
  totalRetire         Decimal   @default(0)
  totalUtilise        Decimal   @default(0)
  nbMouvements        Int       @default(0)
  derniereOperationAt DateTime?

  mouvements MouvementCompteCourant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut])
  @@index([clientId])
  @@index([typeCompte])
}

// Membre d'un compte courant (CDC §19.A — comptes collectifs : ménage, communauté, groupement).
// Un compte individuel a un unique membre (le titulaire) ; un compte collectif en a plusieurs.
model MembreCompteCourant {
  id          Int           @id @default(autoincrement())
  compteId    Int
  compte      CompteCourant @relation(fields: [compteId], references: [id], onDelete: Cascade)
  clientId    Int
  client      Client        @relation("MembreCC", fields: [clientId], references: [id])
  role        RoleMembreCC  @default(MEMBRE)
  quotePart   Decimal? // quote-part indicative (%) du membre dans le compte collectif
  ajouteParId Int?
  ajoutePar   User?         @relation("MembreCCAjoutePar", fields: [ajouteParId], references: [id])
  createdAt   DateTime      @default(now())

  @@unique([compteId, clientId]) // un client n'apparaît qu'une fois par compte
  @@index([compteId])
  @@index([clientId])
}

// Plan d'épargne programmée (CDC §19.B) : objectif chiffré + cotisation périodique.
// Les cotisations sont des dépôts (MouvementCompteCourant.nature = DEPOT) fléchés
// vers le plan via planEpargneId ; montantCumule est le cumul mis en cache.
model PlanEpargne {
  id                Int               @id @default(autoincrement())
  compteId          Int
  compte            CompteCourant     @relation(fields: [compteId], references: [id], onDelete: Cascade)
  libelle           String // ex. « Achat moto », « Rentrée scolaire »
  objectifMontant   Decimal
  frequence         FrequenceEpargne
  montantCotisation Decimal // montant conseillé par période
  dateDebut         DateTime          @default(now())
  dateEcheance      DateTime
  montantCumule     Decimal           @default(0) // cumul des cotisations fléchées (cache)
  statut            StatutPlanEpargne @default(EN_COURS)
  dateAtteint       DateTime? // date d'atteinte de l'objectif
  observation       String?

  creeParId Int
  creePar   User @relation("PlanEpargneCreePar", fields: [creeParId], references: [id])

  cotisations MouvementCompteCourant[] @relation("CotisationsPlan")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([compteId])
  @@index([statut])
}

// Autorisation de prélèvement automatique (CDC §19.C) : le client autorise le
// système à débiter son compte courant pour régler les échéances d'un crédit.
model AutorisationPrelevement {
  id                   Int           @id @default(autoincrement())
  compteId             Int
  compte               CompteCourant @relation(fields: [compteId], references: [id], onDelete: Cascade)
  creditId             Int           @unique // une seule autorisation par crédit
  credit               CreditClient  @relation(fields: [creditId], references: [id], onDelete: Cascade)
  actif                Boolean       @default(true)
  montantMax           Decimal? // plafond prélevé par exécution (null = montant de l'échéance due)
  montantMinSolde      Decimal? // solde plancher à préserver (null = soldeMinObligatoire du paramétrage)
  dernierPrelevementAt DateTime?
  totalPreleve         Decimal       @default(0)
  nbPrelevements       Int           @default(0)

  creeParId Int
  creePar   User @relation("PrelevementAutoCreePar", fields: [creeParId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([compteId])
  @@index([actif])
}

// Paramétrage du programme de fidélité (CDC §19.D) — enregistrement unique id=1.
model ProgrammeFidelite {
  id                    Int      @id @default(1)
  actif                 Boolean  @default(true)
  pointsParMontant      Int      @default(1000) // 1 point par tranche de X FCFA déposé
  bonusParDepot         Int      @default(0) // points bonus fixes par dépôt (récompense la régularité)
  seuilArgent           Int      @default(500) // points cumulés pour atteindre chaque niveau
  seuilOr               Int      @default(2000)
  seuilPlatine          Int      @default(5000)
  reductionFraisArgent  Int      @default(0) // % de réduction des frais de dossier par niveau
  reductionFraisOr      Int      @default(5)
  reductionFraisPlatine Int      @default(10)
  updatedAt             DateTime @updatedAt
}

// Compte de fidélité d'un client (CDC §19.D) — solde de points + niveau.
model CompteFidelite {
  id                  Int                   @id @default(autoincrement())
  clientId            Int                   @unique
  client              Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  soldePoints         Int                   @default(0) // points disponibles (gagnés − dépensés)
  totalGagnes         Int                   @default(0) // cumul gagné (détermine le niveau, jamais décrémenté)
  totalUtilises       Int                   @default(0)
  niveau              NiveauFidelite        @default(BRONZE)
  transactions        TransactionFidelite[]
  echangesRecompenses RecompenseEchange[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([niveau])
}

// Grand livre des points de fidélité (CDC §19.D).
model TransactionFidelite {
  id               Int                     @id @default(autoincrement())
  compteFideliteId Int
  compteFidelite   CompteFidelite          @relation(fields: [compteFideliteId], references: [id], onDelete: Cascade)
  type             TypeTransactionFidelite
  points           Int // signé : + gain/bonus, − dépense
  motif            String
  source           String? // DEPOT, COTISATION, MANUEL, CADEAU…
  mouvementId      Int? // lien vers le dépôt source éventuel
  creeParId        Int?
  creePar          User?                   @relation("TransactionFideliteCreePar", fields: [creeParId], references: [id])
  createdAt        DateTime                @default(now())

  @@index([compteFideliteId])
  @@index([createdAt])
}

// Blocage volontaire d'épargne (CDC §19.E) : le client rend une partie de son
// solde indisponible jusqu'à une date (préparation d'un achat important). Le
// montant bloqué actif est déduit du solde disponible pour toute sortie.
model BlocageEpargne {
  id            Int                  @id @default(autoincrement())
  compteId      Int
  compte        CompteCourant        @relation(fields: [compteId], references: [id], onDelete: Cascade)
  montant       Decimal
  motif         String?
  dateBlocage   DateTime             @default(now())
  dateDeblocage DateTime // date d'échéance du blocage
  statut        StatutBlocageEpargne @default(ACTIF)
  libereLe      DateTime? // date effective de libération (auto ou anticipée)

  creeParId Int
  creePar   User @relation("BlocageEpargneCreePar", fields: [creeParId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([compteId])
  @@index([statut])
  @@index([dateDeblocage])
}

// Grand livre des mouvements d'un compte courant
model MouvementCompteCourant {
  id           Int               @id @default(autoincrement())
  reference    String            @unique
  compteId     Int
  compte       CompteCourant     @relation(fields: [compteId], references: [id])
  nature       NatureMouvementCC
  montant      Decimal // signé : + entrée, − sortie
  soldeAvant   Decimal
  soldeApres   Decimal
  modePaiement String?
  observation  String?
  statut       StatutMouvementCC @default(VALIDE)

  userId Int?
  user   User?   @relation("CCMouvementUser", fields: [userId], references: [id])
  agence String?

  // Métadonnées de collecte optionnelles (parité avec les remboursements de crédit) :
  // n° de jour de collecte, date effective du dépôt, et agent l'ayant physiquement apporté.
  numeroJour       Int?
  dateOperation    DateTime?
  agentApporteurId Int?
  agentApporteur   User?     @relation("CCMouvementAgentApporteur", fields: [agentApporteurId], references: [id])

  ecritureId Int? // lien Comptabilité (lots suivants)
  venteId    Int? // lien paiement comptant (lot suivant)
  creditId   Int? // lien paiement crédit (lot suivant)

  planEpargneId Int? // cotisation fléchée vers un plan d'épargne (CDC §19.B)
  planEpargne   PlanEpargne? @relation("CotisationsPlan", fields: [planEpargneId], references: [id])

  ip        String? // adresse IP de l'auteur (CDC §16)
  userAgent String? // machine / navigateur de l'auteur (CDC §16)

  createdAt DateTime @default(now())

  @@index([compteId])
  @@index([nature])
  @@index([createdAt])
  @@index([agentApporteurId])
}

// ============================================================
// MODULE POPC — Planification des Objectifs & Pilotage des Collectes
// ============================================================
// Aucune ressaisie : les réalisations (16èmes/31èmes, encaissements) sont lues
// des modules Crédit (CreditClient/EcheanceCredit/RemboursementCredit) et des
// ventes de carnets. Ce module ne stocke QUE le paramétrage et les objectifs
// générés (historisés par mois pour comparaison — CDC §15.5).
// FK stockées en Int sans relation Prisma (même parti-pris que
// CreditClient.pointDeVenteId) pour rester isolé des modèles User/PDV/Client.

enum StatutParametragePOPC {
  BROUILLON // saisi, objectifs recalculés à la volée, non figé
  VALIDE // objectifs figés pour le mois (référence de pilotage)
}

// Paramétrage mensuel (CDC §3) : charges + paramètres commerciaux.
// Unicité (annee, mois, pointDeVenteId) : un paramétrage global (pointDeVenteId null)
// et/ou un paramétrage par agence.
model ParametragePOPC {
  id             Int                   @id @default(autoincrement())
  annee          Int
  mois           Int // 1..12
  pointDeVenteId Int                   @default(0) // 0 = global (toutes agences), sinon PDV
  statut         StatutParametragePOPC @default(BROUILLON)

  // ── 3.1 Charges mensuelles (FCFA) ──────────────────────────────────────────
  salaireAgents       Decimal @default(0)
  salaireSuperviseurs Decimal @default(0)
  salaireControleurs  Decimal @default(0)
  salaireResponsables Decimal @default(0)
  carburant           Decimal @default(0)
  entretienMotos      Decimal @default(0)
  telephone           Decimal @default(0)
  internet            Decimal @default(0)
  loyer               Decimal @default(0)
  eau                 Decimal @default(0)
  electricite         Decimal @default(0)
  fournitures         Decimal @default(0)
  publicite           Decimal @default(0)
  divers              Decimal @default(0)

  // ── 3.2 Paramètres commerciaux ─────────────────────────────────────────────
  objectifBenefice    Decimal @default(0) // objectif de bénéfice du mois
  commissionSeizieme  Decimal @default(0) // commission minimum du 16ème
  commissionTrentaine Decimal @default(0) // commission minimum du 31ème
  prixCarnet          Decimal @default(300)
  joursOuvrables      Int     @default(26)
  nombreAgentsTerrain Int     @default(1)
  nombreAgences       Int     @default(1)

  // ── Hypothèses de planification (mix de revenu) ────────────────────────────
  // Répartition du revenu-cible entre les 3 sources (somme ≈ 100). Éditable :
  // le CDC ne fixe pas le mix, la Direction le calibre.
  partRevenu16     Decimal @default(50) // % du revenu attendu via les 16èmes
  partRevenu31     Decimal @default(40) // % du revenu attendu via les 31èmes
  partRevenuCarnet Decimal @default(10) // % du revenu attendu via les carnets
  creditsParClient Decimal @default(1) // nb moyen de crédits par client (recrutement)

  // ── Traçabilité (CDC §15.6) ────────────────────────────────────────────────
  creeParId      Int
  valideParId    Int?
  dateValidation DateTime?

  objectif ObjectifPOPC?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([annee, mois, pointDeVenteId])
  @@index([annee, mois])
  @@index([pointDeVenteId])
}

// Tableau de synthèse généré (CDC §4). Snapshot des objectifs calculés à partir
// du paramétrage — conservé pour l'historique et les comparaisons.
model ObjectifPOPC {
  id            Int @id @default(autoincrement())
  parametrageId Int @unique

  chargesTotales       Decimal @default(0)
  objectifBenefice     Decimal @default(0)
  revenuMinimum        Decimal @default(0)
  nbSeiziemes          Int     @default(0)
  nbTrentiemes         Int     @default(0)
  nbCarnets            Int     @default(0)
  nbNouveauxCredits    Int     @default(0)
  nbClientsRecruter    Int     @default(0)
  objectifQuotidien    Decimal @default(0)
  objectifHebdomadaire Decimal @default(0)
  objectifMensuel      Decimal @default(0)

  parametrage ParametragePOPC @relation(fields: [parametrageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Vente d'un carnet de crédit (300 FCFA — CDC §1). Source des « carnets vendus »
// des tableaux §8/§9/§11. Traçabilité agent + agence sans ressaisie.
model VenteCarnet {
  id              Int      @id @default(autoincrement())
  reference       String   @unique // ex: CAR-20260721-0001
  montant         Decimal  @default(300)
  agentId         Int? // AGENT_TERRAIN ayant vendu (commercial)
  pointDeVenteId  Int? // agence concernée
  clientId        Int? // client acheteur (optionnel)
  dateVente       DateTime @default(now())
  enregistreParId Int
  notes           String?

  createdAt DateTime @default(now())

  @@index([agentId])
  @@index([pointDeVenteId])
  @@index([dateVente])
}

// ═══════════════════════════════════════════════════════════════════════════
// MODULE MARKETING — Phase 1 : Marketing Core (campagnes, audiences, budgets)
// Principe directeur du CDC (§85-86, 89) : ce module ne duplique aucune donnée
// opérationnelle (Client/Vente/Stock/Crédit/Comptabilité/Agence) — il les
// consomme en lecture (FK simples) pour piloter campagnes/audiences/budgets.
// ═══════════════════════════════════════════════════════════════════════════

enum StatutCampagne {
  BROUILLON
  PLANIFIEE
  APPROUVEE
  ACTIVE
  PAUSE
  TERMINEE
  ARCHIVEE
}

enum PorteeCampagne {
  NATIONALE
  REGIONALE
  AGENCE
  POINT_DE_VENTE
  COMMERCIALE
}

/// Objectif de campagne — table paramétrable (CDC §81, "sans code"), pas un
/// enum : remplace l'ancien ObjectifCampagneType (jamais branché nulle part
/// dans le code applicatif — modèle orphelin, migration sans risque de perte
/// de données). Mêmes 8 valeurs seedées en migration, éditables ensuite par
/// l'admin comme TypeCampagne/CanalMarketing.
model ObjectifCampagne {
  id      Int     @id @default(autoincrement())
  code    String  @unique
  libelle String
  actif   Boolean @default(true)
  ordre   Int     @default(0)

  campagnes CampagneObjectif[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TypeAudience {
  STATIQUE
  DYNAMIQUE
}

// Champs exploitables par le moteur de règles d'audience (CDC §11). Les
// champs *_ACHAT*/DERNIER_ACHAT_JOURS sont calculés par agrégation sur
// VenteDirecte au moment de l'évaluation (pas de colonne dédiée sur Client).
enum ChampAudience {
  SEGMENT
  TYPE_CLIENT
  VILLE
  COMMUNE
  QUARTIER
  SEXE
  POINT_DE_VENTE
  MONTANT_ACHAT_TOTAL
  FREQUENCE_ACHAT
  DERNIER_ACHAT_JOURS
  PRODUIT_ACHETE
  FAMILLE_PRODUIT_ACHETEE
  STATUT_CREDIT
  NIVEAU_FIDELITE
  TAG
  /// CDC §51 — géolocalisation : `valeur` au format "pointDeVenteId:rayonKm".
  /// L'opérateur n'est pas utilisé pour ce champ (toujours "dans le rayon").
  DISTANCE_AGENCE_KM
  /// CDC §39-40 — Marketing B2B : Client.activite (texte libre : revendeur,
  /// grossiste, hôtel, restaurant, entreprise, institution, association…).
  ACTIVITE
  /// CDC §11 — âge calculé depuis Client.dateNaissance ; `valeur` = âge en
  /// années, l'opérateur s'applique à l'âge (SUPERIEUR = plus vieux que...).
  AGE
  /// CDC §11 — canal déjà utilisé pour toucher le client ; `valeur` =
  /// CanalMarketing.code (ex "SMS"). Agrégé sur EnvoiMessage.
  CANAL
  /// CDC §51 — ciblage géo par région (Client.region, texte libre).
  REGION
}

enum OperateurAudience {
  EGAL
  DIFFERENT
  SUPERIEUR
  INFERIEUR
  SUPERIEUR_EGAL
  INFERIEUR_EGAL
  CONTIENT
  DEPUIS_JOURS
}

enum StatutBudgetMarketing {
  BROUILLON
  DEMANDE
  /// CDC §54 — 1ère validation (Responsable Marketing) passée, en attente de la Direction.
  EN_VALIDATION_DIRECTION
  APPROUVE
  REJETE
}

enum CategorieDepenseMarketing {
  PUBLICITE
  IMPRESSION
  INFLUENCE
  EVENEMENT
  TRANSPORT
  TERRAIN
  SMS
  WHATSAPP
  EMAIL
  MEDIA
  SPONSORING
  CREATION_GRAPHIQUE
  AUTRE
}

// ── Référentiels paramétrables sans code (CDC §7, §21, §81) ─────────────────

model TypeCampagne {
  id      Int     @id @default(autoincrement())
  code    String  @unique
  libelle String
  actif   Boolean @default(true)
  ordre   Int     @default(0)

  campagnes Campagne[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CanalMarketing {
  id      Int     @id @default(autoincrement())
  code    String  @unique
  libelle String
  actif   Boolean @default(true)
  ordre   Int     @default(0)

  campagnesCanaux CampagneCanal[]
  modelesMessage  ModeleMessage[]
  envoisMessage   EnvoiMessage[]
  publications    PublicationSociale[]
  testsAB         TestAB[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Audiences / segmentation (CDC §10-15) ────────────────────────────────────

model AudienceMarketing {
  id                Int          @id @default(autoincrement())
  nom               String
  description       String?
  type              TypeAudience @default(DYNAMIQUE)
  tailleCalculee    Int?
  dateDernierCalcul DateTime?

  creeParId Int
  creePar   User @relation("AudienceMarketingCreePar", fields: [creeParId], references: [id])

  regles    AudienceMarketingRegle[]
  membres   AudienceMarketingMembre[]
  campagnes Campagne[]
  coupons   Coupon[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
}

model AudienceMarketingRegle {
  id         Int               @id @default(autoincrement())
  audienceId Int
  champ      ChampAudience
  operateur  OperateurAudience
  valeur     String // valeur brute, castée selon `champ` par lib/audienceMarketing.ts

  audience AudienceMarketing @relation(fields: [audienceId], references: [id], onDelete: Cascade)

  @@index([audienceId])
}

model AudienceMarketingMembre {
  audienceId Int
  clientId   Int

  audience AudienceMarketing @relation(fields: [audienceId], references: [id], onDelete: Cascade)
  client   Client            @relation(fields: [clientId], references: [id])

  @@id([audienceId, clientId])
  @@index([clientId])
}

// ── Campagnes (CDC §6-9) ──────────────────────────────────────────────────────

model Campagne {
  id          Int            @id @default(autoincrement())
  code        String         @unique // ex CAMP-2026-0001
  nom         String
  description String?
  statut      StatutCampagne @default(BROUILLON)
  portee      PorteeCampagne @default(AGENCE)

  responsableId Int
  responsable   User @relation("CampagneResponsable", fields: [responsableId], references: [id])

  commercialId Int?
  commercial   User? @relation("CampagneCommercial", fields: [commercialId], references: [id])

  typeCampagneId Int
  typeCampagne   TypeCampagne @relation(fields: [typeCampagneId], references: [id])

  // Brief marketing (CDC §9) : { probleme, cible, message, offre, zone, resultatAttendu }
  brief Json?

  audienceId Int?
  audience   AudienceMarketing? @relation(fields: [audienceId], references: [id])

  dateDebut DateTime
  dateFin   DateTime

  /// CDC §77 — objectif de ROI (%) fixé par le responsable ; sert de référence
  /// pour les alertes "ROI inférieur/supérieur à l'objectif". Null = pas de suivi ROI pour cette campagne.
  roiCible Decimal?

  budget               BudgetMarketing?
  objectifs            CampagneObjectif[]
  agences              CampagneAgence[]
  produits             CampagneProduit[]
  canaux               CampagneCanal[]
  depenses             DepenseMarketing[]
  ventesAttribuees     VenteDirecte[]           @relation("VenteCampagne")
  creditsAttribues     CreditClient[]           @relation("CreditCampagne")
  souscriptionsAttribuees SouscriptionPack[]    @relation("SouscriptionPackCampagne")
  envoisMessage        EnvoiMessage[]
  assetsMarketing      AssetMarketingCampagne[]
  publicationsSociales PublicationSociale[]
  promotions           Promotion[]
  coupons              Coupon[]

  // Marketing (Phase 6 — Terrain & Événementiel)
  operationsTerrain OperationTerrain[]
  evenements        EvenementMarketing[]
  qrCodes           QrCodeMarketing[]
  landingPages      LandingPageMarketing[]
  formulaires       FormulaireMarketing[]
  soumissions       SoumissionFormulaire[]
  liensAffiliation  LienAffiliation[]

  // Marketing (Phase 7 — Analytics & IA)
  testsAB TestAB[]

  creeParId Int
  creePar   User @relation("CampagneCreePar", fields: [creeParId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut])
  @@index([dateDebut, dateFin])
  @@index([responsableId])
  @@index([typeCampagneId])
}

model CampagneObjectif {
  campagneId Int
  objectifId Int

  campagne Campagne         @relation(fields: [campagneId], references: [id], onDelete: Cascade)
  objectif ObjectifCampagne @relation(fields: [objectifId], references: [id])

  @@id([campagneId, objectifId])
}

model CampagneAgence {
  campagneId     Int
  pointDeVenteId Int

  campagne     Campagne     @relation(fields: [campagneId], references: [id], onDelete: Cascade)
  pointDeVente PointDeVente @relation(fields: [pointDeVenteId], references: [id])

  @@id([campagneId, pointDeVenteId])
  @@index([pointDeVenteId])
}

model CampagneProduit {
  id         Int  @id @default(autoincrement())
  campagneId Int
  produitId  Int?
  familleId  Int?
  /// CDC §67 — cible un Pack AfriSime (Pack Famille, Alimentaire Quinzaine/Trentaine,
  /// Revendeur, ou tout nouveau pack créé sans développement).
  packId     Int?

  campagne Campagne        @relation(fields: [campagneId], references: [id], onDelete: Cascade)
  produit  Produit?        @relation(fields: [produitId], references: [id])
  famille  FamilleProduit? @relation(fields: [familleId], references: [id])
  pack     Pack?           @relation(fields: [packId], references: [id])

  @@unique([campagneId, produitId, familleId, packId])
  @@index([produitId])
  @@index([familleId])
  @@index([packId])
}

model CampagneCanal {
  campagneId Int
  canalId    Int

  campagne Campagne       @relation(fields: [campagneId], references: [id], onDelete: Cascade)
  canal    CanalMarketing @relation(fields: [canalId], references: [id])

  @@id([campagneId, canalId])
  @@index([canalId])
}

// ── Budget & dépenses (CDC §52-54) ────────────────────────────────────────────

model BudgetMarketing {
  id              Int                   @id @default(autoincrement())
  campagneId      Int                   @unique
  montantPrevu    Decimal
  montantApprouve Decimal               @default(0)
  montantEngage   Decimal               @default(0)
  statut          StatutBudgetMarketing @default(BROUILLON)

  demandeParId    Int?
  // CDC §54 — 1er palier (Responsable Marketing).
  valideParResponsableId   Int?
  dateValidationResponsable DateTime?
  // 2e palier (Direction) — mêmes champs historiques, dernière validation qui débloque la dépense.
  approuveParId   Int?
  dateApprobation DateTime?

  campagne Campagne           @relation(fields: [campagneId], references: [id])
  depenses DepenseMarketing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DepenseMarketing {
  id                  Int                       @id @default(autoincrement())
  campagneId          Int
  budgetId            Int?
  categorie           CategorieDepenseMarketing
  montant             Decimal
  date                DateTime                  @default(now())
  description         String?
  /// CDC §54 — mode de règlement (ESPECES/VIREMENT/CHEQUE/MOBILE_MONEY),
  /// résout le compte de trésorerie crédité par l'écriture comptable
  /// automatique (défaut ESPECES/Caisse si non renseigné).
  modePaiement        String?
  ecritureComptableId Int? // lien optionnel vers une écriture comptable existante (CDC §53)

  creeParId Int
  creePar   User @relation("DepenseMarketingCreePar", fields: [creeParId], references: [id])

  campagne Campagne         @relation(fields: [campagneId], references: [id])
  budget   BudgetMarketing? @relation(fields: [budgetId], references: [id])

  createdAt DateTime @default(now())

  @@index([campagneId])
  @@index([categorie])
}

// ═══════════════════════════════════════════════════════════════════════════
// MODULE MARKETING — Phase 2 : Communication (CDC §21-26)
// Réutilise les moteurs d'envoi existants (lib/sms.ts, lib/whatsapp.ts,
// lib/email.ts) — cette phase ne les duplique pas, elle construit par-dessus :
// modèles de message, personnalisation, envoi de masse, journal.
// ═══════════════════════════════════════════════════════════════════════════

enum CategorieModeleMessage {
  BIENVENUE
  CONFIRMATION
  PROMOTION
  RELANCE
  FIDELISATION
  ANNIVERSAIRE
  REACTIVATION
  NOUVEAU_PRODUIT
  EVENEMENT
  REMERCIEMENT
  ENQUETE_SATISFACTION
  AUTRE
}

// Blocs du composeur Email (CDC §26) — pas de bloc COUPON tant que le modèle
// Coupon (Phase 5 Fidélisation) n'existe pas.
enum TypeBlocEmail {
  TEXTE
  IMAGE
  BOUTON
  PRODUIT
  PROMOTION
  LIEN
  /// CDC §26 — bloc coupon. Différé en Phase 2 (modèle Coupon inexistant à l'époque) ; Coupon existe depuis la Phase 5.
  COUPON
}

enum StatutEnvoiMessage {
  EN_ATTENTE
  ENVOYE
  ECHEC
  LIVRE
  LU
  REPONSE
}

model ModeleMessage {
  id           Int                    @id @default(autoincrement())
  nom          String
  categorie    CategorieModeleMessage
  canalId      Int
  canal        CanalMarketing         @relation(fields: [canalId], references: [id])
  objet        String? // sujet — email uniquement
  contenuTexte String? // SMS/WhatsApp — texte brut avec {{variables}}
  contenuBlocs Json? // Email — tableau de blocs (TypeBlocEmail)
  actif        Boolean                @default(true)

  creeParId Int
  creePar   User @relation("ModeleMessageCreePar", fields: [creeParId], references: [id])

  envois           EnvoiMessage[]
  testsABVarianteA TestAB[]       @relation("TestABModeleA")
  testsABVarianteB TestAB[]       @relation("TestABModeleB")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([canalId])
  @@index([categorie])
}

model EnvoiMessage {
  id              Int            @id @default(autoincrement())
  campagneId      Int?
  campagne        Campagne?      @relation(fields: [campagneId], references: [id])
  modeleMessageId Int?
  modeleMessage   ModeleMessage? @relation(fields: [modeleMessageId], references: [id])
  canalId         Int
  canal           CanalMarketing @relation(fields: [canalId], references: [id])
  clientId        Int
  client          Client         @relation(fields: [clientId], references: [id])

  destinataire      String // téléphone/email effectivement utilisé (snapshot)
  contenuRendu      String // contenu final après substitution des variables
  statut            StatutEnvoiMessage @default(EN_ATTENTE)
  providerMessageId String? // pour corrélation webhook future (hors scope Phase 2)
  erreur            String?
  coutEstime        Decimal? // CDC §25 coût SMS

  envoyeParId Int
  envoyePar   User @relation("EnvoiMessageEffectuePar", fields: [envoyeParId], references: [id])

  dateEnvoi     DateTime  @default(now())
  dateLivraison DateTime?
  dateLecture   DateTime?
  dateReponse   DateTime?

  @@index([campagneId])
  @@index([clientId])
  @@index([statut])
}

// Réglages no-code du centre de communication (CDC §73 frequency capping) —
// ligne unique id=1 (singleton), éditable via l'UI sans intervention développeur.
model ParametrageMarketing {
  id                          Int     @id @default(1)
  maxCommunicationsParSemaine Int     @default(3)
  /// CDC §25 — coût forfaitaire par SMS envoyé (XOF), pour le calcul de EnvoiMessage.coutEstime. Éditable sans code.
  coutParSms                  Decimal @default(20)
  /// CDC §77 — en-dessous de cette taille, une audience de campagne ACTIVE déclenche l'alerte "audience trop petite".
  seuilAudienceMinimale       Int     @default(50)
}

/// Messagerie interne d'équipe marketing (CDC §21 "Messages internes") — fil
/// chronologique partagé, pas de 1-to-1/DM (hors scope, pas de besoin exprimé
/// au-delà d'un canal d'équipe).
/// CDC §83 — bus d'événements système (registre append-only, pas de pub/sub
/// temps réel). Câblé uniquement sur les points d'entrée déjà possédés par ce
/// module (campagnes/coupons/fidélité) — les événements des autres modules
/// (customer.created, order.completed, payment.completed…) restent hors
/// périmètre d'une revue marketing (ils vivent dans le code des autres
/// modules, les toucher dépasserait le cadre de cette review).
model EvenementSysteme {
  id        Int      @id @default(autoincrement())
  type      String // ex "campaign.started", "coupon.used", "loyalty.points_earned"
  payload   Json
  createdAt DateTime @default(now())

  @@index([type, createdAt])
}

model MessageInterne {
  id        Int      @id @default(autoincrement())
  contenu   String
  auteurId  Int
  auteur    User     @relation(fields: [auteurId], references: [id])
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// MODULE MARKETING — Phase 3 : Content & Social Media (CDC §27-31)
// Publication réelle sur réseaux sociaux hors scope (pas de credentials Meta
// Graph API) — PUBLIE est une confirmation manuelle, pas un appel API.
// ═══════════════════════════════════════════════════════════════════════════

enum CategorieAsset {
  PHOTO
  VIDEO
  AFFICHE
  LOGO
  FLYER
  BROCHURE
  CATALOGUE
  VIDEO_PROMO
  TEMOIGNAGE
  AUTRE
}

enum StatutPublicationSociale {
  IDEE
  BROUILLON
  EN_REVISION
  /// CDC §31 — 1ère validation (Responsable Marketing) passée, en attente de la Direction (contenu à niveau DIRECTION uniquement).
  EN_VALIDATION_DIRECTION
  VALIDE
  PROGRAMME
  PUBLIE
  REJETE
}

/// CDC §31 — "selon le niveau de contenu" : décidé par le Community Manager
/// (ou Responsable Marketing) à la soumission. RESPONSABLE_MARKETING = validé
/// en un seul palier (comportement historique) ; DIRECTION = 2e palier requis.
enum NiveauValidationPublication {
  RESPONSABLE_MARKETING
  DIRECTION
}

model AssetMarketing {
  id                Int            @id @default(autoincrement())
  nom               String
  categorie         CategorieAsset
  url               String
  uploadthingKey    String?
  type              String? // MIME type
  taille            Int?
  tags              String[]       @default([])
  droitsUtilisation String? // CDC §29 — droits d'usage / licence / expiration

  uploadeParId Int
  uploadePar   User @relation("AssetMarketingUploadePar", fields: [uploadeParId], references: [id])

  campagnes    AssetMarketingCampagne[]
  publications PublicationSociale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categorie])
}

model AssetMarketingCampagne {
  assetId    Int
  campagneId Int

  asset    AssetMarketing @relation(fields: [assetId], references: [id], onDelete: Cascade)
  campagne Campagne       @relation(fields: [campagneId], references: [id], onDelete: Cascade)

  @@id([assetId, campagneId])
}

model PublicationSociale {
  id     Int                      @id @default(autoincrement())
  texte  String?
  statut StatutPublicationSociale @default(IDEE)

  canalId Int
  canal   CanalMarketing @relation(fields: [canalId], references: [id])

  campagneId Int?
  campagne   Campagne? @relation(fields: [campagneId], references: [id])

  pointDeVenteId Int? // agence (filtre §28)
  pointDeVente   PointDeVente? @relation(fields: [pointDeVenteId], references: [id])

  produitId Int? // filtre §28
  produit   Produit? @relation(fields: [produitId], references: [id])

  assetId Int?
  asset   AssetMarketing? @relation(fields: [assetId], references: [id])

  responsableId         Int
  responsable           User      @relation("PublicationResponsable", fields: [responsableId], references: [id])
  datePublicationPrevue DateTime?

  // CDC §31 — niveau de validation requis, choisi à la soumission.
  niveauValidationRequis NiveauValidationPublication @default(RESPONSABLE_MARKETING)

  // 1er palier (Responsable Marketing) — renseigné dans les deux cas (palier unique ou premier des deux).
  valideParId    Int?
  validePar      User?     @relation("PublicationValidePar", fields: [valideParId], references: [id])
  dateValidation DateTime?

  // 2e palier (Direction) — renseigné uniquement si niveauValidationRequis = DIRECTION.
  valideParDirectionId Int?
  valideParDirection   User?     @relation("PublicationValideParDirection", fields: [valideParDirectionId], references: [id])
  dateValidationDirection DateTime?

  datePublication DateTime? // renseignée à l'action PUBLIER (confirmation manuelle)

  creeParId Int
  creePar   User @relation("PublicationCreePar", fields: [creeParId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut])
  @@index([datePublicationPrevue])
  @@index([campagneId])
}

// ============================================================
// MARKETING — Phase 4 : Automatisation (CDC §16-20)
// ============================================================

enum DeclencheurAutomatisation {
  NOUVEAU_CLIENT
  PREMIER_ACHAT
  /// CDC §18 — 2e achat du client (mêmes règles de comptage que PREMIER_ACHAT).
  DEUXIEME_ACHAT
  ACHAT_PRODUIT
  PANIER_ELEVE
  CLIENT_INACTIF
  ANNIVERSAIRE
  /// CDC §18 "campagne" — client touché pour la 1ère fois par une campagne donnée (declencheurParams.campagneId).
  CAMPAGNE
  /// CDC §18 "coupon" — client a utilisé un coupon (declencheurParams.couponId optionnel = un coupon précis, sinon tous).
  COUPON_UTILISE
  /// CDC §18 "point fidélité" — solde de points a franchi un seuil (declencheurParams.seuilPoints).
  POINT_FIDELITE
  /// CDC §18 "nouveau produit" — clients déjà acheteurs de la famille d'un produit récemment créé.
  NOUVEAU_PRODUIT
  /// CDC §18 "stock disponible" — le produit visé (declencheurParams.produitId) est de nouveau en stock,
  /// ciblé sur ses acheteurs historiques (pas de suivi d'état rupture→dispo : simplification assumée).
  STOCK_DISPONIBLE
  /// CDC §18 "produit préféré" — le produit le plus acheté du client est en stock et n'a pas été racheté
  /// depuis declencheurParams.seuilJours.
  PRODUIT_PREFERE
  /// CDC §18 "agence proche" — client géolocalisé dans le rayon d'un PDV (declencheurParams.pointDeVenteId/rayonKm), via Haversine.
  AGENCE_PROCHE
  /// CDC §18 "événement" — client inscrit/présent à un événement (declencheurParams.evenementId).
  EVENEMENT
  /// CDC §18 "abandon" — lead capté (SoumissionFormulaire) sans achat depuis (pas de panier e-commerce dans ce système).
  ABANDON
  /// CDC §18 "interaction marketing" — client a lu/répondu à un message marketing (EnvoiMessage.statut LU/REPONSE).
  INTERACTION_MARKETING
  /// CDC §66 — le crédit du client vient d'être intégralement soldé (CreditClient.statut = SOLDE).
  CREDIT_TERMINE
}

enum ActionAutomatisation {
  ENVOYER_SMS
  ENVOYER_EMAIL
  ENVOYER_WHATSAPP
  NOTIFICATION_INTERNE
  ATTRIBUER_COMMERCIAL
  CREER_TACHE
  AJOUTER_TAG
  RETIRER_TAG
  ATTRIBUER_POINTS
  DECLENCHER_CAMPAGNE
  /// CDC §19 "attribuer coupon" — rend le client éligible (audience du coupon) + notification optionnelle.
  ATTRIBUER_COUPON
  /// CDC §19 "envoyer offre" — notifie le client d'une Promotion (distinct d'un coupon nominatif).
  ENVOYER_OFFRE
}

enum StatutExecutionAutomatisation {
  EN_COURS
  TERMINEE
  ARRETEE
}

enum StatutTacheMarketing {
  A_FAIRE
  TERMINEE
}

/// Règle d'automatisation (CDC §16-18) : un déclencheur → une séquence d'étapes
/// (délai + action). Le "constructeur sans code" est une liste d'étapes, pas un
/// canevas graphique — cf. précédent Email Builder à blocs (Phase 2).
model RegleAutomatisation {
  id                Int                       @id @default(autoincrement())
  nom               String
  description       String?
  actif             Boolean                   @default(true)
  declencheur       DeclencheurAutomatisation
  declencheurParams Json? // {seuilJours} CLIENT_INACTIF, {produitId} ACHAT_PRODUIT, {montantMin} PANIER_ELEVE

  etapes     EtapeAutomatisation[]
  executions ExecutionAutomatisation[]

  creeParId Int
  creePar   User @relation("RegleAutomatisationCreePar", fields: [creeParId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([declencheur, actif])
}

/// Étape d'une règle : action à exécuter après `delaiJours` (relatif à l'étape
/// précédente, ou à l'inscription pour la 1ère étape). `arreterSiAchatEntreTemps`
/// = seule condition d'arrêt supportée (CDC §17, "achat entre-temps ? oui → stop").
model EtapeAutomatisation {
  id                       Int                  @id @default(autoincrement())
  regleId                  Int
  regle                    RegleAutomatisation  @relation(fields: [regleId], references: [id], onDelete: Cascade)
  ordre                    Int
  delaiJours               Int                  @default(0)
  action                   ActionAutomatisation
  actionParams             Json // selon action: {modeleMessageId,canalId} | {tagId} | {points,motif} | {campagneId} | {titre,message} | {titre,description,assigneAId}
  arreterSiAchatEntreTemps Boolean              @default(false)

  logs LogAutomatisation[]

  @@unique([regleId, ordre])
}

/// Inscription d'un client dans une règle (créée par la détection du déclencheur).
/// Un client ne s'engage qu'une fois par règle (@@unique) — simplification
/// assumée pour éviter le spam en cas de re-déclenchement (cf. plan).
model ExecutionAutomatisation {
  id                   Int                           @id @default(autoincrement())
  regleId              Int
  regle                RegleAutomatisation           @relation(fields: [regleId], references: [id], onDelete: Cascade)
  clientId             Int
  client               Client                        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  statut               StatutExecutionAutomatisation @default(EN_COURS)
  etapeCouranteOrdre   Int                           @default(1)
  dateProchaineFenetre DateTime
  dateInscription      DateTime                      @default(now())
  dateFin              DateTime?

  logs   LogAutomatisation[]
  taches TacheMarketing[]

  @@unique([regleId, clientId])
  @@index([statut, dateProchaineFenetre])
}

/// Trace d'exécution d'une étape (succès/échec/arrêt) — journal de debug/suivi.
model LogAutomatisation {
  id            Int                     @id @default(autoincrement())
  executionId   Int
  execution     ExecutionAutomatisation @relation(fields: [executionId], references: [id], onDelete: Cascade)
  etapeId       Int
  etape         EtapeAutomatisation     @relation(fields: [etapeId], references: [id], onDelete: Cascade)
  statut        String // SUCCES | ECHEC | ARRETEE
  detail        String?
  dateExecution DateTime                @default(now())
}

/// Tâche créée par l'action CREER_TACHE (CDC §19) — modèle minimal, aucun
/// équivalent générique réutilisable dans le codebase (Mission = RH/terrain).
model TacheMarketing {
  id           Int                  @id @default(autoincrement())
  titre        String
  description  String?
  clientId     Int?
  client       Client?              @relation(fields: [clientId], references: [id])
  assigneAId   Int
  assigneA     User                 @relation("TacheMarketingAssigneA", fields: [assigneAId], references: [id])
  statut       StatutTacheMarketing @default(A_FAIRE)
  dateEcheance DateTime?

  executionId Int?
  execution   ExecutionAutomatisation? @relation(fields: [executionId], references: [id], onDelete: SetNull)

  creeParId Int?
  creePar   User? @relation("TacheMarketingCreePar", fields: [creeParId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assigneAId, statut])
}

// ============================================================
// MARKETING — Phase 6 : Terrain & Événementiel (CDC §41-49)
// ============================================================
// Toujours rattaché à une Campagne existante (réutilise budget/dates/agences/
// attribution CA déjà portés par Campagne, Phase 1) — ces modèles n'ajoutent
// que les détails propres à l'exécution terrain/événementielle/partenariale.

enum TypeOperationTerrain {
  STREET_MARKETING
  FLYERS
  PORTE_A_PORTE
  ANIMATION_MARCHE
  DEGUSTATION
  STAND
  CARAVANE
  AUTRE
}

enum StatutOperationTerrain {
  PLANIFIEE
  EN_COURS
  TERMINEE
  ANNULEE
}

model OperationTerrain {
  id             Int                    @id @default(autoincrement())
  campagneId     Int
  campagne       Campagne               @relation(fields: [campagneId], references: [id])
  type           TypeOperationTerrain
  zone           String
  pointDeVenteId Int?
  pointDeVente   PointDeVente?          @relation(fields: [pointDeVenteId], references: [id])
  dateDebut      DateTime
  dateFin        DateTime
  budget         Decimal                @default(0)
  objectifsText  String?
  statut         StatutOperationTerrain @default(PLANIFIEE)

  // Résultats — saisis par le staff en fin d'opération (simplification assumée :
  // pas de capture de lead unitaire sur le terrain, contrairement aux formulaires).
  prospectsGeneres Int     @default(0)
  clientsConvertis Int     @default(0)
  ventesGenereesCA Decimal @default(0)
  resultatsNotes   String?

  equipe      OperationTerrainAgent[]
  soumissions SoumissionFormulaire[]
  qrCodes     QrCodeMarketing[]

  creeParId Int
  creePar   User     @relation("OperationTerrainCreePar", fields: [creeParId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campagneId])
  @@index([statut])
}

model OperationTerrainAgent {
  operationTerrainId Int
  agentId            Int

  operationTerrain OperationTerrain @relation(fields: [operationTerrainId], references: [id], onDelete: Cascade)
  agent            User             @relation("OperationTerrainEquipe", fields: [agentId], references: [id])

  @@id([operationTerrainId, agentId])
}

enum StatutEvenement {
  PLANIFIE
  EN_COURS
  TERMINE
  ANNULE
}

model EvenementMarketing {
  id          Int             @id @default(autoincrement())
  campagneId  Int?
  campagne    Campagne?       @relation(fields: [campagneId], references: [id])
  nom         String
  lieu        String?
  dateDebut   DateTime
  dateFin     DateTime
  budget      Decimal         @default(0)
  partenaires String?
  statut      StatutEvenement @default(PLANIFIE)

  participants ParticipantEvenement[]
  qrCodes      QrCodeMarketing[]
  soumissions  SoumissionFormulaire[]

  creeParId Int
  creePar   User     @relation("EvenementMarketingCreePar", fields: [creeParId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campagneId])
  @@index([statut])
}

enum StatutParticipantEvenement {
  INVITE
  INSCRIT
  PRESENT
  ABSENT
}

/// Un invité/participant d'événement, converti en Client une fois qualifié
/// (même principe que SoumissionFormulaire.clientIdCree).
model ParticipantEvenement {
  id          Int                        @id @default(autoincrement())
  evenementId Int
  evenement   EvenementMarketing         @relation(fields: [evenementId], references: [id], onDelete: Cascade)
  nom         String
  telephone   String?
  email       String?
  statut      StatutParticipantEvenement @default(INVITE)
  clientId    Int?
  client      Client?                    @relation(fields: [clientId], references: [id])
  createdAt   DateTime                   @default(now())

  @@index([evenementId])
}

/// Code QR généré pour une campagne/opération/événement, pointant vers une
/// landing page (ou une URL de secours) — chaque scan est compté pour tracer
/// la source des prospects (CDC §43).
model QrCodeMarketing {
  id                 Int                   @id @default(autoincrement())
  code               String                @unique
  campagneId         Int?
  campagne           Campagne?             @relation(fields: [campagneId], references: [id])
  operationTerrainId Int?
  operationTerrain   OperationTerrain?     @relation(fields: [operationTerrainId], references: [id])
  evenementId        Int?
  evenement          EvenementMarketing?   @relation(fields: [evenementId], references: [id])
  landingPageId      Int?
  landingPage        LandingPageMarketing? @relation(fields: [landingPageId], references: [id])
  destinationUrl     String? // utilisée si aucune landing page n'est associée
  nbScans            Int                   @default(0)
  actif              Boolean               @default(true)

  soumissions SoumissionFormulaire[]

  creeParId Int
  creePar   User     @relation("QrCodeMarketingCreePar", fields: [creeParId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campagneId])
}

/// Page d'atterrissage simple (titre/offre/CTA/formulaire) — pas un
/// constructeur visuel, un rendu serveur standard suffit (CDC §44).
model LandingPageMarketing {
  id           Int                  @id @default(autoincrement())
  slug         String               @unique
  campagneId   Int?
  campagne     Campagne?            @relation(fields: [campagneId], references: [id])
  titre        String
  description  String?
  produitId    Int?
  produit      Produit?             @relation(fields: [produitId], references: [id])
  offreTexte   String?
  imageUrl     String?
  ctaLabel     String?
  ctaUrl       String?
  formulaireId Int?
  formulaire   FormulaireMarketing? @relation(fields: [formulaireId], references: [id])
  actif        Boolean              @default(true)
  nbVues       Int                  @default(0)

  qrCodes     QrCodeMarketing[]
  soumissions SoumissionFormulaire[]

  creeParId Int
  creePar   User     @relation("LandingPageMarketingCreePar", fields: [creeParId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campagneId])
}

/// Form builder minimal : `champs` liste les champs dynamiques
/// ({cle,label,type,requis}) — pas de table relationnelle par champ, cohérent
/// avec BadgeMarketing.condition (Phase 5) pour ce type de structure ouverte.
model FormulaireMarketing {
  id         Int       @id @default(autoincrement())
  nom        String
  campagneId Int?
  campagne   Campagne? @relation(fields: [campagneId], references: [id])
  champs     Json
  actif      Boolean   @default(true)

  landingPages LandingPageMarketing[]
  soumissions  SoumissionFormulaire[]

  creeParId Int
  creePar   User     @relation("FormulaireMarketingCreePar", fields: [creeParId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Une soumission de formulaire (CDC §45-46) — convertie en Client dès
/// réception (§85 : pas de table "leads" dupliquant le CRM). La source
/// complète (campagne/canal/agence/QR/landing page/événement/opération) est
/// tracée ici, sur le Client c'est juste un client normal.
model SoumissionFormulaire {
  id                 Int                   @id @default(autoincrement())
  formulaireId       Int
  formulaire         FormulaireMarketing   @relation(fields: [formulaireId], references: [id])
  donnees            Json
  campagneId         Int?
  campagne           Campagne?             @relation(fields: [campagneId], references: [id])
  canal              String?
  pointDeVenteId     Int?
  pointDeVente       PointDeVente?         @relation(fields: [pointDeVenteId], references: [id])
  qrCodeId           Int?
  qrCode             QrCodeMarketing?      @relation(fields: [qrCodeId], references: [id])
  landingPageId      Int?
  landingPage        LandingPageMarketing? @relation(fields: [landingPageId], references: [id])
  evenementId        Int?
  evenement          EvenementMarketing?   @relation(fields: [evenementId], references: [id])
  operationTerrainId Int?
  operationTerrain   OperationTerrain?     @relation(fields: [operationTerrainId], references: [id])
  clientIdCree       Int?
  clientCree         Client?               @relation(fields: [clientIdCree], references: [id])
  createdAt          DateTime              @default(now())

  @@index([formulaireId])
  @@index([campagneId])
  @@index([clientIdCree])
}

enum TypePartenaireMarketing {
  INFLUENCEUR
  AFFILIE
}

/// Unifie Influenceurs (§47-48) et Affiliés (§49) — même structure
/// (profil + lien/code unique + clics/leads/ventes/CA/commission/ROI), CDC
/// §49 décrit un tunnel identique à celui des influenceurs.
model PartenaireMarketing {
  id             Int                     @id @default(autoincrement())
  type           TypePartenaireMarketing
  nom            String
  contact        String?
  plateforme     String?
  audienceTaille Int?
  tarif          Decimal?
  commissionPct  Decimal                 @default(0)
  actif          Boolean                 @default(true)

  liens LienAffiliation[]

  creeParId Int
  creePar   User     @relation("PartenaireMarketingCreePar", fields: [creeParId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Lien/code unique d'un partenaire (CDC §49). `couponId` réutilise le moteur
/// Coupon (Phase 5) pour l'attribution des ventes — pas de mécanisme de
/// remise/tracking parallèle. `nbClics` compte les visites du lien avant achat.
model LienAffiliation {
  id             Int                 @id @default(autoincrement())
  partenaireId   Int
  partenaire     PartenaireMarketing @relation(fields: [partenaireId], references: [id])
  campagneId     Int?
  campagne       Campagne?           @relation(fields: [campagneId], references: [id])
  code           String              @unique
  couponId       Int?                @unique
  coupon         Coupon?             @relation(fields: [couponId], references: [id])
  destinationUrl String?
  nbClics        Int                 @default(0)
  actif          Boolean             @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partenaireId])
  @@index([campagneId])
}

// ============================================================
// MARKETING — Phase 7 : Analytics & IA (CDC §7 — A/B Testing)
// ============================================================
// Attribution/CLV/rétention/recommandations n'ajoutent aucun modèle : ce sont
// des agrégations lues sur les données déjà en base (VenteDirecte.campagneId
// Phase 1, RFM lib/audienceMarketing.ts). Seul l'A/B testing est un besoin
// réellement nouveau — deux variantes de message sur une même campagne,
// assignation aléatoire, comparaison des taux de lecture/conversion.

enum StatutTestAB {
  BROUILLON
  EN_COURS
  TERMINE
  /// CDC §72 — la variante gagnante a été envoyée au reste de l'audience.
  DEPLOYE
}

enum VarianteTestAB {
  A
  B
}

model TestAB {
  id            Int            @id @default(autoincrement())
  nom           String
  campagneId    Int
  campagne      Campagne       @relation(fields: [campagneId], references: [id])
  canalId       Int
  canal         CanalMarketing @relation(fields: [canalId], references: [id])
  modeleAId     Int
  modeleA       ModeleMessage  @relation("TestABModeleA", fields: [modeleAId], references: [id])
  modeleBId     Int
  modeleB       ModeleMessage  @relation("TestABModeleB", fields: [modeleBId], references: [id])
  statut        StatutTestAB   @default(BROUILLON)
  dateLancement DateTime?
  /// CDC §72 — taille de l'échantillon PAR variante (ex 1000 = 1000 A + 1000 B).
  /// Null = split 100% de l'audience (comportement historique, pas de "reste" à déployer).
  tailleEchantillon Int?
  dateDeploiement   DateTime?
  varianteDeployee  VarianteTestAB?

  assignations TestABAssignation[]

  creeParId Int
  creePar   User     @relation("TestABCreePar", fields: [creeParId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campagneId])
}

/// Assignation aléatoire d'un client à la variante A ou B d'un test — un seul
/// groupe par client par test (@@unique). `converti` est évalué par le cron
/// (achat détecté depuis le lancement, même principe que Phase 4/5).
model TestABAssignation {
  id             Int            @id @default(autoincrement())
  testId         Int
  test           TestAB         @relation(fields: [testId], references: [id], onDelete: Cascade)
  clientId       Int
  client         Client         @relation(fields: [clientId], references: [id])
  variante       VarianteTestAB
  converti       Boolean        @default(false)
  dateConversion DateTime?
  createdAt      DateTime       @default(now())

  @@unique([testId, clientId])
  @@index([testId])
}

// ============================================================
// MARKETING — Fermeture des manques CDC (§50-51, §81)
// ============================================================

enum TypeZoneChalandise {
  VILLE
  COMMUNE
  QUARTIER
  MARCHE
  ENTREPRISE
  ECOLE
  INSTITUTION
}

/// Zone de chalandise d'une agence (CDC §50) — simple répertoire de cibles
/// locales (villes/communes/quartiers/marchés/entreprises/écoles/
/// institutions), consulté pour construire des campagnes/opérations terrain
/// ciblées sur le secteur de l'agence. Pas une intégration profonde avec le
/// moteur d'audience (VILLE/COMMUNE/QUARTIER y existent déjà comme champs) —
/// pour MARCHE/ENTREPRISE/ECOLE/INSTITUTION, simple registre de référence.
model ZoneChalandise {
  id             Int                @id @default(autoincrement())
  pointDeVenteId Int
  pointDeVente   PointDeVente       @relation(fields: [pointDeVenteId], references: [id], onDelete: Cascade)
  type           TypeZoneChalandise
  nom            String
  notes          String?
  createdAt      DateTime           @default(now())

  @@index([pointDeVenteId])
}

/// Seuils de la segmentation RFM (CDC §81, "sans code") — singleton éditable,
/// remplace les seuils en dur de lib/audienceMarketing.ts::calculerSegmentsRFM.
/// Valeurs par défaut = seuils historiques (zéro régression tant que personne
/// n'édite le paramétrage).
model ParametrageRFM {
  id                        Int      @id @default(1)
  seuilPerduJours           Int      @default(180)
  seuilDormantJours         Int      @default(90)
  seuilRisqueJours          Int      @default(60)
  seuilRisqueFrequenceMin   Int      @default(2)
  percentileGrosAcheteur    Float    @default(0.10) // top 10% par montant total
  seuilChampionFrequence    Int      @default(5)
  seuilChampionRecenceJours Int      @default(30)
  seuilFideleFrequence      Int      @default(3)
  updatedAt                 DateTime @updatedAt
}
