/// Classification actif circulant/immobilisé (CDC Comptabilité §5) — uniquement
/// pertinent pour les comptes de type ACTIF ; null pour les autres types.
enum NatureActif {
  CIRCULANT
  IMMOBILISE
}

/// Statut du cycle de vie d'un compte (CDC Comptabilité §5) — une fois qu'un
/// compte a reçu une écriture, sa suppression physique est interdite : il ne
/// peut plus qu'être désactivé, archivé ou marqué obsolète, en conservant tout
/// son historique. Le booléen `actif` existant reste la source de vérité pour
/// le moteur d'écriture (`creerEcriture` ne filtre que sur `actif: true`) ; ce
/// champ ajoute la granularité du CDC sans toucher au comportement déjà livré
/// (`statut: ACTIF` ⇔ `actif: true`, tout autre statut ⇔ `actif: false`).
enum StatutCompte {
  ACTIF
  DESACTIVE
  ARCHIVE
  OBSOLETE
}

// Les 6 journaux ci-dessous (CAISSE/BANQUE/VENTES/ACHATS/OD/PAIE) restent les
// journaux "de base" toujours disponibles (utilisés dans tout le code existant) ;
// le champ `journal` des écritures/règles/récurrentes est un simple String
// (CDC §9 : "l'administrateur doit pouvoir créer d'autres journaux") — voir
// modèle JournalComptable ci-dessous pour les journaux personnalisés et
// lib/comptabilite/moteur.ts pour la validation (builtin OU JournalComptable actif).

/// Journal comptable personnalisé (CDC §9), en complément des 6 journaux de base
/// câblés dans le code (CAISSE/BANQUE/VENTES/ACHATS/OD/PAIE, toujours valides).
model JournalComptable {
  id      Int     @id @default(autoincrement())
  code    String  @unique
  libelle String
  prefixe String // 2 caractères pour la numérotation des pièces (CDC §15)
  actif   Boolean @default(true)

  // Multi-société (CDC §50) : null = société principale.
  societeId Int?
  societe   Societe? @relation(fields: [societeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([societeId])
}

