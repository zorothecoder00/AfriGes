enum StatutAvanceSalaire {
  EN_ATTENTE // demande soumise (attente validation manager)
  VALIDE_MANAGER // validée par le manager/RH (attente approbation Direction)
  APPROUVE // approuvée — injectée en paie
  REJETE
  REMBOURSE
  ANNULE // annulée par le demandeur
}

enum StatutPretEmploye {
  EN_ATTENTE // demande soumise (attente validation manager)
  VALIDE_MANAGER // validée par le manager/RH (attente approbation Direction)
  EN_COURS // approuvé & actif — remboursement injecté en paie
  SOLDE
  EN_DEFAUT
  REJETE
  ANNULE // annulée par le demandeur
}

model FichePaie {
  id                 Int             @id @default(autoincrement())
  profilRHId         Int
  mois               Int // 1–12
  annee              Int
  salaireBase        Decimal         @default(0)
  totalBrut          Decimal         @default(0)
  totalRetenues      Decimal         @default(0)
  netAPayer          Decimal         @default(0)
  statut             StatutFichePaie @default(BROUILLON)
  fichierUrl         String?
  notes              String?
  genereParId        Int // User.id
  // Workflow
  controleParId      Int? // User.id
  dateControle       DateTime?
  valideParId        Int? // User.id
  dateValidation     DateTime?
  misEnPaiementParId Int? // User.id
  dateMiseEnPaiement DateTime?
  modePaiement       String? // VIREMENT | MOBILE_MONEY | ESPECES

  profilRH   ProfilRH           @relation(fields: [profilRHId], references: [id])
  composants ComposantSalaire[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profilRHId, mois, annee])
  @@index([profilRHId])
  @@index([statut])
  @@index([annee, mois])
}

model ComposantSalaire {
  id          Int                  @id @default(autoincrement())
  fichePaieId Int
  type        TypeComposantSalaire
  libelle     String
  montant     Decimal
  isRetenue   Boolean              @default(false)
  ordre       Int                  @default(0) // pour l'affichage du bulletin

  fichePaie FichePaie @relation(fields: [fichePaieId], references: [id], onDelete: Cascade)

  @@index([fichePaieId])
}

// ── Grilles salariales ─────────────────────────────────────

model GrilleSalariale {
  id          Int     @id @default(autoincrement())
  categorie   String // "Agent", "Superviseur", "Manager"…
  niveau      String // "N1", "N2", "N3"…
  salaireMin  Decimal
  salaireMax  Decimal
  description String?
  actif       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categorie, niveau])
}

// ── Types de composants personnalisés (moteur configurable) ─

model TypeComposantPaie {
  id        Int     @id @default(autoincrement())
  code      String  @unique // ex: "PRIME_SOIR", "COMM_RECOUVREMENT"
  libelle   String
  categorie String // "PRIME" | "COMMISSION" | "RETENUE" | "INDEMNITE" | "BONUS"
  isRetenue Boolean @default(false)
  actif     Boolean @default(true)

  createdAt DateTime @default(now())
}

// ── Barèmes de commissions ──────────────────────────────────

model BaremeCommission {
  id          Int      @id @default(autoincrement())
  libelle     String
  profilCible String // rôle gestionnaire ciblé : "COMMERCIAL", "AGENT_TERRAIN"…
  type        String // "FIXE" | "POURCENTAGE" | "PALIER"
  valeur      Decimal? // montant (FIXE) ou taux % (POURCENTAGE)
  paliers     Json? // [{min: 1, max: 50, taux: 2}, {min: 51, max: 100, taux: 3}…]
  actif       Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Avances sur salaire ─────────────────────────────────────

model AvanceSalaire {
  id                    Int                 @id @default(autoincrement())
  profilRHId            Int
  montant               Decimal
  motif                 String?
  echeancesMois         Int                 @default(1) // nb de mois pour remboursement
  montantRestant        Decimal
  statut                StatutAvanceSalaire @default(EN_ATTENTE)
  commentaire           String? // motif refus ou note
  // ── Workflow de demande (Collaborateur → Manager → Direction) ──
  demandeParId          Int? // User.id du collaborateur demandeur (null si créée par admin/RH)
  valideManagerParId    Int? // User.id du manager/RH validateur niveau 1
  dateValidationManager DateTime?
  approuveParId         Int? // User.id (approbation finale Direction/RH)
  dateApprobation       DateTime?

  profilRH ProfilRH @relation(fields: [profilRHId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profilRHId])
  @@index([statut])
}

// ── Prêts employés ──────────────────────────────────────────

model PretEmploye {
  id                    Int               @id @default(autoincrement())
  profilRHId            Int
  montant               Decimal
  tauxInteret           Decimal           @default(0) // % annuel
  dureesMois            Int // nombre total d'échéances
  montantMensuel        Decimal // calculé : (montant + intérêts) / dureesMois
  montantRestant        Decimal
  statut                StatutPretEmploye @default(EN_COURS)
  notes                 String?
  motif                 String? // objet de la demande (saisi par le collaborateur)
  commentaire           String? // motif de refus / note de validation
  // ── Workflow de demande (Collaborateur → Manager → Direction) ──
  demandeParId          Int? // User.id du collaborateur demandeur (null si créé par admin/RH)
  valideManagerParId    Int? // User.id du manager/RH validateur niveau 1
  dateValidationManager DateTime?
  approuveParId         Int? // User.id (approbation finale Direction/RH)
  dateApprobation       DateTime?

  profilRH ProfilRH @relation(fields: [profilRHId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profilRHId])
  @@index([statut])
}

// ============================================================
// OGRH — MODULE 4 : FORMATION & DÉVELOPPEMENT
// ============================================================

enum StatutFormation {
  PLANIFIEE
  EN_COURS
  TERMINEE
  ANNULEE
}

enum TypeFormation {
  INTERNE
  EXTERNE
  ELEARNING
}

enum StatutParticipationFormation {
  INSCRIT
  PRESENT
  ABSENT
  CERTIFIE
}

/// Plan de formation annuel — agrège plusieurs Formation sous un budget/axes prioritaires.
model PlanFormationAnnuel {
  id               Int              @id @default(autoincrement())
  annee            Int              @unique
  budgetTotal      Decimal?
  axesPrioritaires String?
  notes            String?
  statut           StatutPlanAnnuel @default(BROUILLON)
  createdById      Int // User.id

  formations Formation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Formation {
  id               Int             @id @default(autoincrement())
  titre            String
  type             TypeFormation?
  objectifs        String?
  lieu             String?
  formateur        String?
  dateDebut        DateTime
  dateFin          DateTime?
  dureeHeures      Int?
  cout             Decimal? // coût réel
  budgetAlloue     Decimal? // budget prévisionnel
  certificationNom String? // nom de la certification délivrée
  statut           StatutFormation @default(PLANIFIEE)
  notes            String?
  createdById      Int // User.id
  planFormationId  Int?

  participations ParticipationFormation[]
  demandes       DemandeFormation[]
  planFormation  PlanFormationAnnuel?     @relation(fields: [planFormationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut])
  @@index([type])
  @@index([dateDebut])
  @@index([planFormationId])
}

model ParticipationFormation {
  id            Int                          @id @default(autoincrement())
  formationId   Int
  profilRHId    Int
  statut        StatutParticipationFormation @default(INSCRIT)
  note          Decimal?
  certificatUrl String?
  notes         String?

  formation Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)
  profilRH  ProfilRH  @relation(fields: [profilRHId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([formationId, profilRHId])
  @@index([profilRHId])
  @@index([statut])
}

/// Demande de formation self-service (collaborateur → Manager → RH), calquée sur DemandeConge.
model DemandeFormation {
  id               Int             @id @default(autoincrement())
  profilRHId       Int
  intituleSouhaite String
  formationId      Int? // si liée à une session déjà planifiée
  motif            String?
  statut           StatutDemandeRH @default(EN_ATTENTE)

  commentaireRefus   String?
  dateValidationMgr  DateTime?
  dateValidationRH   DateTime?
  dateDecisionFinale DateTime?

  profilRH  ProfilRH   @relation(fields: [profilRHId], references: [id])
  formation Formation? @relation(fields: [formationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profilRHId])
  @@index([statut])
}

// ============================================================
// OGRH — MODULE 8 : POINTAGE & PRÉSENCE
// ============================================================

enum StatutPointage {
  PRESENT
  ABSENT
  RETARD
  DEMI_JOURNEE
  CONGE
  MISSION
  FERIE
}

enum SourcePointage {
  MANUEL
  IMPORT
  SELF_SERVICE
}

model Pointage {
  id           Int            @id @default(autoincrement())
  profilRHId   Int
  date         DateTime
  heureArrivee DateTime?
  heureDepart  DateTime?
  statut       StatutPointage @default(PRESENT)
  source       SourcePointage @default(MANUEL)
  notes        String?
  saisieParId  Int // User.id

  // ── Calculs (remplis automatiquement à la saisie) ──────────
  tempsTotal    Int? // minutes effectivement travaillées
  retardMinutes Int? // minutes de retard vs heure théorique
  heuresSup     Int? // minutes au-delà de la durée théorique
  justificatif  String? // motif absence / retard

  // ── Validation ─────────────────────────────────────────────
  valideParId Int? // User.id du validateur
  valideA     DateTime? // date de validation

  // ── Annulation (soft delete — aucune suppression définitive, CDC §8) ──
  annule          Boolean   @default(false)
  annuleParId     Int? // User.id de l'auteur de l'annulation
  annuleA         DateTime?
  motifAnnulation String?

  profilRH ProfilRH @relation(fields: [profilRHId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profilRHId, date])
  @@index([profilRHId])
  @@index([date])
  @@index([statut])
  @@index([annule])
}

/// Horaires de référence utilisés pour calculer retards et heures sup
/// Un profil peut avoir sa propre config ; sinon la config par défaut s'applique
model ConfigHoraire {
  id                    Int     @id @default(autoincrement())
  nom                   String? // ex: "Bureau 8h-17h", "Terrain 7h-15h"
  heureArrivee          String? // "08:30" format HH:mm
  heureDepart           String? // "17:30" format HH:mm
  pauseDejeunnerMinutes Int? // durée pause déjeuner en minutes (ex: 60)
  dureeJourneeMinutes   Int? // durée théorique par jour en minutes (ex: 480)
  joursOuvres           Json? // tableau [1,2,3,4,5] (1=lundi … 7=dimanche)
  toleranceRetardMin    Int? // minutes de tolérance avant comptage retard (ex: 5)
  estDefaut             Boolean @default(false) // config appliquée si aucune perso
  actif                 Boolean @default(true) // soft delete (CDC §8 — pas de suppression définitive)
  createdById           Int? // User.id

  collaborateurs ProfilRH[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estDefaut])
  @@index([actif])
}

enum StatutPlanningEquipe {
  BROUILLON
  PUBLIE
}

/// Planning d'équipe hebdomadaire (staffing/roulement) — indépendant de ConfigHoraire,
/// qui reste le gabarit horaire individuel de référence.
model PlanningEquipe {
  id            Int                  @id @default(autoincrement())
  semaineDebut  DateTime // lundi de la semaine planifiée
  statut        StatutPlanningEquipe @default(BROUILLON)
  responsableId Int // User.id créateur
  notes         String?

  affectations AffectationPlanning[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([semaineDebut])
  @@index([statut])
}

/// Ligne d'affectation d'un collaborateur sur un créneau donné du planning d'équipe.
model AffectationPlanning {
  id         Int      @id @default(autoincrement())
  planningId Int
  profilRHId Int
  date       DateTime
  heureDebut String
  heureFin   String
  role       String?
  notes      String?

  planning PlanningEquipe @relation(fields: [planningId], references: [id], onDelete: Cascade)
  profilRH ProfilRH       @relation(fields: [profilRHId], references: [id])

  createdAt DateTime @default(now())

  @@index([planningId])
  @@index([profilRHId])
  @@index([date])
}

// ============================================================
// OGRH — MODULE 9 : COMPÉTENCES
// ============================================================

enum TypeCompetence {
  HARD_SKILL
  SOFT_SKILL
}

enum NiveauCompetence {
  DEBUTANT
  INTERMEDIAIRE
  AVANCE
  EXPERT
}

/// Référentiel des compétences de l'entreprise
model Competence {
  id          Int            @id @default(autoincrement())
  nom         String
  description String?
  type        TypeCompetence
  categorie   String? // ex: "Informatique", "Finance", "Leadership"
  actif       Boolean        @default(true)
  createdById Int? // User.id

  collaborateurCompetences CollaborateurCompetence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([categorie])
  @@index([actif])
}

/// Compétence d'un collaborateur avec son niveau
model CollaborateurCompetence {
  id              Int              @id @default(autoincrement())
  profilRHId      Int
  competenceId    Int
  niveau          NiveauCompetence
  dateAcquisition DateTime?
  notes           String?
  evalueParId     Int? // User.id du RH qui a évalué
  actif           Boolean          @default(true) // soft delete (CDC §8)

  profilRH   ProfilRH   @relation(fields: [profilRHId], references: [id])
  competence Competence @relation(fields: [competenceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profilRHId, competenceId])
  @@index([profilRHId])
  @@index([competenceId])
  @@index([niveau])
}

// ============================================================
// OGRH — MODULE 10 : AVANTAGES & REMBOURSEMENTS
// ============================================================

enum TypeAvantageRH {
  TRANSPORT
  LOGEMENT
  TELEPHONE
  REPAS
  VEHICULE
  ASSURANCE
  AUTRE
}

enum TypeRemboursementFrais {
  DEPLACEMENT
  REPAS
  HEBERGEMENT
  COMMUNICATION
  MATERIEL
  AUTRE
}

enum StatutRemboursementFrais {
  EN_ATTENTE
  APPROUVE
  REJETE
  PAYE
}

model AvantageRH {
  id             Int            @id @default(autoincrement())
  profilRHId     Int
  type           TypeAvantageRH
  libelle        String
  montantMensuel Decimal        @default(0)
  actif          Boolean        @default(true)
  dateDebut      DateTime
  dateFin        DateTime?
  notes          String?

  profilRH ProfilRH @relation(fields: [profilRHId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profilRHId])
  @@index([actif])
}

model RemboursementFrais {
  id           Int                      @id @default(autoincrement())
  profilRHId   Int
  type         TypeRemboursementFrais
  libelle      String
  montant      Decimal
  dateFrais    DateTime
  justificatif String?
  statut       StatutRemboursementFrais @default(EN_ATTENTE)
  traiteParId  Int? // User.id
  commentaire  String?
  notes        String?

  profilRH ProfilRH @relation(fields: [profilRHId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profilRHId])
  @@index([statut])
  @@index([dateFrais])
}

// ============================================================
// OGRH — MODULE 3 : ÉVALUATION DE PERFORMANCE
// ============================================================

enum PeriodeEvaluation {
  ANNUELLE
  SEMESTRIELLE
  TRIMESTRIELLE
  PROBATOIRE
}

enum StatutEvaluationRH {
  BROUILLON
  OBJECTIFS_FIXES
  EN_COURS
  EVALUATION
  VALIDATION
  PLAN_AMELIORATION
  CLOTURE
}

enum TypeEvaluation {
  HIERARCHIQUE
  AUTO_EVALUATION
  EVALUATION_360
}

model EvaluationRH {
  id               Int                @id @default(autoincrement())
  profilRHId       Int
  evaluateurId     Int? // ProfilRH.id du manager/RH évaluateur
  periode          PeriodeEvaluation
  annee            Int
  dateDebut        DateTime
  dateFin          DateTime?
  typeEvaluation   TypeEvaluation?
  statut           StatutEvaluationRH @default(BROUILLON)
  noteGlobale      Decimal? // /5
  appreciation     String?
  pointsForts      String?
  axesAmelioration String?
  objectifsN1      String?
  planAmelioration String?
  notes            String?

  profilRH             ProfilRH              @relation("EvaluationsCollaborateur", fields: [profilRHId], references: [id])
  evaluateur           ProfilRH?             @relation("EvaluationsEffectuees", fields: [evaluateurId], references: [id])
  criteres             CritereEvaluation[]
  objectifs            ObjectifKPI[]
  actionsDeveloppement ActionDeveloppement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profilRHId])
  @@index([annee])
  @@index([statut])
}

model CritereEvaluation {
  id           Int     @id @default(autoincrement())
  evaluationId Int
  libelle      String
  note         Decimal // /5
  commentaire  String?

  evaluation EvaluationRH @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([evaluationId])
}

model ObjectifKPI {
  id             Int      @id @default(autoincrement())
  evaluationId   Int
  libelle        String
  indicateur     String?
  valeurCible    Decimal
  valeurAtteinte Decimal?
  unite          String?
  poids          Int? // pondération en % (0-100)
  commentaire    String?
  actif          Boolean  @default(true) // soft delete (CDC §8)

  evaluation EvaluationRH @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([evaluationId])
}

enum StatutActionDeveloppement {
  A_FAIRE
  EN_COURS
  REALISE
  ANNULE
}

/// Action structurée du plan de développement individuel (PDI), rattachée à une
/// évaluation. Le champ EvaluationRH.planAmelioration (texte libre) reste la
/// synthèse ; ces actions apportent le détail objectif/échéance/statut.
model ActionDeveloppement {
  id           Int                       @id @default(autoincrement())
  evaluationId Int
  profilRHId   Int // dénormalisé, pour requêtes directes par collaborateur
  objectif     String
  actionPrevue String?
  echeance     DateTime?
  statut       StatutActionDeveloppement @default(A_FAIRE)
  notes        String?

  evaluation EvaluationRH @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([evaluationId])
  @@index([profilRHId])
}

// ============================================================
// OGRH — MODULE 5 : RECRUTEMENT
// ============================================================

enum StatutPoste {
  BROUILLON // créé, en attente de validation interne
  OUVERT // validé et publié
  EN_COURS // recrutement actif
  POURVU // poste occupé
  ANNULE
}

enum StatutCandidature {
  RECU
  PRE_QUALIFICATION // premier filtre téléphonique ou écrit
  SHORTLISTE
  ENTRETIEN
  TEST // test technique / pratique
  VALIDATION // validation RH / direction
  OFFRE
  INTEGRATION // processus d'onboarding en cours
  ACCEPTE
  REJETE
}

enum StatutPlanAnnuel {
  BROUILLON
  VALIDE
  CLOTURE
}

/// Plan de recrutement annuel — agrège plusieurs PosteOuvert sous un budget/effectif cible.
model PlanRecrutementAnnuel {
  id            Int              @id @default(autoincrement())
  annee         Int              @unique
  budgetTotal   Decimal?
  effectifCible Int?
  notes         String?
  statut        StatutPlanAnnuel @default(BROUILLON)
  createdById   Int // User.id

  postes PosteOuvert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PosteOuvert {
  id                  Int          @id @default(autoincrement())
  reference           String?      @unique // ex: REC-2026-0001 (auto-généré)
  titre               String
  departement         String?
  service             String?
  lieu                String?
  typeContrat         TypeContrat?
  description         String?
  exigences           String? // profil requis (ex-competencesRequises)
  competencesRequises String? // conservé pour compatibilité
  experienceMin       Int? // années d'expérience minimum
  nbPostes            Int          @default(1)
  salaireMini         Int? // FCFA
  salaireMaxi         Int? // FCFA
  budgetPoste         Int? // budget total alloué au recrutement (FCFA)
  dateOuverture       DateTime     @default(now())
  dateLimite          DateTime?
  statut              StatutPoste  @default(OUVERT)
  validateurId        Int? // User.id du validateur interne
  dateValidation      DateTime? // date de validation interne
  notes               String?
  createdById         Int // User.id
  planRecrutementId   Int?

  candidatures     Candidature[]
  documentsGeneres DocumentRecrutementGenere[]
  planRecrutement  PlanRecrutementAnnuel?      @relation(fields: [planRecrutementId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut])
  @@index([createdById])
  @@index([planRecrutementId])
}

model Candidature {
  id               Int               @id @default(autoincrement())
  posteId          Int
  nomCandidat      String
  prenomCandidat   String
  email            String?
  telephone        String?
  cvUrl            String?
  lettreUrl        String?
  statut           StatutCandidature @default(RECU)
  scoreCandidat    Int? // score global /100 (calculé ou saisi)
  noteEntretien    Decimal? // note /5 après entretien
  noteTest         Decimal? // note /20 après test technique
  dateEntretien    DateTime?
  dateTest         DateTime?
  commentaire      String?
  notes            String?
  competences      String? // tags CSV ex: "React,TypeScript,Node.js"
  formation        String? // ex: "Bac+5 Informatique"
  experienceAnnees Int? // nb années d'expérience déclarées
  sourceCandidat   String? // ex: "LinkedIn", "Recommandation", "Site web"
  dateCandidature  DateTime          @default(now())

  poste            PosteOuvert                 @relation(fields: [posteId], references: [id], onDelete: Cascade)
  onboarding       OnboardingEmploye?
  documentsGeneres DocumentRecrutementGenere[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([posteId])
  @@index([statut])
  @@index([scoreCandidat])
}

enum TypeDocumentRecrutement {
  AVIS_RECRUTEMENT // rattaché au poste
  CONVOCATION_ENTRETIEN // rattaché à la candidature
  LETTRE_OFFRE // rattaché à la candidature
  LETTRE_REFUS // rattaché à la candidature
  PROMESSE_EMBAUCHE // rattaché à la candidature
  PV_SELECTION // rattaché au poste
  FICHE_CREATION_POSTE // rattaché au poste
  DESCRIPTION_POSTE // rattaché au poste
  PROFIL_POSTE // rattaché au poste
  DEMANDE_RECRUTEMENT // rattaché au poste
  GRILLE_PRESELECTION // rattaché au poste
  GUIDE_ENTRETIEN // rattaché au poste
  GRILLE_EVALUATION_CANDIDATS // rattaché à la candidature
  RAPPORT_ENTRETIEN // rattaché à la candidature
}

/// Document de recrutement généré (nature A) — rattaché à un PosteOuvert OU une
/// Candidature (exactement l'un des deux selon le type). Versionné par cible+type,
/// contenu HTML réutilisé pour l'export PDF. Miroir de DocumentRHGenere côté recrutement.
model DocumentRecrutementGenere {
  id        Int                     @id @default(autoincrement())
  type      TypeDocumentRecrutement
  titre     String
  version   Int                     @default(1)
  contenu   String? // HTML généré
  fileUrl   String?
  generePar Int // User.id
  notes     String?
  archive   Boolean                 @default(false)

  posteId       Int?
  candidatureId Int?
  poste         PosteOuvert? @relation(fields: [posteId], references: [id], onDelete: Cascade)
  candidature   Candidature? @relation(fields: [candidatureId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([posteId])
  @@index([candidatureId])
  @@index([type])
}

// ============================================================
// OGRH — MODULE 4 : ONBOARDING
// Déclenché automatiquement à l'acceptation d'une candidature.
// Crée en une transaction : matricule + email pro + ProfilRH + checklist.
// ============================================================

enum StatutOnboarding {
  EN_COURS // onboarding lancé, étapes en progression
  TERMINE // toutes les étapes obligatoires sont FAIT
  SUSPENDU // mis en pause (ex: délai de prise de poste)
  ANNULE // collaborateur n'a finalement pas rejoint
}

enum TypeEtapeOnboarding {
  SIGNATURE_CONTRAT // signature du contrat de travail
  REMISE_MATERIEL // remise ordinateur, badge, téléphone…
  FORMATION // session de formation d'intégration
  AFFECTATION // affectation au PDV / service / manager
  ACCES_SYSTEME // création des accès informatiques
  PRESENTATION // présentation à l'équipe
  AUTRE
}

enum StatutEtapeOnboarding {
  EN_ATTENTE // pas encore traitée
  FAIT // complétée
  IGNORE // volontairement ignorée (non applicable)
}

/// Template de checklist réutilisable — 1 template par profil de poste ou type de contrat
model TemplateOnboarding {
  id          Int     @id @default(autoincrement())
  nom         String // ex: "Intégration Commercial", "Onboarding Tech"
  description String?
  actif       Boolean @default(true)
  createdById Int // User.id du RH qui a créé le template

  etapes      EtapeTemplate[]
  onboardings OnboardingEmploye[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([actif])
}

/// Étape d'un template — ordonnée, copiée vers EtapeOnboarding à la création de l'instance
model EtapeTemplate {
  id          Int                 @id @default(autoincrement())
  templateId  Int
  ordre       Int // position dans la checklist (1, 2, 3…)
  titre       String
  description String?
  type        TypeEtapeOnboarding @default(AUTRE)
  delaiJours  Int                 @default(0) // délai max en jours depuis le début de l'onboarding
  obligatoire Boolean             @default(true) // si false : peut être IGNORE sans bloquer la progression          

  template TemplateOnboarding @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([templateId, ordre])
}

/// Instance d'onboarding créée automatiquement lors de l'acceptation d'une candidature
/// Matricule, email professionnel et ProfilRH sont créés dans la même transaction
model OnboardingEmploye {
  id             Int              @id @default(autoincrement())
  candidatureId  Int              @unique // 1 onboarding par candidature
  profilRHId     Int              @unique // 1 onboarding par collaborateur
  templateId     Int? // template source (null si checklist créée manuellement)
  statut         StatutOnboarding @default(EN_COURS)
  dateDebut      DateTime         @default(now())
  dateFinPrevue  DateTime? // calculée : dateDebut + max(delaiJours des étapes)
  dateCloture    DateTime? // remplie quand statut → TERMINE ou ANNULE
  progressionPct Int              @default(0) // mis à jour à chaque changement d'étape
  notes          String?
  createdById    Int // User.id du RH qui a validé le recrutement

  candidature Candidature         @relation(fields: [candidatureId], references: [id])
  profilRH    ProfilRH            @relation(fields: [profilRHId], references: [id])
  template    TemplateOnboarding? @relation(fields: [templateId], references: [id])
  etapes      EtapeOnboarding[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut])
  @@index([dateDebut])
}

/// Instance d'une étape pour un onboarding spécifique (copiée depuis EtapeTemplate ou créée manuellement)
model EtapeOnboarding {
  id           Int                   @id @default(autoincrement())
  onboardingId Int
  ordre        Int
  titre        String
  description  String?
  type         TypeEtapeOnboarding   @default(AUTRE)
  statut       StatutEtapeOnboarding @default(EN_ATTENTE)
  obligatoire  Boolean               @default(true)

  // Responsable et délai
  responsableId Int? // User.id de la personne chargée de cette étape
  dateLimite    DateTime?
  dateFaite     DateTime?
  commentaire   String?

  onboarding OnboardingEmploye @relation(fields: [onboardingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([onboardingId])
  @@index([onboardingId, ordre])
  @@index([statut])
}

// ============================================================
// OGRH — MODULE 9 : DISCIPLINAIRE
// ============================================================

enum TypeSanction {
  AVERTISSEMENT
  BLAME
  MISE_A_PIED
  LICENCIEMENT_CAUSE
  AUTRE
}

enum StatutProcedure {
  OUVERTE
  EN_INSTRUCTION
  CLOTUREE
  ANNULEE
}

model ProcedureDisciplinaire {
  id              Int             @id @default(autoincrement())
  profilRHId      Int
  type            TypeSanction
  motif           String
  faitsReproches  String?
  dateIncident    DateTime
  dateProcedure   DateTime        @default(now())
  statut          StatutProcedure @default(OUVERTE)
  dateConvocation DateTime?
  reponseCollab   String?
  decision        String?
  dateDecision    DateTime?
  dureeSuspension Int? // jours (si mise à pied)
  notes           String?
  traiteParId     Int // User.id

  profilRH ProfilRH @relation(fields: [profilRHId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profilRHId])
  @@index([statut])
}

// ============================================================
// OGRH — MODULE 14 : SANTÉ ET SÉCURITÉ AU TRAVAIL (SST)
// Registres légaux : jamais de suppression définitive, uniquement
// correction de champs ou changement de statut (ANNULE).
// ============================================================

enum GraviteSST {
  LEGER
  GRAVE
  MORTEL
}

enum StatutAccidentTravail {
  DECLARE
  EN_INSTRUCTION
  CLOTURE
  ANNULE
}

/// Registre des accidents du travail — la déclaration EST l'enregistrement
/// (pas de modèle séparé pour la "déclaration/rapport d'accident" du CDC).
model AccidentTravail {
  id                 Int                   @id @default(autoincrement())
  profilRHId         Int
  dateAccident       DateTime
  heureAccident      String? // "HH:mm"
  lieu               String
  circonstances      String
  natureLesion       String?
  gravite            GraviteSST            @default(LEGER)
  arretTravail       Boolean               @default(false)
  dureeArretJours    Int?
  temoin             String?
  declareParId       Int // User.id
  documentUrl        String? // déclaration CNSS / rapport scanné
  mesuresCorrectives String?
  notes              String?
  statut             StatutAccidentTravail @default(DECLARE)

  profilRH ProfilRH @relation(fields: [profilRHId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profilRHId])
  @@index([statut])
  @@index([dateAccident])
}

enum TypeVisiteMedicale {
  EMBAUCHE
  PERIODIQUE
  REPRISE
  SPONTANEE
}

enum ResultatAptitude {
  APTE
  APTE_AVEC_RESERVES
  INAPTE_TEMPORAIRE
  INAPTE_DEFINITIF
}

/// Visite médicale — l'aptitude médicale EST le résultat de la visite
/// (pas de modèle séparé pour "l'aptitude médicale" du CDC).
model VisiteMedicale {
  id                  Int                @id @default(autoincrement())
  profilRHId          Int
  type                TypeVisiteMedicale
  dateVisite          DateTime
  medecin             String?
  lieu                String?
  resultatAptitude    ResultatAptitude
  restrictions        String?
  dateProchaineVisite DateTime?
  documentUrl         String? // certificat médical scanné
  notes               String?

  profilRH ProfilRH @relation(fields: [profilRHId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profilRHId])
  @@index([dateProchaineVisite])
}

enum TypeEvenementSST {
  INSPECTION
  FORMATION_SECURITE
  PRESQUE_ACCIDENT
  OBSERVATION
  AUTRE
}

/// Journal des événements SST hors accident (inspections, formations sécurité,
/// presque-accidents, observations) — registre simple, non rattaché à un collaborateur précis.
model RegistreSST {
  id            Int              @id @default(autoincrement())
  type          TypeEvenementSST
  dateEvenement DateTime
  description   String
  lieu          String?
  responsableId Int // User.id
  actionsPrises String?
  documentUrl   String?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([dateEvenement])
}

enum TypeIncident {
  SECURITE
  MATERIEL
  ENVIRONNEMENT
  AUTRE
}

enum StatutIncident {
  OUVERT
  EN_COURS
  CLOTURE
  ANNULE
}

/// Rapport d'incident — distinct de l'accident du travail : incidents de
/// sécurité, matériels ou environnementaux, non centrés sur une blessure.
model RapportIncident {
  id                  Int            @id @default(autoincrement())
  dateIncident        DateTime
  lieu                String
  typeIncident        TypeIncident   @default(AUTRE)
  description         String
  personnesImpliquees String?
  gravite             GraviteSST     @default(LEGER)
  actionsCorrectives  String?
  declareParId        Int // User.id
  documentUrl         String?
  notes               String?
  statut              StatutIncident @default(OUVERT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut])
  @@index([dateIncident])
}

// ============================================================
// ENUMS — Module RIA (Réseau des Investisseurs AfriSime)
// ============================================================

enum StatutDepotRIA {
  EN_ATTENTE
  VALIDE
  REJETE
}

enum StatutRetraitRIA {
  EN_ATTENTE
  VALIDE
  PAYE
  REJETE
}

enum StatutFinancementRIA {
  ACTIF
  REMBOURSE
  EN_RETARD
  DEFAUT
  ANNULE
}

enum StatutDistributionRIA {
  PLANIFIE
  EN_ATTENTE_PAIEMENT
  DISTRIBUE
  REINVESTI
}

enum ClasseRisqueRIA {
  A
  B
  C
  D
  E
}

// Étape 3 — Sélection des clients à financer (identification RVC)
enum StatutEligibiliteRIA {
  EN_ATTENTE // évalué, en attente de confirmation RVC
  ELIGIBLE // validé automatiquement par les règles
  REFUSE // refusé automatiquement par les règles
  VALIDE // confirmé par le RVC (affectable par admin/responsableRIA)
  RETIRE // retiré du vivier RIA
}

enum TypeMouvementRIA {
  DEPOT
  RETRAIT
  FINANCEMENT_CLIENT
  REMBOURSEMENT_CLIENT
  BENEFICE_GENERE
  BENEFICE_DISTRIBUE
  BENEFICE_REINVESTI
  FOND_SECURITE
  AJUSTEMENT
}

enum TypeActionRecouvrement {
  APPEL_TELEPHONIQUE
  VISITE_TERRAIN
  MISE_EN_DEMEURE
  ACCORD_ECHEANCIER
  SAISIE_GARANTIE
  NOTE_INTERNE
}

enum StatutActionRecouvrement {
  EN_COURS
  RESOLU
  SANS_SUITE
}

// Phase d'un dossier de défaillance client RIA (escalade > seuils de retard)
enum PhaseRecouvrementRIA {
  NORMAL // pas de retard significatif
  PRECONTENTIEUX // retard installé, recouvrement amiable
  CONTENTIEUX // mise en demeure / dossier juridique
  PERTE // créance irrécouvrable
}

// ============================================================
// MODULE RIA — RÉSEAU DES INVESTISSEURS AFRISIME
// ============================================================

model ProfilInvestisseurRIA {
  id               Int     @id @default(autoincrement())
  gestionnaireId   Int     @unique
  numero           String? @unique // INV-00001 — généré à la création
  profession       String?
  pays             String?
  pieceIdentiteUrl String?
  notes            String?

  gestionnaire     Gestionnaire        @relation(fields: [gestionnaireId], references: [id])
  portefeuilles    PortefeuilleRIA[]
  documentsGeneres DocumentRIAGenere[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PortefeuilleRIA {
  id          Int     @id @default(autoincrement())
  reference   String  @unique // PF-00001
  profilRIAId Int
  nom         String?
  actif       Boolean @default(true)
  notes       String?

  capitalInvesti    Decimal @default(0)
  capitalDisponible Decimal @default(0)
  capitalEngage     Decimal @default(0)
  capitalRecouvre   Decimal @default(0)
  capitalBloque     Decimal @default(0)

  beneficesGeneres    Decimal @default(0)
  beneficesDistribues Decimal @default(0)
  beneficesReinvestis Decimal @default(0)
  fondSecurite        Decimal @default(0)

  profilRIA          ProfilInvestisseurRIA     @relation(fields: [profilRIAId], references: [id])
  affectations       AffectationClientRIA[]
  financements       OperationFinancementRIA[]
  mouvements         MouvementFondsRIA[]       @relation("MouvementsPF")
  depots             DepotInvestisseur[]
  retraits           RetraitInvestisseur[]
  distributions      DistributionBenefice[]
  documents          DocumentInvestisseur[]
  rapports           RapportMensuelRIA[]
  documentsGeneres   DocumentRIAGenere[]
  dossiersICExecutes DossierInterCommission[]  @relation("DossiersICPortefeuilleExecution")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profilRIAId])
  @@index([actif])
}

model AffectationClientRIA {
  id             Int             @id @default(autoincrement())
  portefeuilleId Int
  clientId       Int
  pourcentage    Decimal
  montantAlloue  Decimal         @default(0)
  classeRisque   ClasseRisqueRIA @default(A)
  actif          Boolean         @default(true)
  dateDebut      DateTime        @default(now())
  dateFin        DateTime?
  notes          String?

  portefeuille PortefeuilleRIA           @relation(fields: [portefeuilleId], references: [id])
  client       Client                    @relation(fields: [clientId], references: [id])
  financements OperationFinancementRIA[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([portefeuilleId])
  @@index([clientId])
  @@index([clientId, actif])
}

// Étape 3 — Vivier des clients identifiés par le RVC comme finançables par le RIA.
// Un seul enregistrement courant par client (upsert à chaque réévaluation).
model EligibiliteClientRIA {
  id       Int @id @default(autoincrement())
  clientId Int @unique

  // Montant de crédit sollicité (le « crédit demandé »)
  montantDemande Decimal @default(0)

  // Snapshot des critères au moment de l'évaluation
  ancienneteJours     Int?
  nbAchats            Int?
  volumeAchats        Decimal?
  scoreSolvabilite    Float?
  niveauRisque        NiveauRisque?
  rotationCommerciale Float?

  // Historique crédits & packs (snapshot — nullable, données existantes non impactées)
  nbCredits       Int? // nombre total de crédits accordés (hors annulés/rejetés)
  nbCreditsRetard Int? // crédits actuellement en retard
  volumeCredits   Decimal? // montant total des crédits accordés
  nbPacks         Int? // nombre de souscriptions à des packs

  // Résultat de l'évaluation automatique
  scoreEligibilite Float?               @default(0)
  classeRisque     ClasseRisqueRIA      @default(A)
  statut           StatutEligibiliteRIA @default(EN_ATTENTE)
  motifs           String[] // raisons de refus / alertes
  decisionAuto     Boolean              @default(true)

  // Traçabilité RVC
  identifieParId Int?
  dateDecision   DateTime?
  notes          String?

  client       Client @relation(fields: [clientId], references: [id])
  identifiePar User?  @relation("EligibilitesRIAIdentifiees", fields: [identifieParId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut])
  @@index([identifieParId])
}

model DepotInvestisseur {
  id              Int            @id @default(autoincrement())
  reference       String         @unique
  portefeuilleId  Int
  montant         Decimal
  statut          StatutDepotRIA @default(EN_ATTENTE)
  modePaiement    String?
  justificatifUrl String?
  notes           String?
  valideParId     Int?
  dateValidation  DateTime?

  portefeuille PortefeuilleRIA    @relation(fields: [portefeuilleId], references: [id])
  validePar    User?              @relation("DepotsValides", fields: [valideParId], references: [id])
  mouvement    MouvementFondsRIA? @relation("MouvementDepot")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([portefeuilleId])
  @@index([statut])
}

model RetraitInvestisseur {
  id             Int              @id @default(autoincrement())
  reference      String           @unique
  portefeuilleId Int
  montant        Decimal
  statut         StatutRetraitRIA @default(EN_ATTENTE)
  motif          String?
  modePaiement   String?
  notes          String?
  valideParId    Int?
  dateValidation DateTime?
  datePaiement   DateTime?

  portefeuille PortefeuilleRIA    @relation(fields: [portefeuilleId], references: [id])
  validePar    User?              @relation("RetraitsValides", fields: [valideParId], references: [id])
  mouvement    MouvementFondsRIA? @relation("MouvementRetrait")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([portefeuilleId])
  @@index([statut])
}

model MouvementFondsRIA {
  id          Int              @id @default(autoincrement())
  type        TypeMouvementRIA
  montant     Decimal
  sens        String
  description String?
  reference   String?

  portefeuilleId Int
  depotId        Int? @unique
  retraitId      Int? @unique
  financementId  Int?
  distributionId Int?

  portefeuille PortefeuilleRIA          @relation("MouvementsPF", fields: [portefeuilleId], references: [id])
  depot        DepotInvestisseur?       @relation("MouvementDepot", fields: [depotId], references: [id])
  retrait      RetraitInvestisseur?     @relation("MouvementRetrait", fields: [retraitId], references: [id])
  financement  OperationFinancementRIA? @relation("MouvementsFinancement", fields: [financementId], references: [id])
  distribution DistributionBenefice?    @relation("MouvementsDistribution", fields: [distributionId], references: [id])

  createdAt DateTime @default(now())

  @@index([portefeuilleId])
  @@index([type])
  @@index([createdAt])
  @@index([financementId])
  @@index([distributionId])
}

model OperationFinancementRIA {
  id             Int    @id @default(autoincrement())
  reference      String @unique
  portefeuilleId Int
  affectationId  Int?
  clientId       Int
  creditClientId Int?

  montantFinance   Decimal
  montantRembourse Decimal @default(0)
  encours          Decimal

  statut          StatutFinancementRIA @default(ACTIF)
  dateFinancement DateTime             @default(now())
  dateEcheance    DateTime?
  notes           String?

  // ── Suivi de défaillance / escalade (moteur lib/riaRecouvrement.ts) ──────────
  phaseRecouvrement   PhaseRecouvrementRIA @default(NORMAL)
  niveauEscalade      Int                  @default(0) // 0..5 — dernier palier déjà notifié (idempotence)
  joursRetard         Int                  @default(0) // jours depuis dateEcheance (recalculé à chaque scan)
  dateDernierEscalade DateTime? // dernière fois qu'un palier a été franchi

  portefeuille PortefeuilleRIA       @relation(fields: [portefeuilleId], references: [id])
  affectation  AffectationClientRIA? @relation(fields: [affectationId], references: [id])
  client       Client                @relation("FinancementsRIAClient", fields: [clientId], references: [id])
  creditClient CreditClient?         @relation("FinancementsRIACredit", fields: [creditClientId], references: [id])

  remboursements      RemboursementRIA[]
  mouvements          MouvementFondsRIA[]     @relation("MouvementsFinancement")
  actionsRecouvrement ActionRecouvrementRIA[]
  missionsAudit       MissionAuditRIA[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([portefeuilleId])
  @@index([clientId])
  @@index([statut])
  @@index([creditClientId])
}

model RemboursementRIA {
  id                    Int     @id @default(autoincrement())
  financementId         Int
  montant               Decimal
  remboursementCreditId Int?

  financement OperationFinancementRIA @relation(fields: [financementId], references: [id])

  createdAt DateTime @default(now())

  @@index([financementId])
}

model DistributionBenefice {
  id             Int @id @default(autoincrement())
  portefeuilleId Int
  mois           Int
  annee          Int

  capitalBase         Decimal
  tauxGenere          Decimal
  tauxDistribue       Decimal
  tauxReinvesti       Decimal
  tauxFondSecurite    Decimal
  montantGenere       Decimal
  montantDistribue    Decimal
  montantReinvesti    Decimal
  montantFondSecurite Decimal

  statut       StatutDistributionRIA @default(PLANIFIE)
  datePaiement DateTime?
  traitePar    Int?
  notes        String?

  portefeuille PortefeuilleRIA     @relation(fields: [portefeuilleId], references: [id])
  mouvements   MouvementFondsRIA[] @relation("MouvementsDistribution")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([portefeuilleId, mois, annee])
  @@index([portefeuilleId])
  @@index([mois, annee])
}

model ConfigBeneficeRIA {
  id               Int     @id @default(autoincrement())
  tauxGenere       Decimal @default(10)
  tauxDistribue    Decimal @default(4)
  tauxReinvesti    Decimal @default(4)
  tauxFondSecurite Decimal @default(2)
  actif            Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DocumentInvestisseur {
  id             Int     @id @default(autoincrement())
  portefeuilleId Int
  type           String
  nom            String
  url            String
  description    String?

  portefeuille PortefeuilleRIA @relation(fields: [portefeuilleId], references: [id])

  createdAt DateTime @default(now())

  @@index([portefeuilleId])
}

model RapportMensuelRIA {
  id             Int     @id @default(autoincrement())
  portefeuilleId Int
  mois           Int
  annee          Int
  donnees        Json
  pdfUrl         String?
  genereParId    Int?

  portefeuille PortefeuilleRIA @relation(fields: [portefeuilleId], references: [id])

  createdAt DateTime @default(now())

  @@unique([portefeuilleId, mois, annee])
  @@index([portefeuilleId])
}

model ActionRecouvrementRIA {
  id            Int                      @id @default(autoincrement())
  financementId Int
  type          TypeActionRecouvrement
  statut        StatutActionRecouvrement @default(EN_COURS)
  notes         String?
  resultat      String?
  effectueParId Int?
  dateAction    DateTime                 @default(now())
  dateRelance   DateTime?

  financement OperationFinancementRIA @relation(fields: [financementId], references: [id])
  effectuePar User?                   @relation("ActionsRIAEffectuees", fields: [effectueParId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([financementId])
  @@index([statut])
  @@index([dateAction])
}

// ── Commissions Agents RIA ─────────────────────────────────────────────────────

enum StatutCommissionRIA {
  CALCULE
  APPROUVE
  PAYE
  ANNULE
}

model ConfigCommissionRIA {
  id          Int     @id @default(autoincrement())
  roleType    String  @unique // "AGENT_TERRAIN" | "CHEF_AGENCE" | "RPV_REGIONAL"
  tauxBase    Decimal @default(1.0) // % du montant recouvré
  description String?
  actif       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CommissionAgentRIA {
  id       Int    @id @default(autoincrement())
  userId   Int
  mois     Int
  annee    Int
  roleType String // "AGENT_TERRAIN" | "CHEF_AGENCE" | "RPV_REGIONAL"
  pdvId    Int? // PDV concerné (pour chef agence / RPV)

  montantRecouvre      Decimal @default(0)
  nbDossiers           Int     @default(0)
  nbDossiersRembourses Int     @default(0)
